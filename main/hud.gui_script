--- The in-game interface: map labels, fleet markers, and the order controls.
--
-- Three jobs, kept apart deliberately.
--
-- *Map labels and fleet markers* are pools of nodes recycled every frame. Only
-- what is on screen gets one, so the count stays flat however large the galaxy
-- is, and the label pass rejects overlaps so names never stack.
--
-- *The system sheet* is rebuilt whenever the selection changes, because its
-- content varies enormously - a waypoint you have never visited needs three
-- lines, a developed colony of yours needs garrison, output, three installations
-- and a list of fleets. `ui.collect` records the nodes so the rebuild does not
-- leak.
--
-- *The order bar* is built once and driven by setting text.
--
-- Every control is a real Druid button. The camera also wants these touches, so
-- rather than relying on winning the input-focus race - acquisition order is not
-- guaranteed - the HUD publishes the rectangles it occupies into
-- `store.hud_zones`, and the camera declines any gesture starting inside one.

local store = require("main.store")
local seen = require("main.seen")
local automation = require("main.automation")
local backend = require("main.backend")
local ui = require("main.ui")
local monarch = require("monarch.monarch")
local druid = require("druid.druid")
local config = require("galaxy.config")
local sim_systems = require("galaxy.sim.systems")

local STAR_LABEL_POOL = 70
local REGION_LABEL_POOL = 12
local CAPTAIN_POOL = 40
-- Segments of drawn route. Pools cost their nodes whether or not they are used,
-- and the usual case is one or two legs, so this is sized for a busy turn
-- rather than for the theoretical maximum of every commander on a twelve-lane
-- campaign; beyond it the tail of a route simply is not drawn.
local ROUTE_POOL = 64
-- How far apart two fleet markers must stay on screen before one is nudged.
local MARKER_CLEARANCE = 46
local ROUTE_WIDTH = 3
local ROUTE_NODE = 9

local STAR_LABEL_MIN_ZOOM = 0.30
-- How many names may be on screen at once. Seventy fitted, in the sense that
-- seventy nodes were drawn - the map underneath them did not. These are chosen
-- by relevance now (see rebuild_labels), so a small budget is a filter rather
-- than a truncation: the ones that survive are the ones worth reading.
local STAR_LABELS_AT_MIN_ZOOM = 8
local STAR_LABELS_AT_MAX_ZOOM = 22
-- Which relevance tiers are admitted, by zoom. Pulled back rather than pushed
-- out: at a distance you want to know whose space you are looking at, not what
-- every rock is called.
local LABEL_TIER_ZOOM = { 0.30, 0.55, 0.95 }
local REGION_LABEL_MAX_ZOOM = 1.10

-- map.font is baked at 34px; these are the fractions of it the map draws at.
local STAR_FONT_SCALE = 0.62
local REGION_FONT_SCALE = 1.00

local TOP_H = 96
-- The commander strip under the overview: one face per force in the field. It
-- is the roster *and* the way around the map - with a cap of four there are
-- never enough of them to need a list, and a player thinks in terms of "where
-- is Kess", not "which system was that".
local CAPTAIN_SIZE = 62
local CAPTAIN_GAP = 10
local CAPTAIN_H = CAPTAIN_SIZE + 14
-- A status line and one row of controls. Every point saved here is map.
local BAR_H = 156
-- The staged plan is listed in the bar, and the bar grows *upward* to hold it,
-- so SEND stays exactly where a thumb last found it. Past this many lines the
-- rest collapse into a count: the bar still has to leave a map behind it.
local MANIFEST_LINES = 3
local MANIFEST_LINE_H = 34
-- Where the first manifest line sits below the top of the card. The status line
-- is above it and the control row below, and both stay put as the list grows:
-- see layout_bar for why every line lands in the same place regardless of how
-- many there are.
local MANIFEST_TOP = 60
-- What the status line costs the bar when it has nothing to say.
local STATUS_ROW_H = 30
-- The sheet is as tall as its content, between these.
local SHEET_MIN = 200
local SHEET_MAX = 640

local STAR_COLOUR = ui.rgb(0xC2CCDE)
local SELECTED_COLOUR = ui.rgb(0xFFE79E)

local KIND_LABEL = { colony = "Colony", outpost = "Outpost", waypoint = "Deep space" }

local function player_colour(index)
	local palette = config.player_palette
	local c = palette[((index - 1) % #palette) + 1]
	return vmath.vector4(c[1], c[2], c[3], 1)
end

-- Pools --------------------------------------------------------------------------

local function make_label(pool, size, colour)
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(node, "map")
	gui.set_scale(node, vmath.vector3(size, size, 1))
	gui.set_color(node, colour)
	gui.set_pivot(node, gui.PIVOT_W)
	gui.set_enabled(node, false)
	pool[#pool + 1] = node
	return node
end

local function make_marker(pool)
	local box = ui.sprite(0, 0, 34, 34, "icon_warship", ui.TEXT)
	gui.set_pivot(box, gui.PIVOT_CENTER)
	gui.set_enabled(box, false)
	local text = ui.text(0, 0, "", ui.SMALL, ui.TEXT,
		{ bold = true, pivot = gui.PIVOT_CENTER })
	gui.set_enabled(text, false)
	pool[#pool + 1] = { box = box, text = text }
end

-- Chrome -------------------------------------------------------------------------

local function publish_zones(self)
	local zones = {}
	if self.top_zone then zones[#zones + 1] = self.top_zone end
	if self.bar_zone then zones[#zones + 1] = self.bar_zone end
	if self.captain_zone then zones[#zones + 1] = self.captain_zone end
	if self.sheet_zone then zones[#zones + 1] = self.sheet_zone end
	store.hud_zones = zones
end

--- The always-visible numbers: what the empire has, and when the turn lands.
local function build_overview(self, w, h, pad)
	local y = h - pad.top
	local width = w - pad.left - pad.right
	local card, border = ui.card(pad.left, y, width, TOP_H)
	self.overview = { card = card, border = border }

	-- The way out. The map had no exit at all - once you were in a game the
	-- only way back to the lobby was to restart the app. It sits where EMPIRE
	-- used to, which is the corner a thumb already goes to.
	local menu_size = 60
	self.menu = ui.icon_button(self.druid, w - pad.right - 14 - menu_size,
		y - 18, menu_size, "icon_menu",
		function() monarch.show(hash("menu")) end,
		{ background = ui.CARD_ALT, colour = ui.DIM })
	local x = pad.left + 14
	local column = ((w - pad.right - 28 - menu_size) - x) / 3
	local function slot(i, icon, colour)
		local cx = x + column * (i - 1)
		return {
			icon = ui.icon(cx, y - 26, 30, icon, colour),
			value = ui.text(cx + 38, y - 34, "0", ui.BODY, ui.TEXT, { bold = true }),
			note = ui.text(cx + 38, y - 66, "", ui.SMALL, ui.DIM),
		}
	end
	-- Regions replace the raw research number here. Research is a means and
	-- lives on the empire screen; regions are the objective, and how close the
	-- game is has to be readable without opening anything.
	self.overview.holdings = slot(1, "icon_star", ui.TEXT)
	self.overview.regions = slot(2, "icon_flag", ui.ACCENT)
	self.overview.clock = slot(3, "icon_clock", ui.DIM)

	-- A turn resolving while the map is open must not throw a popup over
	-- somebody mid-read, so the digest is held rather than shown (see
	-- main/galaxy.script) and the turn card becomes the way in. The hit area is
	-- its own transparent node because the slot is three separate nodes and the
	-- whole of it should be the target; picking here is an axis-aligned test
	-- against position and size, so an invisible node is still pickable.
	local clock_x = x + column * 2
	self.report_hit = ui.panel(clock_x - 8, y - 12, column, 74, ui.CLEAR)
	self.report_button = self.druid:new_button(self.report_hit, function()
		local digest = store.pending_report
		if not digest then return end
		store.pending_report = nil
		-- Opening it is what marks it read; until then the poll keeps asking
		-- for the same window so nothing is lost if the player never taps.
		store.seen_turn = digest.turn or store.seen_turn
		seen.set(store.game_id, store.seen_turn)
		monarch.show(hash("report"), nil, digest)
	end)
	self.report_button:set_enabled(false)

	self.top_zone = { pad.left, h - pad.top - TOP_H, w - pad.right, h - pad.top }
end

local function star_name(id)
	local g = store.galaxy
	local star = id and g and g.stars[id]
	return (star and star.name) or ("system " .. tostring(id))
end

local function captain_by_id(id)
	local view = store.game_view
	if not view or not view.captains then return nil end
	for i = 1, #view.captains do
		if view.captains[i].id == id then return view.captains[i] end
	end
	return nil
end

--- One staged order, in the words the player thought it in.
--
-- A count on the button is not enough to act on. The batch *replaces* whatever
-- the server is holding, so the thing that has to be right is the list, and the
-- only way to check a list is to read it.
local function describe_order(o)
	if o.kind == "move" then
		local captain = captain_by_id(o.captain)
		local who = (captain and captain.name) or ("Captain " .. tostring(o.captain))
		local dest = o.route and o.route[#o.route]
		if not dest then return who .. " holds position" end
		return string.format("%s to %s", who, star_name(dest))
	end
	return tostring(o.kind)
end

--- The plan as lines.
local function plan_lines()
	local lines = {}
	for i = 1, #store.orders do
		lines[#lines + 1] = describe_order(store.orders[i])
	end
	return lines
end

--- A row of commander faces under the overview bar.
--
-- Rebuilt only when the roster actually changes - it has its own Druid instance
-- because it is a region that gets rebuilt, and per-component bookkeeping is
-- exactly what leaves stale components pointing at deleted nodes (see the note
-- in main/ui.lua).
local function build_captains(self, w, h, pad)
	ui.region(self.captain_druid, self.captain_nodes)
	self.captain_druid = nil
	self.captain_nodes = {}

	local view = store.game_view
	local fleets = (view and view.captains) or {}
	self.captain_zone = nil
	self.captain_w, self.captain_h = w, h
	if #fleets == 0 then
		self.captain_h = 0
		return
	end

	local previous = ui.collect(self.captain_nodes)
	self.captain_druid = druid.new(self)

	local top = h - pad.top - TOP_H - ui.GAP
	local x = pad.left + 14
	for i = 1, #fleets do
		local f = fleets[i]
		local moving = (f.eta or 0) > 0
		local chosen = store.selected_captain == f.id
		local node = ui.portrait(x, top, CAPTAIN_SIZE, f.portrait, {
			ring_colour = chosen and ui.ACCENT or (moving and ui.GOOD or ui.BORDER),
		})
		-- The strength under the face, because "which of my four is strong
		-- enough" is the question a player is usually asking of this row.
		ui.small(x + CAPTAIN_SIZE * 0.5, top - CAPTAIN_SIZE - 8,
			-- Turns, because that is the question: not how far, but when.
			moving and (f.eta == 1 and "next turn" or (f.eta .. " turns")) or "here",
			chosen and ui.ACCENT or ui.FAINT, { pivot = gui.PIVOT_CENTER })
		self.captain_druid:new_button(node, function()
			-- Selecting a captain *is* the intent to order one - the bar's own
			-- hint says "tap a captain to give them orders" - so this starts
			-- the aim rather than only pointing the camera at them. The sheet
			-- stands down while aiming, which is what hands the map over for
			-- the tap being asked for.
			store.selected_captain = f.id
			store.selected = f.at
			store.aiming = { kind = "move", captain = f.id }
			-- Consume this selection change here. `resolve_aim` fires whenever
			-- the selection moves with an aim active, so setting both in one
			-- callback would resolve the order instantly against the system the
			-- captain is already standing on - a route from a place to itself,
			-- which the server rightly refuses.
			self.last_selected = f.at
			self.sheet_dirty = true
			-- Where the force actually is, part way along its lane if it is
			-- under way, so the camera lands on the marker and not behind it.
			local g = store.galaxy
			local a = g and g.stars[f.at]
			if not a then return end
			msg.post("camera#camera_script", "focus", { x = a.x, y = a.y })
		end)
		x = x + CAPTAIN_SIZE + CAPTAIN_GAP
	end
	ui.collect(previous)

	self.captain_h = CAPTAIN_H
	self.captain_zone = { pad.left, top - CAPTAIN_H, x, top }
	publish_zones(self)
end

--- The order bar: what is about to be sent, cancel an aim, or send it.
local function build_bar(self, w, pad, submit)
	local y = pad.bottom + BAR_H
	local width = w - pad.left - pad.right
	local card, border = ui.card(pad.left, y, width, BAR_H)

	local inner = 24
	self.status = ui.small(pad.left + inner, y - 26, "", ui.DIM,
		{ width = width - inner * 2, anchor_top = true })

	-- Created once at full capacity and then repositioned, rather than rebuilt
	-- whenever the plan changes. The plan changes on every tap, and running the
	-- whole bar through Druid that often is how the deleted-node traps in
	-- ui.lua get sprung.
	self.manifest = {}
	for i = 1, MANIFEST_LINES + 1 do
		local node = ui.small(pad.left + inner + 10, y, "", ui.TEXT,
			{ width = width - inner * 2 - 10 })
		gui.set_enabled(node, false)
		self.manifest[i] = node
	end

	local row_y = y - 52
	local bh = ui.CONTROL
	local right = w - pad.right - inner

	-- CANCEL only exists while something is being aimed, so SEND keeps the far
	-- right where a thumb expects it either way.
	local send_w = 300
	self.cancel = ui.button(self.druid, right - send_w - 182, row_y, 168, bh,
		"CANCEL", function()
			store.aiming = nil
			store.selected_captain = nil
			self.sheet_dirty = true
		end, { size = ui.CAPS })

	self.send = ui.button(self.druid, right - send_w, row_y, send_w, bh, "SEND",
		function() submit(self) end, { style = "primary", size = ui.CAPS })

	self.bar = {
		card = card, border = border, width = width,
		x = pad.left, base_top = y, inner = inner, lines = -1,
	}
	self.bar_zone = { pad.left, y - BAR_H, w - pad.right, y }
	-- Deliberately the *base* height, not the grown one: the camera derives the
	-- zoom floor and the framed centre from this, so letting it move whenever an
	-- order is staged would shift the map under the player - the same trap the
	-- ten-second poll used to spring on the zoom.
	store.hud_bar_height = pad.bottom + BAR_H
end

--- Grow the bar upward to fit `lines` of manifest.
--
-- The control row never moves: it is anchored the same distance above the
-- bottom whatever the card does, which is what lets SEND be somewhere a thumb
-- can find without looking. The list grows upward *into* the new space, so the
-- last line always sits the same distance above the row and only the top of the
-- card and the status line above it actually travel.
--- @param lines manifest rows, or -1 for "no status line either"
local function layout_bar(self, lines)
	local b = self.bar
	if not b or b.lines == lines then return end
	b.lines = lines

	-- With nothing staged and nothing to say, the status line is a blank row
	-- above a dead button. Giving it back to the map is worth more than keeping
	-- the bar a constant height.
	local extra = (lines < 0) and -STATUS_ROW_H or (lines * MANIFEST_LINE_H)
	local top = b.base_top + extra
	local height = BAR_H + extra

	for _, node in ipairs({ b.card, b.border }) do
		gui.set_position(node, vmath.vector3(b.x, top, 0))
		gui.set_size(node, vmath.vector3(b.width, height, 0))
	end
	gui.set_enabled(self.status, lines >= 0)
	gui.set_position(self.status,
		vmath.vector3(b.x + b.inner, top - 26, 0))
	for i = 1, #self.manifest do
		gui.set_position(self.manifest[i], vmath.vector3(b.x + b.inner + 10,
			top - MANIFEST_TOP - (i - 1) * MANIFEST_LINE_H, 0))
	end

	self.bar_zone[4] = top
	publish_zones(self)
	-- The sheet stacks on top of the bar, so it has to move with it. It is
	-- rebuilt rather than nudged because its own height depends on what is
	-- selected, and this only happens when the line count actually changes.
	self.sheet_dirty = true
end

--- How far the manifest has pushed the top of the bar up.
local function bar_extra(self)
	return (self.bar and self.bar.lines or 0) * MANIFEST_LINE_H
end

-- The system sheet -----------------------------------------------------------------

--- What the player knows about a system, or nil if they have never seen it.
local function known(id)
	local view = store.game_view
	if not view then return nil end
	return view.systems[tostring(id)]
end

--- Rebuild the panel describing whatever is selected. Returns its height.
--
-- Laid out downward from zero and shifted into place at the end, because the
-- height is not known until the content is on the page.
--
-- Much shorter than it was: with no production, no buildings and no research, a
-- system is a place with an owner and possibly a captain standing on it. It
-- grows back as those are built.
local function build_sheet(self, w, pad)
	-- Its own Druid instance, dropped wholesale. Tracking each component by
	-- hand is what broke before: helpers register components the caller never
	-- sees, and one that outlives its node throws on the next touch anywhere.
	ui.region(self.sheet_druid, self.sheet_nodes)
	self.sheet_druid = nil
	self.sheet_zone = nil

	local id = store.selected
	local g = store.galaxy
	if not id or not g or not g.stars[id] then return 0 end

	-- Aiming hands the screen to the map. The sheet asked the player to "tap
	-- where to send" while covering nearly half the destinations, which is the
	-- one moment it must not be in the way; the order bar carries the captain
	-- and the origin instead.
	if store.aiming then return 0 end

	self.sheet_druid = druid.new(self)

	local previous = ui.collect(self.sheet_nodes)
	local view = store.game_view
	local info = known(id)
	local star = g.stars[id]
	local kind = sim_systems.kind(g, id)
	local you = view and view.you
	local mine = (view and info and info.owner == you) and true or false

	local width = w - pad.left - pad.right
	local inner = pad.left + 24
	local text_w = width - 48

	-- The card first, so everything else lands on top of it in node order. Its
	-- height is fixed up once the content below is measured.
	local card = ui.panel(pad.left, 0, width, SHEET_MIN, ui.CARD)
	local edge = ui.panel_line(pad.left, 0, width, SHEET_MIN, ui.BORDER)

	local y = -34
	ui.h2(inner, y, star.name)
	local subtitle = KIND_LABEL[kind] or kind
	local region = g.regions[star.region]
	if region then subtitle = subtitle .. "   " .. region.name end
	if star.feature_label ~= "" then subtitle = subtitle .. "   " .. star.feature_label end
	y = y - 34
	ui.small(inner, y, subtitle, ui.DIM, { width = text_w, anchor_top = true })
	y = y - 28
	ui.divider(inner, y, text_w)

	if not info then
		y = y - 44
		ui.body(inner, y, "Unexplored", ui.FAINT)
		y = y - 24
	else
		y = y - 46
		if (info.capital_of or 0) ~= 0 then
			local own = info.capital_of == you
			local who = view and view.players[info.capital_of]
			ui.icon(inner, y + 14, 26, "icon_flag", own and ui.ACCENT or ui.BAD)
			ui.body(inner + 34, y,
				own and "Your capital" or ((who and who.name or "A rival") .. "'s capital"),
				own and ui.ACCENT or ui.BAD)
		elseif mine then
			ui.body(inner, y, "Yours", ui.TEXT)
		elseif (info.owner or 0) == 0 then
			ui.body(inner, y, "Unclaimed", ui.DIM)
		else
			local who = view and view.players[info.owner]
			ui.body(inner, y, "Held by " .. (who and who.name or "someone"), ui.BAD)
		end
		if not info.live then
			y = y - 30
			ui.small(inner, y, "Last seen turn " .. tostring(info.seen), ui.WARN)
		end

		-- Captains standing here, and what can be asked of them.
		local here = {}
		for i = 1, #((view and view.captains) or {}) do
			local c = view.captains[i]
			if c.at == id and (c.eta or 0) == 0 then here[#here + 1] = c end
		end
		if #here > 0 then
			y = y - 42
			ui.caps(inner, y, "captains here")
			for k = 1, #here do
				local captain = here[k]
				local chosen = store.selected_captain == captain.id
				y = y - 58
				local row = ui.panel(inner, y + 48, text_w, 54,
					chosen and ui.ACCENT_SOFT or ui.CARD_ALT)
				ui.portrait(inner + 8, y + 43, 38, captain.portrait,
					{ ring_colour = chosen and ui.ACCENT or ui.BORDER })
				ui.body(inner + 56, y + 27, captain.name, ui.TEXT)
				ui.small(inner + 56, y + 6, captain.rank or "", ui.FAINT)
				ui.small(inner + text_w - 14, y + 21, "tap to move", ui.FAINT,
					{ pivot = gui.PIVOT_E })
				self.sheet_druid:new_button(row, function()
						if chosen then
							store.selected_captain = nil
							store.aiming = nil
						else
							store.selected_captain = captain.id
							store.aiming = { kind = "move", captain = captain.id }
						end
						self.sheet_dirty = true
					end)
			end
		end

		-- Rival captains in sight here.
		if view then
			local seen = 0
			for c = 1, #view.contacts do
				if view.contacts[c].at == id then seen = seen + 1 end
			end
			if seen > 0 then
				y = y - 40
				ui.small(inner, y, ui.plural(seen, "rival captain") .. " in sight", ui.BAD)
			end
		end
		y = y - 24
	end

	local height = math.max(SHEET_MIN, math.min(SHEET_MAX, -y))
	gui.set_size(card, vmath.vector3(width, height, 0))
	gui.set_size(edge, vmath.vector3(width, height, 0))

	-- Docked to the bar rather than floating above it. Two cards with a gap
	-- between them read as clutter and cost the map a strip of screen for a
	-- seam that carried no meaning.
	local top = pad.bottom + BAR_H + bar_extra(self) + height
	for i = 1, #self.sheet_nodes do
		local node = self.sheet_nodes[i]
		local p = gui.get_position(node)
		gui.set_position(node, vmath.vector3(p.x, p.y + top, 0))
	end

	ui.collect(previous)
	self.sheet_zone = { pad.left, top - height, w - pad.right, top }
	return height
end

--- World position to screen, the same relationship the render script builds its
--- projection from. Everything the HUD draws over the map goes through this.
local function project(cam, w, h, wx, wy)
	return (wx - cam.x) * cam.zoom + w * 0.5, (wy - cam.y) * cam.zoom + h * 0.5
end

--- Draw the path a force will actually take.
--
-- The map used to show where a fleet *was* and the sheet said where it was
-- bound, but nothing showed the route between - so a multi-lane order was an
-- act of faith. Two kinds are drawn, and they have to look different:
--
--   * a **committed** route, in the player's own colour, is what the server is
--     already moving the fleet along;
--   * a **staged** route, in the interactive colour, is an order sitting in the
--     bar that has not been sent yet.
--
-- A staged order only carries its destination - the server expands it lane by
-- lane - so the same pathfinder is run here to preview it. It is the identical
-- function on identical data, so what is drawn is what will happen.
local function update_routes(self, g, cam, w, h)
	local view = store.game_view
	local used = 0
	if not view then
		for i = 1, ROUTE_POOL do
			gui.set_enabled(self.route_nodes[i].bar, false)
			gui.set_enabled(self.route_nodes[i].dot, false)
		end
		return
	end

	-- A committed route flows; a staged one does not. The difference is not
	-- decoration: one is a force already under way, the other is a plan sitting
	-- in the bar. Half a leg a second, which reads as motion without pulling the
	-- eye off the map.
	local flow = (self.clock or 0) * 0.5 % 1

	--- One leg, as a rotated bar with a node on it.
	local function segment(ax, ay, bx, by, colour, last, moving)
		if used >= ROUTE_POOL then return end
		local sx0, sy0 = project(cam, w, h, ax, ay)
		local sx1, sy1 = project(cam, w, h, bx, by)
		-- Cull only when the whole leg is off-screen; a line crossing the view
		-- from two off-screen ends still has to be drawn.
		local lo_x, hi_x = math.min(sx0, sx1), math.max(sx0, sx1)
		local lo_y, hi_y = math.min(sy0, sy1), math.max(sy0, sy1)
		if hi_x < -40 or lo_x > w + 40 or hi_y < self.floor_y - 40
			or lo_y > self.ceiling_y + 40 then
			return
		end

		local dx, dy = sx1 - sx0, sy1 - sy0
		local length = math.sqrt(dx * dx + dy * dy)
		if length < 1 then return end

		used = used + 1
		local node = self.route_nodes[used]
		gui.set_enabled(node.bar, true)
		gui.set_position(node.bar, vmath.vector3((sx0 + sx1) * 0.5, (sy0 + sy1) * 0.5, 0))
		gui.set_size(node.bar, vmath.vector3(length, ROUTE_WIDTH, 0))
		gui.set_rotation(node.bar, vmath.vector3(0, 0, math.deg(math.atan2(dy, dx))))
		gui.set_color(node.bar, colour)

		-- The destination is pinned and larger - it is a place, not a moment.
		-- Every other node slides along its own leg while the force is under
		-- way, which is what makes a route read as travel rather than as a line
		-- someone drew.
		gui.set_enabled(node.dot, true)
		local dx2, dy2 = sx1, sy1
		if not last and moving then
			dx2 = sx0 + (sx1 - sx0) * flow
			dy2 = sy0 + (sy1 - sy0) * flow
		end
		gui.set_position(node.dot, vmath.vector3(dx2, dy2, 0))
		local size = last and (ROUTE_NODE * 1.9) or ROUTE_NODE
		gui.set_size(node.dot, vmath.vector3(size, size, 0))
		gui.set_color(node.dot, colour)
	end

	--- Walk a list of system ids from a starting world position.
	local function draw(from_x, from_y, hops, colour, moving)
		local ax, ay = from_x, from_y
		for i = 1, #hops do
			local star = g.stars[hops[i]]
			if not star then return end
			segment(ax, ay, star.x, star.y, colour, i == #hops, moving)
			ax, ay = star.x, star.y
		end
	end

	-- Committed routes, in the player's colour and held back so the staged one
	-- reads as the louder of the two.
	local mine = player_colour(view.you)
	local committed = vmath.vector4(mine.x, mine.y, mine.z, 0.5)
	for i = 1, #view.captains do
		local f = view.captains[i]
		if f.route and #f.route > 0 then
			local a = g.stars[f.at]
			-- A captain always stands at a system, so the line starts on it.
			if a then draw(a.x, a.y, f.route, committed, true) end
		end
	end

	-- Staged orders. `path` is the server's own expansion, fetched when the
	-- order was issued (see request_path); nothing is drawn until it arrives,
	-- because a straight line between two systems is not a route and guessing
	-- one here is how a preview starts lying about what the turn will do.
	local staged = ui.ACCENT
	for i = 1, #store.orders do
		local order = store.orders[i]
		if order.path and #order.path > 0 and order.path_from then
			local a = g.stars[order.path_from]
			if a then draw(a.x, a.y, order.path, staged, false) end
		end
	end

	for i = used + 1, ROUTE_POOL do
		gui.set_enabled(self.route_nodes[i].bar, false)
		gui.set_enabled(self.route_nodes[i].dot, false)
	end
end

--- Draw every fleet the player can see, positioned along its lane.
--
-- GUI nodes rather than world geometry: a marker wants to stay a constant size
-- at every zoom and to carry a crisp glyph, which is what the labels already do.
-- It also avoids rebuilding a vertex buffer whenever a fleet moves.
local function update_captains(self, g, cam, w, h)
	local view = store.game_view
	local used = 0
	if view then

		local function place(at, next_hop, label, colour, mine)
			if used >= CAPTAIN_POOL then return end
			local a = g.stars[at]
			if not a then return end
			-- On the system, pointed at the one it leaves for next. Movement is
			-- whole lanes now, so there is no partway position to draw.
			local angle = nil
			local b = next_hop and g.stars[next_hop]
			if b then angle = math.atan2(b.y - a.y, b.x - a.x) end
			local sx, sy = project(cam, w, h, a.x, a.y)
			if sx < -60 or sx > w + 60 or sy < self.floor_y or sy > self.ceiling_y then
				return
			end

			-- Nudge apart anything that would land on top of something already
			-- placed. At fit zoom - the only zoom reachable without a pinch -
			-- neighbouring systems are a few units apart, and two markers there
			-- become one unreadable knot of triangles and numbers.
			for prior = 1, used do
				local other = self.captain_markers[prior]
				local dx = sx - other.at_x
				local dy = sy - other.at_y
				if dx * dx + dy * dy < MARKER_CLEARANCE * MARKER_CLEARANCE then
					local away = math.sqrt(dx * dx + dy * dy)
					if away < 0.001 then
						-- Exactly co-located: fan around the first one instead
						-- of dividing by nothing.
						local turn = prior * 2.4
						dx, dy, away = math.cos(turn), math.sin(turn), 1
					end
					sx = other.at_x + dx / away * MARKER_CLEARANCE
					sy = other.at_y + dy / away * MARKER_CLEARANCE
				end
			end

			used = used + 1
			local marker = self.captain_markers[used]
			marker.at_x, marker.at_y = sx, sy
			gui.set_enabled(marker.box, true)
			gui.set_enabled(marker.text, true)
			gui.set_position(marker.box, vmath.vector3(sx, sy, 0))
			gui.set_position(marker.text, vmath.vector3(sx, sy - 30, 0))
			gui.set_color(marker.box, colour)
			gui.set_color(marker.text, colour)
			gui.set_text(marker.text, label or "")
			-- Point it along the lane; a parked fleet points up.
			gui.set_rotation(marker.box, vmath.vector3(0, 0,
				angle and (math.deg(angle) - 90) or 0))
			local scale = mine and 1.0 or 0.82
			-- A force under way breathes; a parked one is still. Position only
			-- changes when a turn resolves, so without this a fleet crossing a
			-- lane is indistinguishable from one sitting on a world - and
			-- animating the *position* would be a lie, because where it can be
			-- intercepted is decided at the turn boundary, not between them.
			if angle then
				local phase = (self.clock or 0) * 3.4 + (at % 7)
				scale = scale * (1 + 0.09 * math.sin(phase))
			end
			gui.set_scale(marker.box, vmath.vector3(scale, scale, 1))
		end

		local mine_colour = player_colour(view.you)
		for i = 1, #view.captains do
			local f = view.captains[i]
			place(f.at, f.next_hop, f.name, mine_colour, true)
		end
		for i = 1, #view.contacts do
			local c = view.contacts[i]
			place(c.at, c.next_hop, c.rank or "", player_colour(c.owner), false)
		end
	end
	for i = used + 1, CAPTAIN_POOL do
		gui.set_enabled(self.captain_markers[i].box, false)
		gui.set_enabled(self.captain_markers[i].text, false)
	end
end

--- Which systems are worth naming, and how loudly.
--
-- The map is deliberately scenery: two hundred stars, most of which a player
-- will never touch. Names are not scenery - a name exists so a place can be
-- referred to - so naming every star turned the map into a wall of words that
-- buried the lanes underneath it.
--
-- The old ranking was static: colony beats outpost beats waypoint, then by how
-- bright the star was drawn, computed once per galaxy and never again. It had
-- no idea which systems were yours, where your captain stood, or what you were
-- looking at, so it faithfully named the prettiest forty stars on the map and
-- none of the six that mattered.
--
-- Relevance instead, highest first:
local LABEL_SELECTED = 5   -- what the sheet is describing
local LABEL_CAPITAL  = 4   -- a capital, anyone's
local LABEL_CAPTAIN  = 3   -- where a captain stands, and where they are bound
local LABEL_HELD     = 2   -- somewhere someone holds, including you
local LABEL_FRONTIER = 1   -- unclaimed, but next to something of yours
local LABEL_NONE     = 0   -- scenery

--- Rebuild the naming order. Cheap enough to do on a change, far too expensive
--- to do per frame: it walks every star and sorts them.
local function rebuild_labels(self, g)
	local view = store.game_view
	local you = view and view.you
	local priority = {}
	local bound = {}

	for i = 1, #((view and view.captains) or {}) do
		local c = view.captains[i]
		bound[c.at] = true
		if c.route then
			for k = 1, #c.route do bound[c.route[k]] = true end
		end
	end

	for id = 1, #g.stars do
		local p = LABEL_NONE
		local seen = view and view.systems[tostring(id)]
		if seen then
			if (seen.capital_of or 0) ~= 0 then
				p = LABEL_CAPITAL
			elseif (seen.owner or 0) ~= 0 then
				p = LABEL_HELD
			end
		end
		if bound[id] and p < LABEL_CAPTAIN then p = LABEL_CAPTAIN end
		if store.selected == id then p = LABEL_SELECTED end
		priority[id] = p
	end

	-- The frontier: unclaimed neighbours of what you hold. This is where a
	-- captain can actually be sent next, so it is the one part of the unowned
	-- map worth being able to name.
	if you then
		for id = 1, #g.stars do
			local seen = view.systems[tostring(id)]
			if seen and seen.owner == you then
				local neighbours = g.adjacency[id]
				for k = 1, #neighbours do
					local n = neighbours[k]
					if priority[n] == LABEL_NONE then
						priority[n] = LABEL_FRONTIER
					end
				end
			end
		end
	end

	local order = {}
	for id = 1, #g.stars do
		if priority[id] > LABEL_NONE then order[#order + 1] = id end
	end
	table.sort(order, function(a, b)
		if priority[a] ~= priority[b] then return priority[a] > priority[b] end
		return a < b
	end)

	self.label_order = order
	self.label_priority = priority
	self.label_dirty = false
end

--- What a name should be rendered in, so ownership reads without being read.
local function label_colour(self, view, id)
	if store.selected == id then return SELECTED_COLOUR end
	local p = self.label_priority and self.label_priority[id] or LABEL_NONE
	local seen = view and view.systems[tostring(id)]
	local owner = seen and seen.owner or 0
	if owner ~= 0 then
		local c = player_colour(owner)
		local mine = view and owner == view.you
		return vmath.vector4(c.x, c.y, c.z, mine and 1.0 or 0.85)
	end
	if p == LABEL_FRONTIER then
		return vmath.vector4(STAR_COLOUR.x, STAR_COLOUR.y, STAR_COLOUR.z, 0.6)
	end
	return vmath.vector4(STAR_COLOUR.x, STAR_COLOUR.y, STAR_COLOUR.z, 0.4)
end

local function update_labels(self, g, cam, w, h)
	local zoom = cam.zoom
	local pad = self.pad
	local floor_y, ceiling_y = self.floor_y, self.ceiling_y

	local placed = {}
	local used_regions = 0
	if zoom <= REGION_LABEL_MAX_ZOOM then
		for i = 1, #g.regions do
			if used_regions >= REGION_LABEL_POOL then break end
			local r = g.regions[i]
			local sx, sy = project(cam, w, h, r.cx, r.cy)
			local text = r.name:upper()
			local pw = ui.measure("map", text, REGION_FONT_SCALE)
			local box = { sx - pw * 0.5, sy - 22, sx + pw * 0.5, sy + 22 }
			local blocked = box[1] < pad.left or box[3] > (w - pad.right)
			if not blocked then
				for pi = 1, #placed do
					local q = placed[pi]
					if not (box[3] < q[1] or box[1] > q[3]
						or box[4] < q[2] or box[2] > q[4]) then
						blocked = true
						break
					end
				end
			end
			if not blocked and sy - 22 > floor_y and sy + 22 < ceiling_y then
				used_regions = used_regions + 1
				local node = self.region_nodes[used_regions]
				gui.set_enabled(node, true)
				gui.set_text(node, text)
				gui.set_position(node, vmath.vector3(sx, sy, 0))
				local c = r.colour
				local fade = 1.0 - math.max(0, math.min(1,
					(zoom - REGION_LABEL_MAX_ZOOM * 0.55) / (REGION_LABEL_MAX_ZOOM * 0.45)))
				gui.set_color(node, vmath.vector4(
					math.min(1, c[1] * 0.5 + 0.5),
					math.min(1, c[2] * 0.5 + 0.5),
					math.min(1, c[3] * 0.5 + 0.5), 0.28 + 0.52 * fade))
				placed[#placed + 1] = box
			end
		end
	end
	for i = used_regions + 1, REGION_LABEL_POOL do
		gui.set_enabled(self.region_nodes[i], false)
	end

	local used_stars = 0
	local span = math.max(0.01, 1.4 - STAR_LABEL_MIN_ZOOM)
	local t = math.max(0, math.min(1, (zoom - STAR_LABEL_MIN_ZOOM) / span))
	local budget = math.floor(STAR_LABELS_AT_MIN_ZOOM
		+ (STAR_LABELS_AT_MAX_ZOOM - STAR_LABELS_AT_MIN_ZOOM) * t + 0.5)
	-- Everything below this tier is scenery at the current zoom.
	local floor_tier = LABEL_CAPTAIN
	if zoom >= LABEL_TIER_ZOOM[2] then floor_tier = LABEL_HELD end
	if zoom >= LABEL_TIER_ZOOM[3] then floor_tier = LABEL_FRONTIER end

	if zoom >= STAR_LABEL_MIN_ZOOM and self.label_order then
		local view = store.game_view
		local order = self.label_order
		for oi = 1, #order do
			if used_stars >= budget then break end
			local id = order[oi]
			if (self.label_priority[id] or 0) < floor_tier then break end
			local s = g.stars[id]
			local sx, sy = project(cam, w, h, s.x, s.y)
			if sy - 16 > floor_y and sy + 16 < ceiling_y then
				local tw = ui.measure("map", s.name, STAR_FONT_SCALE)
				local gap = 14
				local x0 = sx + gap
				local right_limit = w - pad.right
				if (x0 + tw) > right_limit then x0 = sx - gap - tw end
				local clash = x0 < pad.left or (x0 + tw) > right_limit
				-- Claimed with room around it. Boxes that merely avoid
				-- overlapping still produce touching text, which is most of
				-- what "messy" looked like.
				local box = { x0 - 10, sy - 22, x0 + tw + 10, sy + 22 }
				if not clash then
					for p = 1, #placed do
						local q = placed[p]
						if not (box[3] < q[1] or box[1] > q[3]
							or box[4] < q[2] or box[2] > q[4]) then
							clash = true
							break
						end
					end
				end
				if not clash then
					used_stars = used_stars + 1
					local node = self.star_nodes[used_stars]
					gui.set_enabled(node, true)
					gui.set_text(node, s.name)
					gui.set_position(node, vmath.vector3(x0, sy, 0))
					gui.set_color(node, label_colour(self, view, s.id))
					placed[#placed + 1] = box
				end
			end
		end
	end
	for i = used_stars + 1, STAR_LABEL_POOL do
		gui.set_enabled(self.star_nodes[i], false)
	end
end

-- Orders ----------------------------------------------------------------------------

--- Turn a tap on the map into an order, if one was being aimed.
--- Ask the server what path a freshly staged order would take, for drawing.
--
-- Purely presentational: the order that gets *sent* still carries only its
-- waypoints, and the server re-expands them when the turn resolves - by then
-- the map may have moved, and the resolver's answer is the one that counts.
-- What this avoids is a second pathfinder on the client disagreeing with the
-- first, which is the only way a preview can mislead.
local function request_path(self, order, from, fixed)
	local game = store.game
	if not game or not backend.ready() then return end
	order.path_from = from
	backend.game_route(game.id, from, order.route, fixed, function(res, err)
		if err then
			-- The order stands; only the line is missing. A dropped request is
			-- not a reason to throw away what the player asked for.
			return
		end
		if res and res.route and #res.route > 0 then
			order.path = res.route
			return
		end

		-- The server could not route it, so the order is not a real order:
		-- it would sit in the bar looking fine and be refused when the turn
		-- resolved, hours later. Drop it now and say why.
		for i = #store.orders, 1, -1 do
			if store.orders[i] == order then table.remove(store.orders, i) end
		end
		local view = store.game_view
		local hops = view and view.rates and view.rates.hops
		self.flash = hops
			and ("No route - further than " .. ui.plural(hops, "lane") .. " away")
			or ("No route - " .. tostring(res and res.reason or "unreachable"))
		self.flash_timer = 0
		self.sheet_dirty = true
	end)
end

local function resolve_aim(self)
	local selected = store.selected
	if selected == self.last_selected then return end
	self.last_selected = selected
	self.sheet_dirty = true
	-- A launch count belongs to the world it was chosen at.
	self.focus_pending = selected

	local aim = store.aiming
	if not aim or not selected then return end

	if aim.kind == "move" then
		local order = { kind = "move", captain = aim.captain, route = { selected } }
		store.orders[#store.orders + 1] = order
		-- A captain already in a lane must finish it before turning, so the
		-- path is plotted from the far end - the same rule the resolver applies.
		local view = store.game_view
		local from, fixed = nil, nil
		for k = 1, #((view and view.captains) or {}) do
			local c = view.captains[k]
			if c.id == aim.captain then
				from = c.at
				fixed = c.next_hop
			end
		end
		if from then request_path(self, order, fixed or from, fixed) end
	end
	store.aiming = nil
	store.selected_captain = nil
	-- No flash: the manifest in the bar now names the order that was just
	-- added, and a flash would cover the line saying it has not been sent.
end

--- Send the whole plan in one batch.
--
-- Every send carries the *entire* plan, not the part added since the last one.
-- `game.orders` replaces what the server holds rather than appending to it, so
-- a batch that left anything out would silently discard it - which is exactly
-- what happened while the client cleared its own orders on success. The plan
-- now lives until its turn resolves (see main/store.lua).
local function submit_orders(self)
	local game = store.game
	if not game or game.status ~= "active" then
		msg.post("/galaxy#galaxy_script", "regenerate", {})
		return
	end
	if self.sending then return end

	local payload = {}
	for i = 1, #store.orders do
		local o = store.orders[i]
		-- `path`/`path_from` exist only to draw the line; the server expands the
		-- waypoints itself, so they are stripped rather than sent.
		local out = {}
		for k, v in pairs(o) do
			if k ~= "path" and k ~= "path_from" then out[k] = v end
		end
		payload[#payload + 1] = out
	end

	-- Held over the round trip so the button can say so. A send that vanishes
	-- into a request with no visible change is indistinguishable from a tap
	-- that missed.
	self.sending = true
	self.flash, self.flash_timer = nil, 0
	self.sent_flash = nil

	backend.game_orders(game.id, payload, function(res, err)
		self.sending = false
		if err then
			self.flash = "Orders rejected: " .. tostring(err)
			self.flash_timer = 0
			print("galaxy: orders rejected (" .. tostring(err) .. ")")
			return
		end
		print(string.format("galaxy: %d order(s) accepted for turn %s%s",
			res.accepted or 0, tostring(res.for_turn),
			(res.resolved or 0) > 0 and " (resolved immediately)" or ""))
		store.plan_sent(tonumber(res.for_turn) or store.orders_turn)
		store.turn_ended = tonumber(res.for_turn) or true
		store.aiming = nil
		store.selected_captain = nil
		self.sent_flash = 0
		self.flash = nil
		self.sheet_dirty = true
	end)
end

-- Lifecycle -------------------------------------------------------------------------

local function build_chrome(self, w, h)
	ui.region(self.sheet_druid, self.sheet_nodes)
	ui.region(self.chrome_druid, self.chrome_nodes)
	self.sheet_druid, self.chrome_druid = nil, nil
	self.chrome_nodes, self.sheet_nodes = {}, {}
	local previous = ui.collect(self.chrome_nodes)

	self.chrome_druid = druid.new(self)
	self.druid = self.chrome_druid

	local pad = ui.inset()
	self.pad = pad
	build_overview(self, w, h, pad)
	build_bar(self, w, pad, submit_orders)
	ui.collect(previous)
	build_captains(self, w, h, pad)
	self.captain_key = nil

	self.sheet_height = 0
	self.sheet_dirty = true
	publish_zones(self)
end

local function refresh_overview(self)
	local view = store.game_view
	local game = store.game
	local o = self.overview
	local on = (view and game) and true or false

	gui.set_enabled(o.card, on)
	gui.set_enabled(o.border, on)
	local slots = { o.holdings, o.regions, o.clock }
	for i = 1, #slots do
		gui.set_enabled(slots[i].icon, on)
		gui.set_enabled(slots[i].value, on)
		gui.set_enabled(slots[i].note, on)
	end
	if not on then return end

	local rates = view.rates or {}
	gui.set_text(o.holdings.value, ui.number(rates.systems or 0))
	gui.set_text(o.holdings.note, "systems")
	gui.set_color(o.holdings.note, ui.DIM)

	local held = view.regions_held or 0
	local needed = view.regions_needed or 0
	gui.set_text(o.regions.value, string.format("%d/%d", held, needed))
	gui.set_text(o.regions.note, held >= needed and "victory" or "regions")
	gui.set_color(o.regions.value, held >= needed and ui.GOOD or ui.TEXT)

	gui.set_text(o.clock.value, "Turn " .. tostring(view.turn or 0))
	local report = store.pending_report
	if self.report_button then self.report_button:set_enabled(report ~= nil) end
	if report then
		gui.set_text(o.clock.note, "new - tap to read")
		gui.set_color(o.clock.note, ui.ACCENT)
		gui.set_color(o.clock.icon, ui.ACCENT)
	else
		local remaining = math.max(0, (game.next_turn_at or 0) - (store.now_estimate or 0))
		gui.set_text(o.clock.note, ui.duration(remaining))
		gui.set_color(o.clock.note, ui.DIM)
		gui.set_color(o.clock.icon, ui.DIM)
	end
end

--- Put the plan on the page, and return how many lines it took.
local function refresh_manifest(self, lines, sent)
	local shown = math.min(#lines, MANIFEST_LINES)
	local overflow = #lines - shown
	-- Sent lines are stated rather than proposed, so they sit back a weight.
	local colour = sent and ui.DIM or ui.TEXT

	for i = 1, MANIFEST_LINES do
		local node = self.manifest[i]
		if i <= shown then
			gui.set_enabled(node, true)
			gui.set_text(node, "- " .. lines[i])
			gui.set_color(node, colour)
		else
			gui.set_enabled(node, false)
		end
	end

	local last = self.manifest[MANIFEST_LINES + 1]
	if overflow > 0 then
		gui.set_enabled(last, true)
		gui.set_text(last, "  +" .. overflow .. " more")
		gui.set_color(last, ui.FAINT)
		return shown + 1
	end
	gui.set_enabled(last, false)
	return shown
end

local function refresh_bar(self, g)
	local game = store.game
	local in_game = (game and game.status == "active") and true or false

	local aiming = store.aiming ~= nil
	self.cancel.set_visible(in_game and aiming)
	-- While aiming there are exactly two things to do: pick a destination, or
	-- give up. A dead SEND next to CANCEL is a third thing that looks like an
	-- option and is not one.
	self.send.set_visible(not (in_game and aiming))

	if in_game then
		local view = store.game_view
		local count = store.plan_count()

		-- A plan adopts the turn it is aimed at the moment it has anything in
		-- it, which is what lets a resolving turn tell a live plan from a stale
		-- one. This runs every frame, so there is no window in which a staged
		-- order has no turn against it.
		if count > 0 and not store.orders_turn then
			store.orders_turn = (view and view.turn or 0) + 1
		end

		-- One signature does both jobs: it says whether anything is unsent, and
		-- it is the cache key for the manifest. Without the key this rebuilt
		-- three formatted strings and walked the fleet list every frame, and
		-- nothing else in this project does per-frame work on the CPU.
		local signature = (count > 0) and store.plan_signature() or ""
		local unsent = (count > 0) and (store.sent_signature ~= signature) or false
		local turn = store.orders_turn or ((view and view.turn or 0) + 1)

		local quiet = (count == 0) and not store.aiming and not self.flash
			and not self.sending and store.selected ~= nil
		local key = signature .. (unsent and "|unsent" or "|in") .. (quiet and "|q" or "")
		if key ~= self.manifest_key then
			self.manifest_key = key
			local rows = refresh_manifest(self, plan_lines(), not unsent)
			layout_bar(self, quiet and -1 or rows)
		end

		-- Four states, and each one has to be distinguishable at a glance from
		-- a tap that did nothing: SEND is the only one that is interactive, and
		-- SENT is a receipt that reverts on its own.
		local label, style, enabled
		if self.sending then
			label, style, enabled = "SENDING", "disabled", false
		elseif self.sent_flash then
			label, style, enabled = "SENT", "success", false
		elseif unsent then
			label, style, enabled = "SEND " .. count, "primary", true
		elseif count > 0 then
			label, style, enabled = "ORDERS IN", "disabled", false
		elseif store.turn_ended then
			label, style, enabled = "WAITING", "disabled", false
		else
			-- Nothing to send is not nothing to say. Submitting is what ends a
			-- player's turn, and the turn resolves as soon as everyone has -
			-- so a player with no orders needs a way to say they are done, or
			-- a game of prompt players still waits out the clock.
			label, style, enabled = "END TURN", "primary", true
		end
		self.send.set_text(label)
		-- Enabled first: set_enabled picks a style of its own, so the exact one
		-- has to be applied after it.
		self.send.set_enabled(enabled)
		self.send.set_style(style)

		local text, tone = self.flash, ui.ACCENT
		if not text then
			local aim = store.aiming
			if aim then
				local captain = captain_by_id(aim.captain)
				text, tone = string.format("Tap where %s should go",
					(captain and captain.name) or "the captain"), ui.ACCENT
			elseif self.sending then
				text, tone = "Sending...", ui.DIM
			elseif store.turn_ended and count == 0 then
				text, tone = "Turn ended - waiting on the others", ui.GOOD
			elseif count > 0 and not unsent then
				text, tone = string.format("%s in for turn %d",
					ui.plural(count, "order"), turn), ui.GOOD
			elseif count > 0 then
				text, tone = string.format("%s for turn %d, not sent yet",
					ui.plural(count, "order"), turn), ui.WARN
			elseif store.selected then
				text, tone = "", ui.DIM
			else
				text, tone = "Tap a captain to give them orders", ui.DIM
			end
		end
		gui.set_text(self.status, text)
		gui.set_color(self.status, tone)
	else
		layout_bar(self, 0)
		self.send.set_text("NEW GALAXY")
		self.send.set_enabled(true)
		self.send.set_style("secondary")
		gui.set_text(self.status, g and string.format("Seed %d   %s", g.seed,
			tostring(store.source or "?")) or "")
		gui.set_color(self.status, ui.DIM)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()

	self.star_nodes = {}
	for _ = 1, STAR_LABEL_POOL do
		make_label(self.star_nodes, STAR_FONT_SCALE, STAR_COLOUR)
	end
	self.region_nodes = {}
	for _ = 1, REGION_LABEL_POOL do
		local n = make_label(self.region_nodes, REGION_FONT_SCALE, STAR_COLOUR)
		gui.set_pivot(n, gui.PIVOT_CENTER)
	end
	self.captain_markers = {}
	for _ = 1, CAPTAIN_POOL do make_marker(self.captain_markers) end

	-- Route segments, pooled like everything else on the map. Created before the
	-- fleet markers would draw over them, which is what we want: the marker is
	-- the force, the line is only where it is going.
	self.route_nodes = {}
	for _ = 1, ROUTE_POOL do
		local bar = ui.sprite(0, 0, 10, ROUTE_WIDTH, "solid", ui.ACCENT)
		gui.set_pivot(bar, gui.PIVOT_CENTER)
		gui.set_enabled(bar, false)
		local dot = ui.sprite(0, 0, ROUTE_NODE, ROUTE_NODE, "pill", ui.ACCENT)
		gui.set_pivot(dot, gui.PIVOT_CENTER)
		gui.set_enabled(dot, false)
		self.route_nodes[#self.route_nodes + 1] = { bar = bar, dot = dot }
	end

	self.status_text = ui.text(0, 0, "", ui.TITLE, ui.DIM, { pivot = gui.PIVOT_CENTER })
	gui.set_enabled(self.status_text, false)

	self.revision = -1
	self.layout_w, self.layout_h = -1, -1
	self.layout_safe = -1
	self.pad = ui.inset()
	self.sheet_nodes = {}
	self.captain_nodes = {}
	self.captain_h = 0
	self.captain_key = nil
	self.sheet_height = 0
	self.sheet_dirty = true
	self.flash, self.flash_timer = nil, 0
	self.sent_flash, self.sending = nil, false
	self.floor_y, self.ceiling_y = 0, 0
	store.hud_bar_height = self.pad.bottom + BAR_H
end

function final(self)
	if self.sheet_druid then self.sheet_druid:final() end
	if self.captain_druid then self.captain_druid:final() end
	if self.chrome_druid then self.chrome_druid:final() end
	store.hud_zones = {}
end

function update(self, dt)
	local w, h = store.screen.width, store.screen.height
	if w ~= self.layout_w or h ~= self.layout_h
		or self.layout_safe ~= store.safe_revision then
		build_chrome(self, w, h)
		gui.set_position(self.status_text, vmath.vector3(w * 0.5, h * 0.5, 0))
		self.layout_w, self.layout_h = w, h
		self.layout_safe = store.safe_revision
	end

	self.chrome_druid:update(dt)
	if self.captain_druid then self.captain_druid:update(dt) end
	if self.sheet_druid then self.sheet_druid:update(dt) end

	if self.flash then
		self.flash_timer = self.flash_timer + dt
		if self.flash_timer > 4 then self.flash = nil end
	end
	-- The receipt on the SEND button. Long enough to be read, short enough that
	-- the button is back to saying what it would do next before a thumb returns.
	if self.sent_flash then
		self.sent_flash = self.sent_flash + dt
		if self.sent_flash > 2.5 then self.sent_flash = nil end
	end

	if store.status then
		gui.set_enabled(self.status_text, true)
		gui.set_text(self.status_text, store.status)
	else
		gui.set_enabled(self.status_text, false)
	end

	self.clock = (self.clock or 0) + dt
	automation.update(dt)

	-- Leaving the game. The menu popup sets this rather than navigating itself,
	-- because a screen being torn down cannot reliably do it.
	if store.leave_requested then
		store.leave_requested = nil
		monarch.back(nil, function()
			-- Cleared once the map is gone. The store is process-wide, so a
			-- stale view would follow the player into the next game they open.
			store.game = nil
			store.game_view = nil
			store.game_id = nil
			store.selected = nil
			store.selected_captain = nil
			store.aiming = nil
			store.orders = {}
			store.orders_turn = nil
			store.sent_signature = nil
			store.turn_ended = nil
			store.pending_report = nil
		end)
		return
	end

	local g = store.galaxy

	-- The naming order depends on who holds what, where the captains are and
	-- what is selected, so it is rebuilt when any of those move rather than
	-- every frame: it walks every star and sorts them.
	if g then
		local view = store.game_view
		local key = table.concat({
			tostring(store.selected), tostring(view and view.turn),
			tostring(view and #view.captains), tostring(store.revision),
		}, ":")
		if self.label_dirty or key ~= self.label_key then
			self.label_key = key
			rebuild_labels(self, g)
		end
	end

	refresh_overview(self)
	refresh_bar(self, g)
	if not g then return end

	if self.revision ~= store.revision then
		self.revision = store.revision
		self.label_dirty = true
		self.sheet_dirty = true
	end

	resolve_aim(self)
	if self.sheet_dirty then
		self.sheet_dirty = false
		self.sheet_height = build_sheet(self, w, self.pad)
		publish_zones(self)
	end

	-- The strip is a list of faces, so it only has to be rebuilt when the faces
	-- change: who is in the field, where they are, and which is selected.
	local view = store.game_view
	local key = {}
	for i = 1, #((view and view.captains) or {}) do
		local f = view.captains[i]
		key[#key + 1] = table.concat({ f.id, f.portrait or "",
			f.at or 0, (f.eta or 0) > 0 and "m" or "p" }, ":")
	end
	key[#key + 1] = tostring(store.selected_captain)
	local joined = table.concat(key, "|")
	if joined ~= self.captain_key then
		self.captain_key = joined
		build_captains(self, w, h, self.pad)
	end

	self.floor_y = self.pad.bottom + BAR_H + bar_extra(self) + self.sheet_height
	self.ceiling_y = h - self.pad.top - TOP_H - (self.captain_h or 0)
	store.hud_band.floor = self.floor_y
	store.hud_band.ceiling = self.ceiling_y

	-- Bring a newly selected system into view, but only if the sheet that
	-- describes it is now sitting on top of it.
	--
	-- Deferred to here rather than done at the tap, because how much of the map
	-- is left depends on how tall the sheet turned out - a waypoint is three
	-- lines and a developed colony is most of the screen.
	--
	-- Conditional on purpose: moving the map on every selection would be its own
	-- kind of clunky. The camera only intervenes when the alternative is the
	-- player looking at a card about a star they cannot see.
	if self.focus_pending and g then
		local star = g.stars[self.focus_pending]
		self.focus_pending = nil
		if star then
			local cam = store.camera
			local _, sy = project(cam, w, h, star.x, star.y)
			local margin = 40
			if sy < self.floor_y + margin or sy > self.ceiling_y - margin then
				local band = (self.floor_y + self.ceiling_y) * 0.5
				msg.post("camera#camera_script", "focus", {
					x = star.x,
					y = star.y - (band - h * 0.5) / cam.zoom,
				})
			end
		end
	end

	update_labels(self, g, store.camera, w, h)
	update_routes(self, g, store.camera, w, h)
	update_captains(self, g, store.camera, w, h)
end

local function on_chrome(self, x, y)
	local zones = store.hud_zones
	for i = 1, #zones do
		local z = zones[i]
		if x >= z[1] and x <= z[3] and y >= z[2] and y <= z[4] then return true end
	end
	return false
end

function on_input(self, action_id, action)
	if not self.chrome_druid then return false end
	local converted = ui.gui_action(action)
	local handled = self.chrome_druid:on_input(action_id, converted)
	if self.captain_druid and self.captain_druid:on_input(action_id, converted) then
		handled = true
	end
	if self.sheet_druid and self.sheet_druid:on_input(action_id, converted) then
		handled = true
	end

	-- Claim the input only if it landed on the chrome. Druid reports a touch as
	-- handled whenever one of its hover components tracked it, which is every
	-- touch anywhere on screen - returning that verbatim swallowed the map's
	-- pans and the galaxy became undraggable.
	if handled and converted then
		local x, y = converted.x, converted.y
		if converted.touch and converted.touch[1] then
			x, y = converted.touch[1].x, converted.touch[1].y
		end
		if x and y and on_chrome(self, x, y) then return true end
	end

	if action_id == hash("reroll") and action.released then
		msg.post("/galaxy#galaxy_script", "regenerate", {})
		return true
	end
	return false
end

function on_message(self, message_id, message, sender)
	if self.chrome_druid then
		self.chrome_druid:on_message(message_id, message, sender)
	end
	if self.sheet_druid then
		self.sheet_druid:on_message(message_id, message, sender)
	end
end
