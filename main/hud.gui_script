--- The in-game interface: map labels, the overview bar, and the order controls.
--
-- Two very different jobs live here, and they are kept apart deliberately.
--
-- *Map labels* are a pool of text nodes recycled every frame. Only what is on
-- screen and worth naming gets one, so the node count stays flat however large
-- the galaxy is, and the placement pass rejects overlaps so names never stack.
--
-- *Chrome* - the overview bar, the selected-system card, the order controls - is
-- built once from main/ui.lua and driven by setting text and colours. Every
-- control is a real Druid button: the previous version hand-rolled rectangle
-- hit-testing because `gui.pick_node` is unusable in this project's coordinate
-- space, but ui.install_druid_picking() fixes that at the source, so there is no
-- longer any reason for the HUD to own its own input handling.
--
-- The camera also wants these touches. Rather than relying on winning the
-- input-focus race with the GUI - acquisition order is not guaranteed - the HUD
-- publishes the rectangles it occupies into `store.hud_zones`, and the camera
-- declines any gesture that starts inside one.

local store = require("main.store")
local backend = require("main.backend")
local ui = require("main.ui")
local monarch = require("monarch.monarch")
local druid = require("druid.druid")
local resources = require("galaxy.sim.resources")

local STAR_LABEL_POOL = 80
local REGION_LABEL_POOL = 12

-- Below this zoom individual systems are too dense to label legibly, and only
-- region names are drawn.
local STAR_LABEL_MIN_ZOOM = 0.30
-- How many system labels to show at the extremes of the zoom range. Filling the
-- screen with names at full zoom-out turns the map into a wall of text, so the
-- budget grows as the player zooms in and the map earns the detail.
local STAR_LABELS_AT_MIN_ZOOM = 14
local STAR_LABELS_AT_MAX_ZOOM = 80
-- Above this, region names would sit uselessly far off screen.
local REGION_LABEL_MAX_ZOOM = 1.10

-- map.font is baked at 34px; these are the fractions of it the map draws at.
local STAR_FONT_SCALE = 0.62
local REGION_FONT_SCALE = 1.00

-- Chrome metrics. Outer margins come from ui.inset(), which adds the device's
-- safe-area insets to the design gap - the world still draws edge to edge, only
-- the chrome is held clear of a notch or a gesture strip.
local TOP_H = 96
local BOTTOM_H = 176
local INFO_H = 264

local STAR_COLOUR = ui.rgb(0xC2CCDE)
local SELECTED_COLOUR = ui.rgb(0xFFE79E)

local RESOURCE_KINDS = { "metal", "fuel", "research" }

local function make_text(pool, size, colour)
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(node, "map")
	gui.set_scale(node, vmath.vector3(size, size, 1))
	gui.set_color(node, colour)
	gui.set_pivot(node, gui.PIVOT_W)
	gui.set_enabled(node, false)
	pool[#pool + 1] = node
	return node
end

-- Chrome ----------------------------------------------------------------------

--- Republish the rectangles the camera must not pan from.
local function publish_zones(self)
	local zones = {}
	if self.top_zone then zones[#zones + 1] = self.top_zone end
	if self.bottom_zone then zones[#zones + 1] = self.bottom_zone end
	if self.info_zone and self.info_visible then zones[#zones + 1] = self.info_zone end
	store.hud_zones = zones
end

--- The always-visible balances, plus the turn clock.
--
-- These are the numbers a player checks most often, so they cost no taps. The
-- rate matters as much as the balance - a balance only says where you are - so
-- both are on the chip.
local function build_overview(self, w, h, pad)
	local y = h - pad.top
	local width = w - pad.left - pad.right
	local card, border = ui.card(pad.left, y, width, TOP_H)
	self.overview = { card = card, border = border, value = {}, rate = {}, icon = {} }

	local column = (width - 36) / 4
	local x = pad.left + 20
	for i = 1, #RESOURCE_KINDS do
		local kind = RESOURCE_KINDS[i]
		local cx = x + column * (i - 1)
		self.overview.icon[kind] = ui.icon(cx, y - 26, 34, ui.RESOURCE_ICON[kind],
			ui.RESOURCE_COLOUR[kind])
		self.overview.value[kind] = ui.text(cx + 44, y - 36, "0", ui.BODY, ui.TEXT,
			{ bold = true })
		self.overview.rate[kind] = ui.text(cx + 44, y - 68, "", ui.SMALL, ui.DIM)
	end

	local cx = x + column * 3
	self.overview.clock_icon = ui.icon(cx, y - 27, 32, "icon_clock", ui.DIM)
	self.overview.turn = ui.text(cx + 42, y - 36, "", ui.BODY, ui.TEXT, { bold = true })
	self.overview.clock = ui.text(cx + 42, y - 68, "", ui.SMALL, ui.DIM)

	self.top_zone = { pad.left, h - pad.top - TOP_H, w - pad.right, h - pad.top }
end

--- What the player has selected: what it is, what it holds, what it produces.
--
-- Built once with a fixed shape and then filled in, rather than rebuilt per
-- selection. Selection changes on every tap, and deleting and recreating twenty
-- nodes each time is churn the frame does not need.
local function build_info(self, w, pad)
	local y = pad.bottom + BOTTOM_H + ui.GAP + INFO_H
	local width = w - pad.left - pad.right
	local inner = pad.left + 24
	local nodes = {}
	local function keep(node) nodes[#nodes + 1] = node; return node end

	local card, border = ui.card(pad.left, y, width, INFO_H)
	keep(card)
	keep(border)

	self.info = { nodes = nodes, stat = {}, yield = {} }
	self.info.name = keep(ui.h2(inner, y - 40, ""))
	self.info.subtitle = keep(ui.small(inner, y - 76, ""))
	keep(ui.divider(inner, y - 96, width - 48))

	-- Holdings: warships, population, freighters.
	local column = (width - 48) / 3
	local slots = { "warship", "growth", "freighter" }
	for i = 1, #slots do
		local sx = inner + column * (i - 1)
		self.info.stat[i] = {
			icon = keep(ui.icon(sx, y - 112, 30, "icon_" .. slots[i], ui.FAINT)),
			value = keep(ui.text(sx + 40, y - 127, "-", ui.BODY, ui.TEXT, { bold = true })),
		}
	end

	keep(ui.caps(inner, y - 166, "yield"))
	for i = 1, #RESOURCE_KINDS do
		local kind = RESOURCE_KINDS[i]
		local sx = inner + column * (i - 1)
		self.info.yield[kind] = {
			icon = keep(ui.icon(sx, y - 186, 28, ui.RESOURCE_ICON[kind],
				ui.RESOURCE_COLOUR[kind])),
			value = keep(ui.text(sx + 38, y - 200, "", ui.SMALL, ui.TEXT)),
		}
	end

	self.info.hint = keep(ui.small(inner, y - 228, "", ui.ACCENT,
		{ width = width - 48, anchor_top = true }))
	self.info_zone = { pad.left, y - INFO_H, w - pad.right, y }
	self.info_visible = nil
end

--- Show or hide the whole selected-system card, its exclusion zone included.
local function set_info_visible(self, visible)
	if self.info_visible == visible then return end
	self.info_visible = visible
	for i = 1, #self.info.nodes do
		gui.set_enabled(self.info.nodes[i], visible)
	end
	publish_zones(self)
end

--- The order controls.
local function build_controls(self, w, pad, submit)
	local y = pad.bottom + BOTTOM_H
	local width = w - pad.left - pad.right
	ui.card(pad.left, y, width, BOTTOM_H)

	local inner = 24
	self.status = ui.small(pad.left + inner, y - 26, "", ui.DIM,
		{ width = width - inner * 2, anchor_top = true })

	local row_y = y - 66
	local bh = ui.CONTROL
	local left = pad.left + inner
	local right = w - pad.right - inner

	-- EMPIRE opens the stockpile and research popup.
	local empire_w = 176
	self.empire = ui.button(self.druid, left, row_y, empire_w, bh, "EMPIRE",
		function() monarch.show(hash("empire")) end,
		{ icon = "icon_research", icon_size = 30, size = ui.CAPS })

	-- What the next planned order sends. A segmented control rather than one
	-- button that changes label: sending warships when you meant freighters is
	-- expensive, so which mode is active has to be readable at a glance rather
	-- than inferred from a caption.
	local seg_x = left + empire_w + 14
	local seg_w = 240
	-- The track is visibly lighter than the card, not darker: at BG_SOFT it
	-- disappeared into the panel and the control read as one blue pill sitting
	-- next to some grey text rather than as two choices.
	ui.pill(seg_x, row_y, seg_w, bh, ui.CARD_ALT)
	ui.pill_line(seg_x, row_y, seg_w, bh, ui.BORDER)
	self.mode_halves = {}
	local modes = {
		{ id = "move", label = "MOVE", icon = "icon_warship" },
		{ id = "trade", label = "TRADE", icon = "icon_freighter" },
	}
	for i = 1, #modes do
		local mode = modes[i]
		local hw = (seg_w - 10) * 0.5
		local hx = seg_x + 5 + hw * (i - 1)
		local fill = ui.pill(hx, row_y - 5, hw, bh - 10, ui.CLEAR)
		local glyph = ui.icon(hx + 12, row_y - 18, 28, mode.icon, ui.DIM)
		local label = ui.text(hx + 48, row_y - bh * 0.5, mode.label, ui.CAPS, ui.DIM,
			{ bold = true })
		self.mode_halves[i] = { id = mode.id, fill = fill, glyph = glyph, label = label }
		self.druid:new_button(fill, function()
			store.order_mode = mode.id
			-- A half-made plan in the other mode would send the wrong hulls.
			store.order_source = nil
		end)
	end

	local send_x = seg_x + seg_w + 14
	self.send = ui.button(self.druid, send_x, row_y, right - send_x, bh, "SEND",
		function() submit(self) end, { style = "primary", size = ui.CAPS })

	self.bottom_zone = { pad.left, y - BOTTOM_H, w - pad.right, y }
	-- Includes the safe inset, so the camera frames the galaxy in the space the
	-- player can actually see.
	store.hud_bar_height = pad.bottom + BOTTOM_H
end

-- Map labels ------------------------------------------------------------------

local function update_labels(self, g, cam, w, h)
	local zoom = cam.zoom
	local half_w, half_h = w * 0.5, h * 0.5
	-- Labels never intrude on the chrome, nor under a notch.
	local pad = self.pad
	local floor_y = pad.bottom + BOTTOM_H
		+ (self.info_visible and (ui.GAP + INFO_H) or 0)
	local ceiling_y = h - pad.top - TOP_H

	local function to_screen(wx, wy)
		return (wx - cam.x) * zoom + half_w, (wy - cam.y) * zoom + half_h
	end

	-- Region names first: they own the space, and star labels avoid them.
	local placed = {}
	local used_regions = 0
	if zoom <= REGION_LABEL_MAX_ZOOM then
		for i = 1, #g.regions do
			if used_regions >= REGION_LABEL_POOL then break end
			local r = g.regions[i]
			local sx, sy = to_screen(r.cx, r.cy)
			local text = r.name:upper()
			local pw = ui.measure("map", text, REGION_FONT_SCALE)
			local pbox = { sx - pw * 0.5, sy - 22, sx + pw * 0.5, sy + 22 }
			-- A region name is centred on its centroid, so it can hang off
			-- either edge - and past a rounded corner or a notch.
			local blocked = pbox[1] < pad.left or pbox[3] > (w - pad.right)
			for pi = 1, #placed do
				local q = placed[pi]
				if not (pbox[3] < q[1] or pbox[1] > q[3] or pbox[4] < q[2] or pbox[2] > q[4]) then
					blocked = true
					break
				end
			end
			if not blocked and sy - 22 > floor_y and sy + 22 < ceiling_y then
				used_regions = used_regions + 1
				local node = self.region_nodes[used_regions]
				gui.set_enabled(node, true)
				gui.set_text(node, text)
				gui.set_position(node, vmath.vector3(sx, sy, 0))
				local c = r.colour
				-- Fade the region name out as the player zooms into it.
				local fade = 1.0 - math.max(0, math.min(1,
					(zoom - REGION_LABEL_MAX_ZOOM * 0.55) / (REGION_LABEL_MAX_ZOOM * 0.45)))
				gui.set_color(node, vmath.vector4(
					math.min(1, c[1] * 0.5 + 0.5),
					math.min(1, c[2] * 0.5 + 0.5),
					math.min(1, c[3] * 0.5 + 0.5), 0.28 + 0.52 * fade))
				placed[#placed + 1] = pbox
			end
		end
	end
	for i = used_regions + 1, REGION_LABEL_POOL do
		gui.set_enabled(self.region_nodes[i], false)
	end

	-- Star names, brightest first, skipping any that would collide.
	local used_stars = 0
	local span = math.max(0.01, 1.4 - STAR_LABEL_MIN_ZOOM)
	local t = math.max(0, math.min(1, (zoom - STAR_LABEL_MIN_ZOOM) / span))
	local budget = math.floor(STAR_LABELS_AT_MIN_ZOOM
		+ (STAR_LABELS_AT_MAX_ZOOM - STAR_LABELS_AT_MIN_ZOOM) * t + 0.5)
	if zoom >= STAR_LABEL_MIN_ZOOM then
		local order = self.label_order
		for oi = 1, #order do
			if used_stars >= budget then break end
			local s = g.stars[order[oi]]
			local sx, sy = to_screen(s.x, s.y)
			-- The label's own half-height, not a fudge factor: a name whose box
			-- overlapped a card by a few pixels was still being drawn.
			if sy - 16 > floor_y and sy + 16 < ceiling_y then
				local tw = ui.measure("map", s.name, STAR_FONT_SCALE)
				local gap = 14
				-- Place to the right normally, but flip to the left rather than
				-- let the name run off the edge of the screen. If it does not
				-- fit either way, it is simply not drawn - a name sliced by the
				-- screen edge is worse than no name.
				local x0 = sx + gap
				local right_limit = w - pad.right
				if (x0 + tw) > right_limit then x0 = sx - gap - tw end
				local clash = x0 < pad.left or (x0 + tw) > right_limit
				local box = { x0, sy - 15, x0 + tw, sy + 15 }
				if not clash then
					for p = 1, #placed do
						local q = placed[p]
						if not (box[3] < q[1] or box[1] > q[3]
							or box[4] < q[2] or box[2] > q[4]) then
							clash = true
							break
						end
					end
				end
				if not clash then
					used_stars = used_stars + 1
					local node = self.star_nodes[used_stars]
					gui.set_enabled(node, true)
					gui.set_text(node, s.name)
					gui.set_position(node, vmath.vector3(x0, sy, 0))
					gui.set_color(node, store.selected == s.id and SELECTED_COLOUR or STAR_COLOUR)
					placed[#placed + 1] = box
				end
			end
		end
	end
	for i = used_stars + 1, STAR_LABEL_POOL do
		gui.set_enabled(self.star_nodes[i], false)
	end
end

-- Orders ----------------------------------------------------------------------

--- What the player knows about a system, or nil if they have never seen it.
local function known(id)
	local view = store.game_view
	if not view then return nil end
	return view.systems[tostring(id)]
end

--- Turn a pair of taps into a queued order.
--
-- First tap on a system you own picks the origin; the next tap on another
-- system queues half of what is there. Half rather than all, because emptying a
-- system by accident is the most expensive mistake available and this is a
-- two-tap gesture.
--
-- The MOVE/TRADE toggle decides which hulls travel. A trade run is the same
-- gesture but sends freighters, and only to a system you already own, since a
-- route needs two ends you hold.
local function plan_orders(self)
	local selected = store.selected
	if selected == self.last_selected then return end
	self.last_selected = selected
	if not selected or not store.game_view then return end

	local me = store.game_view.you
	local trading = store.order_mode == "trade"
	local info = known(selected)

	local function stock_at(entry)
		if not entry then return 0 end
		return trading and (entry.freighters or 0) or (entry.ships or 0)
	end

	if not store.order_source then
		if info and info.owner == me and info.live and stock_at(info) > 1 then
			store.order_source = selected
		end
		return
	end

	if selected == store.order_source then
		store.order_source = nil
		return
	end

	-- A trade run has to end somewhere you hold; anything else is refused by
	-- the server anyway, and refusing it here saves the player a turn.
	if trading and not (info and info.owner == me and info.live) then
		store.order_source = nil
		return
	end

	local available = stock_at(known(store.order_source))
	for i = 1, #store.orders do
		local o = store.orders[i]
		if o.from == store.order_source and (o.kind == "trade") == trading then
			available = available - o.ships
		end
	end

	local send = math.floor(available * 0.5)
	if send >= 1 then
		store.orders[#store.orders + 1] = {
			kind = trading and "trade" or "move",
			from = store.order_source, to = selected, ships = send,
		}
	end
	store.order_source = nil
end

--- How many separate things are waiting to be sent.
local function pending_count()
	local n = #store.orders
	if store.pending_research ~= nil then n = n + 1 end
	if store.pending_share ~= nil then n = n + 1 end
	return n
end

--- Send the whole plan: movement, trade, research target and build policy.
--
-- One batch, because the server replaces the turn's orders wholesale. Sending
-- the standing choices separately would mean the second call wiped the first.
local function submit_orders(self)
	local game = store.game
	if not game or game.status ~= "active" then
		msg.post("/galaxy#galaxy_script", "regenerate", {})
		return
	end

	local payload = {}
	for i = 1, #store.orders do
		payload[#payload + 1] = store.orders[i]
	end
	if store.pending_research ~= nil then
		payload[#payload + 1] = { kind = "research", tech = store.pending_research }
	end
	if store.pending_share ~= nil then
		payload[#payload + 1] = { kind = "policy", warship_share = store.pending_share }
	end
	if #payload == 0 then return end

	backend.game_orders(game.id, payload, function(res, err)
		if err then
			self.flash = "Orders rejected: " .. tostring(err)
			self.flash_timer = 0
			print("galaxy: orders rejected (" .. tostring(err) .. ")")
			return
		end
		print(string.format("galaxy: %d order(s) accepted for turn %s",
			res.accepted or 0, tostring(res.for_turn)))
		store.orders = {}
		store.order_source = nil
		store.pending_research = nil
		store.pending_share = nil
		self.flash = "Orders in for turn " .. tostring(res.for_turn)
		self.flash_timer = 0
	end)
end

--- Build every piece of chrome. Re-run when the view size or the insets change.
local function build_chrome(self, w, h)
	-- Druid components hold node references, so a relayout drops the whole
	-- instance rather than removing them one at a time...
	if self.chrome_druid then self.chrome_druid:final() end
	-- ...and the nodes themselves have to go with it. ui.collect records them;
	-- without this every rebuild leaked a whole layout and the scene ran out of
	-- nodes after a few window changes.
	if self.chrome_nodes then
		for i = 1, #self.chrome_nodes do gui.delete_node(self.chrome_nodes[i]) end
	end
	self.chrome_nodes = {}
	local previous = ui.collect(self.chrome_nodes)

	self.chrome_druid = druid.new(self)
	self.druid = self.chrome_druid

	local pad = ui.inset()
	self.pad = pad
	build_overview(self, w, h, pad)
	build_info(self, w, pad)
	build_controls(self, w, pad, submit_orders)
	set_info_visible(self, false)
	publish_zones(self)

	ui.collect(previous)
end

-- Per-frame refresh -----------------------------------------------------------

local function refresh_overview(self)
	local view = store.game_view
	local game = store.game
	local o = self.overview
	local on = (view and game) and true or false

	gui.set_enabled(o.card, on)
	gui.set_enabled(o.border, on)
	gui.set_enabled(o.clock_icon, on)
	gui.set_enabled(o.turn, on)
	gui.set_enabled(o.clock, on)
	for i = 1, #RESOURCE_KINDS do
		local kind = RESOURCE_KINDS[i]
		gui.set_enabled(o.icon[kind], on)
		gui.set_enabled(o.value[kind], on)
		gui.set_enabled(o.rate[kind], on)
	end
	if not on then return end

	for i = 1, #RESOURCE_KINDS do
		local kind = RESOURCE_KINDS[i]
		gui.set_text(o.value[kind], ui.number(view.stock[kind]))
		local rate = view.income and view.income[kind] or 0
		gui.set_text(o.rate[kind], ui.rate(rate))
		gui.set_color(o.rate[kind], rate >= 0 and ui.GOOD or ui.BAD)
	end
	gui.set_text(o.turn, "Turn " .. tostring(view.turn or 0))
	local remaining = math.max(0, (game.next_turn_at or 0) - (store.now_estimate or 0))
	gui.set_text(o.clock, ui.duration(remaining))
end

local function refresh_info(self, g)
	local id = store.selected
	if not id or not g or not g.stars[id] then
		set_info_visible(self, false)
		return
	end
	set_info_visible(self, true)

	local s = g.stars[id]
	local info = known(id)
	local view = store.game_view

	gui.set_text(self.info.name, s.name)

	local subtitle = s.class_label
	local region = g.regions[s.region]
	if region then subtitle = subtitle .. "   " .. region.name end
	if s.feature_label ~= "" then subtitle = subtitle .. "   " .. s.feature_label end
	gui.set_text(self.info.subtitle, subtitle)

	local values = { "-", "-", "-" }
	local stat_colour = ui.FAINT
	if info then
		values[1] = tostring(info.ships or 0)
		values[2] = tostring(info.population or 0)
		if (info.freighters or 0) > 0 then values[3] = tostring(info.freighters) end
		stat_colour = info.live and ui.TEXT or ui.DIM
	end
	for i = 1, 3 do
		gui.set_text(self.info.stat[i].value, values[i])
		gui.set_color(self.info.stat[i].value, stat_colour)
		gui.set_color(self.info.stat[i].icon, values[i] == "-" and ui.FAINT or ui.DIM)
	end

	-- Yields are derived from the star class and feature, which are public map
	-- data, so they are worth showing even somewhere never visited: knowing what
	-- a system is worth is how a conquest gets planned.
	local y = resources.base_yield(g, id)
	for i = 1, #RESOURCE_KINDS do
		local kind = RESOURCE_KINDS[i]
		gui.set_text(self.info.yield[kind].value, string.format("%.1f", y[kind]))
	end

	-- The line that says what tapping next will do.
	local hint, hint_colour = "", ui.DIM
	if view then
		local me = view.you
		if store.order_source == id then
			hint = store.order_mode == "trade"
				and "Selected - tap a system you own to open a route"
				or "Selected - tap a destination"
			hint_colour = ui.ACCENT
		elseif store.order_source then
			hint = "Tap again to send from " .. g.stars[store.order_source].name
			hint_colour = ui.ACCENT
		elseif not info then
			hint = "Unexplored"
			hint_colour = ui.FAINT
		elseif info.owner == 0 then
			hint = "Unclaimed"
		else
			local stale = info.live and "" or "   last seen turn " .. tostring(info.seen)
			if info.owner == me then
				hint = "Yours" .. stale
				hint_colour = ui.GOOD
			else
				local who = (view.players[info.owner] and view.players[info.owner].name)
					or ("Player " .. info.owner)
				hint = who .. stale
				hint_colour = ui.BAD
			end
		end
	end
	gui.set_text(self.info.hint, hint)
	gui.set_color(self.info.hint, hint_colour)
end

local function refresh_controls(self, g)
	local game = store.game
	local in_game = (game and game.status == "active") and true or false

	self.empire.set_visible(in_game)
	for i = 1, #self.mode_halves do
		local half = self.mode_halves[i]
		local on = store.order_mode == half.id
		gui.set_enabled(half.fill, in_game)
		gui.set_enabled(half.glyph, in_game)
		gui.set_enabled(half.label, in_game)
		gui.set_color(half.fill, on and ui.ACCENT or ui.CLEAR)
		gui.set_color(half.glyph, on and ui.ACCENT_TEXT or ui.DIM)
		gui.set_color(half.label, on and ui.ACCENT_TEXT or ui.DIM)
	end

	if in_game then
		local pending = pending_count()
		self.send.set_text(pending > 0 and ("SEND " .. pending) or "NO ORDERS")
		self.send.set_style(pending > 0 and "primary" or "disabled")

		local text = self.flash
		if not text then
			if store.order_source then
				text = "Choose where to send them"
			elseif pending > 0 then
				text = string.format("%d order%s ready", pending, pending == 1 and "" or "s")
			else
				text = store.order_mode == "trade"
					and "Tap a system with freighters to open a route"
					or "Tap one of your systems to move ships"
			end
		end
		gui.set_text(self.status, text)
		gui.set_color(self.status, self.flash and ui.ACCENT or ui.DIM)
	else
		self.send.set_text("NEW GALAXY")
		self.send.set_style("secondary")
		gui.set_text(self.status, g and string.format("Seed %d   %s", g.seed,
			tostring(store.source or "?")) or "")
		gui.set_color(self.status, ui.DIM)
	end
end

-- Lifecycle -------------------------------------------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()

	self.star_nodes = {}
	for _ = 1, STAR_LABEL_POOL do
		make_text(self.star_nodes, STAR_FONT_SCALE, STAR_COLOUR)
	end
	self.region_nodes = {}
	for _ = 1, REGION_LABEL_POOL do
		local n = make_text(self.region_nodes, REGION_FONT_SCALE, STAR_COLOUR)
		gui.set_pivot(n, gui.PIVOT_CENTER)
	end

	-- Centred status line, shown while connecting or waiting on the server.
	self.status_text = ui.text(0, 0, "", ui.TITLE, ui.DIM, { pivot = gui.PIVOT_CENTER })
	gui.set_enabled(self.status_text, false)

	self.revision = -1
	self.layout_w, self.layout_h = -1, -1
	self.layout_safe = -1
	self.pad = ui.inset()
	self.flash = nil
	self.flash_timer = 0
	store.hud_bar_height = self.pad.bottom + BOTTOM_H
end

function final(self)
	if self.chrome_druid then self.chrome_druid:final() end
	store.hud_zones = {}
end

function update(self, dt)
	local w, h = store.screen.width, store.screen.height
	-- The platform reports safe-area insets as not-ready for the first frames,
	-- so a layout built once at startup would sit under the notch forever.
	if w ~= self.layout_w or h ~= self.layout_h
		or self.layout_safe ~= store.safe_revision then
		build_chrome(self, w, h)
		gui.set_position(self.status_text, vmath.vector3(w * 0.5, h * 0.5, 0))
		self.layout_w, self.layout_h = w, h
		self.layout_safe = store.safe_revision
	end

	self.chrome_druid:update(dt)

	-- A flash message is a confirmation, not state; it should not sit there.
	if self.flash then
		self.flash_timer = self.flash_timer + dt
		if self.flash_timer > 4 then self.flash = nil end
	end

	-- The status line has to work before there is a galaxy: it is what the
	-- player sees while the backend is being contacted.
	if store.status then
		gui.set_enabled(self.status_text, true)
		gui.set_text(self.status_text, store.status)
	else
		gui.set_enabled(self.status_text, false)
	end

	local g = store.galaxy
	refresh_overview(self)
	refresh_controls(self, g)
	if not g then
		set_info_visible(self, false)
		return
	end

	-- Rank stars once per galaxy: brightest and largest get labelled first.
	if self.revision ~= store.revision then
		self.revision = store.revision
		local order = {}
		for i = 1, #g.stars do order[i] = i end
		table.sort(order, function(a, b)
			local sa, sb = g.stars[a], g.stars[b]
			local wa = sa.radius * sa.glow
			local wb = sb.radius * sb.glow
			if wa ~= wb then return wa > wb end
			return a < b
		end)
		self.label_order = order
	end

	plan_orders(self)
	refresh_info(self, g)
	update_labels(self, g, store.camera, w, h)
end

--- Is a point inside any chrome the HUD currently owns?
local function on_chrome(self, x, y)
	local zones = store.hud_zones
	for i = 1, #zones do
		local z = zones[i]
		if x >= z[1] and x <= z[3] and y >= z[2] and y <= z[4] then return true end
	end
	return false
end

function on_input(self, action_id, action)
	if not self.chrome_druid then return false end
	-- Druid hit-tests with the action it is given; it must be in GUI space.
	local converted = ui.gui_action(action)
	local handled = self.chrome_druid:on_input(action_id, converted)

	-- Claim the input only if it landed on the chrome. Druid reports a touch as
	-- handled whenever one of its hover components tracked it, which is every
	-- touch anywhere on screen - returning that verbatim swallowed the map's
	-- pans and the galaxy became undraggable.
	if handled and converted then
		local x, y = converted.x, converted.y
		if converted.touch and converted.touch[1] then
			x, y = converted.touch[1].x, converted.touch[1].y
		end
		if x and y and on_chrome(self, x, y) then return true end
	end

	if action_id == hash("reroll") and action.released then
		msg.post("/galaxy#galaxy_script", "regenerate", {})
		return true
	end
	return false
end

function on_message(self, message_id, message, sender)
	if self.chrome_druid then
		self.chrome_druid:on_message(message_id, message, sender)
	end
end
