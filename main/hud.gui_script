--- The in-game interface: map labels, army markers, and the order controls.
--
-- Three jobs, kept apart deliberately.
--
-- *Map labels and army markers* are pools of nodes recycled every frame. Only
-- what is on screen gets one, so the count stays flat however large the realm
-- is, and the label pass rejects overlaps so names never stack.
--
-- *The tile sheet* is rebuilt whenever the selection changes, because its
-- content varies enormously - open country you have never visited needs three
-- lines, a developed city of yours needs garrison, output, three installations
-- and a list of armies. `ui.collect` records the nodes so the rebuild does not
-- leak.
--
-- *The order bar* is built once and driven by setting text.
--
-- Every control is a real Druid button. The camera also wants these touches, so
-- rather than relying on winning the input-focus race - acquisition order is not
-- guaranteed - the HUD publishes the rectangles it occupies into
-- `store.hud_zones`, and the camera declines any gesture starting inside one.

local store = require("main.store")
local seen = require("main.seen")
local automation = require("main.automation")
local backend = require("main.backend")
local ui = require("main.ui")
local monarch = require("monarch.monarch")
local druid = require("druid.druid")
local config = require("realm.config")
local sim_tiles = require("realm.sim.tiles")
local sim_units = require("realm.sim.units")
local playback = require("main.playback")
-- Generated by tools/import_emoji.py: unit id -> atlas image in main/emoji.atlas.

local TILE_LABEL_POOL = 70
local PROVINCE_LABEL_POOL = 12
local COMMANDER_POOL = 40
-- Segments of drawn route. Pools cost their nodes whether or not they are used,
-- and the usual case is one or two legs, so this is sized for a busy turn
-- rather than for the theoretical maximum of every commander on a twelve-tile
-- campaign; beyond it the tail of a route simply is not drawn.
local ROUTE_POOL = 64
-- The face on an army marker, and the chevron that says where it is headed.
-- The face is the officer's own portrait - the same drawing the commander strip
-- carries - so a commander picked off the strip can be found on the map without
-- reading a label. It is deliberately not rotated: a face turned sideways stops
-- being a face, which is the whole reason the heading moved out to a pip.
local MARKER_FACE = 38
local MARKER_PIP = 16

-- How far apart two army markers must stay on screen before one is nudged.
local MARKER_CLEARANCE = 46
-- How far a marker reaches from its own centre: the ring, and the caption
-- hanging below it. Culling on the bare centre point - which is what this did -
-- blinked an officer out of existence while most of the disc was still on
-- screen, and the band it is culled against moves by the whole height of the
-- tile sheet the moment a tile is selected. The routes have always had this
-- slack; the markers never did.
local MARKER_REACH = 46
local ROUTE_WIDTH = 3
local ROUTE_NODE = 9

local TILE_LABEL_MIN_ZOOM = 0.30
-- How many names may be on screen at once. Seventy fitted, in the sense that
-- seventy nodes were drawn - the map underneath them did not. These are chosen
-- by relevance now (see rebuild_labels), so a small budget is a filter rather
-- than a truncation: the ones that survive are the ones worth reading.
local TILE_LABELS_AT_MIN_ZOOM = 8
local TILE_LABELS_AT_MAX_ZOOM = 22
-- Which relevance tiers are admitted, by zoom. Pulled back rather than pushed
-- out: at a distance you want to know whose space you are looking at, not what
-- every rock is called.
local LABEL_TIER_ZOOM = { 0.30, 0.55, 0.95 }
local PROVINCE_LABEL_MAX_ZOOM = 1.10

-- map.font is baked at 34px; these are the fractions of it the map draws at.
local TILE_FONT_SCALE = 0.62
local PROVINCE_FONT_SCALE = 1.00

local TOP_H = 96
-- The zoom stack, on the right under the overview. Pinch is the only other way
-- in, and multi-touch cannot be injected from a workstation - so before these
-- existed the range past the fit zoom was not just untested but unlooked-at,
-- and every device screenshot was taken at the one zoom the map ever reached.
--
-- It sits against the *top* chrome rather than the bottom, which costs some
-- thumb reach, because the bottom right is not a stable place to put anything:
-- the order bar spans the full width and grows upward as the plan does, and the
-- tile sheet comes up over it. A control that moves when you stage an order
-- is the same problem SEND was kept still to avoid.
local ZOOM_SIZE = ui.CONTROL
local ZOOM_GAP = 8
-- Between the in/out pair and the fit button, which is a different kind of
-- thing: one steps, the other goes back to the beginning.
local ZOOM_SPLIT = 16
-- The commander strip under the overview: one face per force in the field. It
-- is the roster *and* the way around the map - with a cap of four there are
-- never enough of them to need a list, and a player thinks in terms of "where
-- is Kess", not "which tile was that".
local COMMANDER_SIZE = 62
local COMMANDER_GAP = 10
local COMMANDER_H = COMMANDER_SIZE + 14
-- A status line and one row of controls. Every point saved here is map.
local BAR_H = 156
-- The staged plan is listed in the bar, and the bar grows *upward* to hold it,
-- so SEND stays exactly where a thumb last found it. Past this many lines the
-- rest collapse into a count: the bar still has to leave a map behind it.
local MANIFEST_LINES = 3
local MANIFEST_LINE_H = 34
-- Where the first manifest line sits below the top of the card. The status line
-- is above it and the control row below, and both stay put as the list grows:
-- see layout_bar for why every line lands in the same place regardless of how
-- many there are.
local MANIFEST_TOP = 60
-- What the status line costs the bar when it has nothing to say.
local STATUS_ROW_H = 30
-- The sheet is as tall as its content, between these. The floor is a header and
-- its padding: a tile that is not yours has nothing else on the card, and 200
-- left it sitting in an empty box that read as broken rather than as brief.
local SHEET_MIN = 120
-- The ceiling has stopped binding. The card was a document and a developed
-- city ran past 900 with no scroll behind it, so content spilled over the
-- order bar; three rows of slots is around 530 whatever is built. Kept because
-- the clamp costs nothing and the camera reads the height either way
-- (`store.hud_band`, which is what stops a tall card trapping its own tile).
local SHEET_MAX = 960

-- A unit slot, and the rack it sits in. Six across is exactly the card's inner
-- width at the design resolution. 94 units is 54 dp - well over the 48 dp floor
-- the rest of the kit holds to, which matters more here than anywhere else in
-- the interface because these are *drag* targets: an off-by-one slot is a wrong
-- army, and the stepper this replaced was already down at 60 (34 dp).
local SLOT = 94
local SLOT_GAP = 14
local SLOTS_PER_ROW = 6
-- How far a finger may wander and still have meant a tap, summed over both
-- axes. A tap sends a unit straight across; anything further is a drag, and the
-- player says where it lands.
local TAP_SLOP = 24
-- The glyph carried under the finger. Smaller than a slot so the circle it came
-- from stays visible behind it.
local GHOST = 66

-- Playback. The transport sits where the order bar does, because it replaces
-- it: while a digest is playing there is nothing to order.
-- Tall enough for what it holds: a turn label, a caption that can wrap to two
-- lines, the scrub track, and a row of full-size controls. The first pass was
-- 150 and the buttons hung off the bottom of the screen - a card sized by
-- guesswork rather than by adding up what is in it.
local PLAYBACK_H = 236
-- Seconds a turn is held at 1x, before playback.duration weights it by what
-- happened. Slow enough to follow a marker across a tile, brisk enough that
-- forty turns is under a minute at 1x and a few seconds at 4x.
local PLAYBACK_BASE = 0.9
local PLAYBACK_SPEEDS = { 1, 2, 4 }
-- How long a live turn's card is held. The first one announces that something
-- is about to happen; the ones between chained turns only have to say which
-- turn this is.
local LIVE_CARD = 1.0
local LIVE_CARD_CHAINED = 0.6
-- How far a finger may travel and still count as "give me the map back". The
-- same job `gestures.lua` does with `tap_slop`, in the one place that cannot
-- ask it: the recogniser never sees these touches, because the replay has
-- published the whole screen as its own.
local PB_TAP_SLOP = 24
-- Close enough that a commander crossing a tile is a thing you can watch. The map
-- opens at the fit zoom, where the whole realm is on screen and a marker is
-- four pixels wide - which is fine for reading borders and useless for
-- following a march.
local PLAYBACK_ZOOM = 1.5

-- Map-side inks. The map is parchment now, so its labels are dark ink with a
-- pale halo; the chrome stays dark and keeps its own palette.
local TILE_COLOUR = ui.rgb(0x3A3428)
local SELECTED_COLOUR = ui.rgb(0x9C5A00)
-- The outline colour for map text. map.font bakes an outline channel; the
-- node decides its colour, and until now nothing did - the default black halo
-- was invisible on space and would smudge on paper.
local LABEL_OUTLINE = vmath.vector4(0.95, 0.91, 0.82, 0.9)

local function player_colour(index)
	local palette = config.player_palette
	local c = palette[((index - 1) % #palette) + 1]
	return vmath.vector4(c[1], c[2], c[3], 1)
end

-- The same player as ink, for everything drawn ON the map - labels, markers,
-- routes - where the chrome's bright palette washes out against parchment.
-- Same hue per index, so a player is one colour everywhere, at the value each
-- ground needs.
local function player_ink(index)
	local palette = config.player_palette_ink
	local c = palette[((index - 1) % #palette) + 1]
	return vmath.vector4(c[1], c[2], c[3], 1)
end

-- Pools --------------------------------------------------------------------------

local function make_label(pool, size, colour)
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(node, "map")
	gui.set_scale(node, vmath.vector3(size, size, 1))
	gui.set_color(node, colour)
	gui.set_outline(node, LABEL_OUTLINE)
	gui.set_pivot(node, gui.PIVOT_W)
	gui.set_enabled(node, false)
	pool[#pool + 1] = node
	return node
end

--- One army marker: a face, a ring, a heading pip and a caption.
--
-- Four nodes rather than one tinted glyph, because the marker has to carry four
-- separate things and the face can only carry one of them. **The ring is the
-- ownership colour** - `ui.emoji` and a portrait are somebody's drawing and are
-- never tinted, so the player colour that used to be the glyph itself had to
-- move somewhere, and until the ownership wash is drawn this is the only thing
-- on the map that says whose army it is. Same vocabulary as the commander
-- strip, which is already a face in a coloured ring.
local function make_marker(pool)
	-- Ring after face, so it covers the disc's soft edge instead of sitting
	-- behind it and leaving a pale halo - the rule ui.portrait already follows.
	local face = ui.portrait(0, 0, MARKER_FACE, nil, { ring = false })
	gui.set_pivot(face, gui.PIVOT_CENTER)
	gui.set_enabled(face, false)
	local ring = ui.ring(0, 0, MARKER_FACE, ui.TEXT)
	gui.set_pivot(ring, gui.PIVOT_CENTER)
	gui.set_enabled(ring, false)
	local pip = ui.icon(0, 0, MARKER_PIP, "icon_chevron_right", ui.TEXT)
	gui.set_pivot(pip, gui.PIVOT_CENTER)
	gui.set_enabled(pip, false)
	local text = ui.text(0, 0, "", ui.SMALL, ui.TEXT,
		{ bold = true, pivot = gui.PIVOT_CENTER })
	gui.set_enabled(text, false)
	pool[#pool + 1] = { face = face, ring = ring, pip = pip, text = text }
end

local function hide_marker(marker)
	gui.set_enabled(marker.face, false)
	gui.set_enabled(marker.ring, false)
	gui.set_enabled(marker.pip, false)
	gui.set_enabled(marker.text, false)
end

-- Chrome -------------------------------------------------------------------------

local function publish_zones(self)
	local zones = {}
	if self.top_zone then zones[#zones + 1] = self.top_zone end
	if self.bar_zone then zones[#zones + 1] = self.bar_zone end
	if self.commander_zone then zones[#zones + 1] = self.commander_zone end
	if self.zoom_zone then zones[#zones + 1] = self.zoom_zone end
	if self.pb and self.pb.live then
		-- No transport to own the touch, so the replay owns the screen. The
		-- camera declines any gesture starting inside a published zone, which
		-- is what stops a tap reaching `pick_tile` and a drag panning the map
		-- out from under the thing it is showing. Computed here rather than
		-- stored, so a window change cannot leave a stale rectangle behind.
		zones[#zones + 1] = { 0, 0, store.screen.width, store.screen.height }
	elseif self.pb_zone then
		zones[#zones + 1] = self.pb_zone
	end
	if self.sheet_zone then zones[#zones + 1] = self.sheet_zone end
	store.hud_zones = zones
end

--- World position to screen, the same relationship the render script builds its
--- projection from. Everything the HUD draws over the map goes through this.
local function project(cam, w, h, wx, wy)
	return (wx - cam.x) * cam.zoom + w * 0.5, (wy - cam.y) * cam.zoom + h * 0.5
end

--- A title card over the map, held for a moment and then gone.
--
-- **Arriving is not a changelog.** The digest used to open as a list the moment
-- a player came back to a game, which is a wall of forty rows in front of a map
-- they have not seen yet - and the thing they actually want to know, where the
-- war moved, is a shape rather than a sentence. So the list is no longer the
-- greeting: this says what is about to happen, then the replay says what
-- happened.
--
-- Its own node list, deleted rather than hidden: it exists for a second and a
-- half of the session and should not survive a relayout in the wrong place.
local TITLE_SECONDS = 1.5
local TITLE_FADE = 0.4

local function title_clear(self)
	if self.title_nodes then ui.region(nil, self.title_nodes) end
	self.title_nodes = nil
	self.title_alpha = nil
	self.title_timer = nil
	self.title_then = nil
	self.title_held = nil
	self.title_fade = nil
end

--- @param seconds  how long to hold it, defaulting to the arrival card's 1.5.
---   A turn announcing itself between two animations gets far less: a second
---   and a half of scrim between them reads as the replay having stalled.
local function title_card(self, w, h, heading, detail, then_do, seconds)
	title_clear(self)
	self.title_nodes = {}
	self.title_alpha = {}
	local previous = ui.collect(self.title_nodes)
	-- **A scrim, because the map is behind it.** Province names are set large and
	-- pale and land exactly where a centred caption does; without something to
	-- sit on, the two read as one sentence.
	local scrim = ui.sprite(0, h, w, h, "solid", ui.BG)
	gui.set_color(scrim, vmath.vector4(ui.BG.x, ui.BG.y, ui.BG.z, 0.82))
	local y = h * 0.5
	ui.text(w * 0.5, y + 18, heading:upper(), ui.H2, ui.TEXT,
		{ pivot = gui.PIVOT_CENTER, bold = true, tracking = 0.10 })
	if detail then
		ui.small(w * 0.5, y - 26, detail, ui.DIM, { pivot = gui.PIVOT_CENTER })
	end
	ui.collect(previous)
	for i = 1, #self.title_nodes do
		self.title_alpha[i] = gui.get_color(self.title_nodes[i]).w
	end
	self.title_timer = 0
	self.title_then = then_do
	self.title_held = seconds or TITLE_SECONDS
	-- The fade has to fit inside the card. A fixed 0.4 s is a quarter of the
	-- arrival card and two thirds of a chained one, where it would read as a
	-- caption that was never fully there.
	self.title_fade = math.min(TITLE_FADE, self.title_held * 0.35)
end

local function title_update(self, dt)
	if not self.title_timer then return end
	self.title_timer = self.title_timer + dt
	-- Faded out on the way, so the replay does not start behind a caption. Each
	-- node fades from whatever it was, or the scrim would brighten to full on
	-- its way out.
	local held = self.title_held or TITLE_SECONDS
	local fade = self.title_fade or TITLE_FADE
	local left = held - self.title_timer
	if left < fade then
		local k = math.max(0, left / fade)
		for i = 1, #self.title_nodes do
			local c = gui.get_color(self.title_nodes[i])
			gui.set_color(self.title_nodes[i],
				vmath.vector4(c.x, c.y, c.z, (self.title_alpha[i] or 1) * k))
		end
	end
	if self.title_timer >= held then
		local then_do = self.title_then
		title_clear(self)
		if then_do then then_do() end
	end
end

-- Playback -----------------------------------------------------------------------

--- What the turn being replayed should be captioned with.
--
-- One line, chosen by what a player would lead with rather than by event order:
-- a province changing hands outranks a tile, which outranks walking into empty
-- space. A quiet turn says so - that the front has stalled is information, and
-- skipping it silently would make the timeline lie about how long nothing
-- happened.
local function step_caption(step, you, name_of, place_of)
	local best, rank = nil, -1
	local function offer(r, text) if r > rank then best, rank = text, r end end
	local events = step.events or {}
	for i = 1, #events do
		local e = events[i]
		if e.kind == "victory" then
			offer(6, e.player == you and "You won" or (name_of(e.player) .. " won"))
		elseif e.kind == "eliminated" then
			offer(5, name_of(e.player) .. " lost their seat")
		elseif e.kind == "province_control" then
			offer(4, (e.player == you and "You took " or
				((e.player ~= 0 and name_of(e.player) or "Nobody") .. " holds "))
				.. (e.name or "a province"))
		elseif e.kind == "commander_broken" then
			offer(3, (e.name or "A commander") .. " was broken at " .. place_of(e.lost))
		elseif e.kind == "battle" then
			offer(2, (e.player == you and (e.name or "You") or name_of(e.player))
				.. " took " .. place_of(e.at))
		elseif e.kind == "transferred" then
			offer(2, (e.name or "A commander") .. " took aboard "
				.. tostring(e.units or 0) .. " at " .. place_of(e.at))
		elseif e.kind == "bought" then
			offer(1, "Bought " .. tostring(e.units or 0) .. " at "
				.. place_of(e.at))
		elseif e.kind == "garrison_lost" then
			offer(3, "The garrison at " .. place_of(e.at) .. " was destroyed")
		elseif e.kind == "claimed" then
			offer(1, (e.player == you and "You claimed " or (name_of(e.player)
				.. " claimed ")) .. place_of(e.at))
		elseif e.kind == "contact_moved" then
			offer(0, (e.rank or "A rival") .. " was sighted near " .. place_of(e.at))
		elseif e.kind == "commander_moved" then
			-- **The lowest rank, and the one that was missing.** A march that
			-- claimed nothing and fought nobody still has a marker crossing
			-- tiles on screen, and the step is not quiet - `playback.build`
			-- counts moves. Without this the caption fell through to "Nothing
			-- moved" while something was visibly moving, which reads as the
			-- game not knowing what it is showing.
			offer(0, (e.name or "A commander") .. " reached " .. place_of(e.at))
		end
	end
	return best or "Nothing moved"
end

--- Point the camera at whatever this turn was about.
--
-- The average of everywhere something happened, which for the usual turn - one
-- commander, one tile - is that tile. A turn with fighting at both ends of the
-- map pulls to the middle and shows neither well; that is the honest answer at
-- one camera, and the scrub track is how a player goes back and looks properly.
local function playback_look(self, step)
	local g = store.realm
	if not g then return end
	local sx, sy, n = 0, 0, 0
	local function add(id)
		local tile = id and g.tiles[id]
		if tile then sx, sy, n = sx + tile.x, sy + tile.y, n + 1 end
	end
	for i = 1, #step.moves do
		add(step.moves[i].from)
		add(step.moves[i].path[#step.moves[i].path])
	end
	for i = 1, #step.changes do add(step.changes[i].at) end
	if n == 0 then return end
	local x, y = sx / n, sy / n

	-- **A live turn only moves the camera when it has to.** An arrival digest
	-- is days old and the player had chosen nothing, so framing each turn is
	-- the whole service. A turn landing while they watch is the other case:
	-- they set this view deliberately, and hauling it somewhere else twice a
	-- turn takes away the thing `pb_camera` exists to give back. So intervene
	-- only when the alternative is watching something off the edge of the
	-- band - the same rule the tile sheet's own lift already keeps.
	if self.pb and self.pb.live then
		local cam = store.camera
		local w, h = store.screen.width, store.screen.height
		local px, py = project(cam, w, h, x, y)
		local margin = 60
		if px > margin and px < w - margin
			and py > self.floor_y + margin and py < self.ceiling_y - margin then
			return
		end
	end
	msg.post("camera#camera_script", "focus", { x = x, y = y })
end

local function playback_publish(self)
	local p = self.pb
	local step = p and p.steps[p.index]
	store.playback_owners = step and step.owners or (p and p.final) or nil
	store.playback_revision = store.playback_revision + 1
	if step then playback_look(self, step) end
end

local function playback_stop(self)
	if not self.pb then return end
	self.pb = nil
	-- A live turn announces each step with a card, so leaving - or a second
	-- digest arriving - can catch one on screen with a callback pointing at a
	-- playback that no longer exists. The callback is guarded as well, but a
	-- caption left hanging over the map is its own fault.
	title_clear(self)
	store.playback_active = false
	-- Back to today. The live view has been correct the whole time; only the
	-- two ownership layers were being drawn from the past.
	store.playback_owners = nil
	store.playback_revision = store.playback_revision + 1
	-- Back to where the player was. For a digest that is the whole map, because
	-- they opened it from a card and had not chosen a view; leaving them zoomed
	-- into the last turn's corner would end every digest somewhere they did not
	-- pick.
	--
	-- **A turn that played out live is the other case.** They *were* looking at
	-- something - that is why they saw it happen - so framing the realm
	-- afterwards takes away a view they chose, every turn, for as long as they
	-- watch. Their own camera is restored instead.
	local was = self.pb_camera
	self.pb_camera = nil
	if was then
		-- Two messages, because `focus` glides the centre and `zoom_level` sets
		-- the range; the camera eases both, so this reads as coming back rather
		-- than as a cut.
		msg.post("camera#camera_script", "zoom_level", { zoom = was.zoom })
		msg.post("camera#camera_script", "focus", { x = was.x, y = was.y })
	else
		msg.post("camera#camera_script", "zoom_fit")
	end
	ui.region(self.pb_druid, self.pb_nodes)
	self.pb_druid, self.pb_nodes = nil, {}
	self.pb_zone = nil
	self.commander_key = nil
	self.label_dirty = true
	publish_zones(self)
end

--- Announce the turn about to play, and hold it there until the card is gone.
--
-- The card *is* the pause: nothing advances behind it, and its callback is the
-- only thing that sets the step running. So a live digest carrying two turns
-- reads as `TURN 11`, a march, `TURN 12`, a march - each one named, rather than
-- two turns of movement running together into one confusing sweep.
local function playback_card(self, seconds)
	local p = self.pb
	if not p then return end
	p.playing = false
	p.elapsed = 0
	local step = p.steps[p.index]
	if not step then return end
	title_card(self, store.screen.width, store.screen.height,
		"Turn " .. tostring(step.turn), nil,
		-- Guarded on identity, not on existence: a relayout fires this the
		-- instant the safe-area insets land (see `update`), and the player can
		-- leave, or a second digest can start, in the second it is up.
		function() if self.pb == p then p.playing = true end end,
		seconds)
end

--- Begin watching a digest. Returns false if there is nothing to watch.
local function playback_start(self, digest)
	local view = store.game_view
	if not view then return false end
	-- The roster goes with the map: `playback.build` winds ownership back from
	-- today's tiles and positions back from today's officers, so both seeds are
	-- the present and both ends of the timeline are exact.
	local steps, final = playback.build(digest, view.tiles, view.commanders)
	if #steps == 0 then return false end
	-- Forty turns of "nothing moved" is the list this replaces, only slower.
	-- A playback has to have something in it to be worth watching, so a digest
	-- where nothing crossed a tile or changed hands goes back to being read.
	local worth_watching = false
	for i = 1, #steps do
		if not steps[i].quiet then worth_watching = true break end
	end
	if not worth_watching then return false end

	-- Playback is a mode, so everything that belongs to *now* stands down: the
	-- sheet describes a tile as it is today, and the order bar offers moves
	-- for a turn that has not happened yet.
	store.selected = nil
	store.aiming = nil
	self.sheet_dirty = true
	self.pb = {
		steps = steps, final = final, index = 1, elapsed = 0,
		-- A live turn opens behind its own card and starts when the card is
		-- done; an arrival digest has already had one and plays straight away.
		playing = not digest.live, speed = 1,
		you = digest.you or (view and view.you) or 0,
		-- **The whole of what makes a live turn different.** It is a flag
		-- rather than a second implementation, because the thing being shown
		-- is identical and only the chrome and the ending are not: a turn you
		-- watched land wants announcing and then getting out of the way, and a
		-- fortnight you missed wants a timeline you can operate.
		live = digest.live and true or false,
		-- Kept so the transport can hand it to the list. A replay is better at
		-- "where did the war move"; the log is better at "what exactly did that
		-- battle cost", and there is no reason to make the player choose once.
		digest = digest,
	}
	store.playback_active = true
	-- Kept only for a live turn: see `playback_stop`.
	if digest.live then
		self.pb_camera = {
			x = store.camera.x, y = store.camera.y, zoom = store.camera.zoom,
		}
	end
	-- **Closer, never further out.** An arrival digest opens at the fit zoom,
	-- where a marker is four pixels wide, so framing it is the whole service.
	-- A player watching a turn land has already chosen a view, and one sitting
	-- closer than this does not want pulling back from it.
	if not digest.live or store.camera.zoom < PLAYBACK_ZOOM then
		msg.post("camera#camera_script", "zoom_level", { zoom = PLAYBACK_ZOOM })
	end
	playback_publish(self)
	self.commander_key = nil
	self.label_dirty = true
	self.pb_layout = nil
	-- A live turn publishes the whole screen as its own; an arrival digest
	-- publishes the transport once it is built. Either way the zones have to be
	-- right from the first frame, or the touch that started this can pan the
	-- map before anything is drawn on it.
	publish_zones(self)
	if digest.live then playback_card(self, LIVE_CARD) end
	return true
end

local function playback_seek(self, index)
	local p = self.pb
	if not p then return end
	p.index = math.max(1, math.min(#p.steps, index))
	p.elapsed = 0
	playback_publish(self)
	self.label_dirty = true
end

--- The always-visible numbers: what the empire has, and when the turn lands.
local function build_overview(self, w, h, pad)
	local y = h - pad.top
	local width = w - pad.left - pad.right
	local card, border = ui.card(pad.left, y, width, TOP_H)
	self.overview = { card = card, border = border }

	-- The way out. The map had no exit at all - once you were in a game the
	-- only way back to the lobby was to restart the app. It sits where EMPIRE
	-- used to, which is the corner a thumb already goes to.
	local menu_size = 60
	self.menu = ui.icon_button(self.druid, w - pad.right - 14 - menu_size,
		y - 18, menu_size, "icon_menu",
		function() monarch.show(hash("menu")) end,
		{ background = ui.CARD_ALT, colour = ui.DIM })
	local x = pad.left + 14
	local column = ((w - pad.right - 28 - menu_size) - x) / 4
	local function slot(i, icon, colour)
		local cx = x + column * (i - 1)
		return {
			icon = ui.icon(cx, y - 26, 30, icon, colour),
			value = ui.text(cx + 38, y - 34, "0", ui.BODY, ui.TEXT, { bold = true }),
			note = ui.text(cx + 38, y - 66, "", ui.SMALL, ui.DIM),
		}
	end
	-- Provinces replace the raw research number here. Research is a means and
	-- lives on the empire screen; provinces are the objective, and how close the
	-- game is has to be readable without opening anything.
	self.overview.holdings = slot(1, "icon_tile", ui.TEXT)
	self.overview.provinces = slot(2, "icon_flag", ui.ACCENT)
	-- The purse. It is the one number a player has to watch between turns -
	-- everything else on the map is a consequence of it - so it belongs here
	-- rather than a tap away.
	self.overview.gold = slot(3, "icon_industry", ui.GOOD)
	self.overview.clock = slot(4, "icon_clock", ui.DIM)

	-- Where a digest with nothing to animate waits. A turn that lands while
	-- you are watching plays out on the map instead and is read by being
	-- watched (see update), so what reaches this card is an *arrival* digest
	-- the playback declined - a quiet stretch, or a first turn - offered in
	-- the player's own time. The hit area is its own transparent node because
	-- the slot is three separate nodes and the whole of it should be the
	-- target; picking here is an axis-aligned test against position and size,
	-- so an invisible node is still pickable.
	local clock_x = x + column * 3
	self.report_hit = ui.panel(clock_x - 8, y - 12, column, 74, ui.CLEAR)
	self.report_button = self.druid:new_button(self.report_hit, function()
		local digest = store.pending_report
		if not digest then return end
		store.pending_report = nil
		-- Opening it is what marks it read; until then the poll keeps asking
		-- for the same window so nothing is lost if the player never taps.
		store.seen_turn = digest.turn or store.seen_turn
		seen.set(store.game_id, store.seen_turn)
		-- Watched, not read. A list of forty turns is a changelog; what a player
		-- wants after two days away is where the war moved, and that is a shape
		-- on a map. The list is still the fallback for a digest with nothing to
		-- animate - and for a first turn, where there is no movement yet.
		self.pending_digest = digest
		if not playback_start(self, digest) then
			self.pending_digest = nil
			monarch.show(hash("report"), nil, digest)
		end
	end)
	self.report_button:set_enabled(false)

	self.top_zone = { pad.left, h - pad.top - TOP_H, w - pad.right, h - pad.top }
end

--- Zoom in, zoom out, and frame the whole realm.
--
-- The camera owns the step size and the range; these only say which direction,
-- so there is one description of how far a press goes rather than two that can
-- drift apart.
local function build_zoom(self, w, h, pad)
	local x = w - pad.right - ZOOM_SIZE
	local top = h - pad.top - TOP_H - ui.GAP

	local function press(out)
		return function() msg.post("camera#camera_script", "zoom_step", { out = out }) end
	end

	self.zoom_in = ui.icon_button(self.druid, x, top, ZOOM_SIZE, "icon_plus",
		press(false), { background = ui.CARD, colour = ui.TEXT })
	local y = top - ZOOM_SIZE - ZOOM_GAP
	self.zoom_out = ui.icon_button(self.druid, x, y, ZOOM_SIZE, "icon_minus",
		press(true), { background = ui.CARD, colour = ui.TEXT })
	y = y - ZOOM_SIZE - ZOOM_SPLIT
	-- Deliberately never disabled. At the fit zoom it still recentres, which is
	-- the other half of being lost on a map this much larger than the screen.
	ui.icon_button(self.druid, x, y, ZOOM_SIZE, "icon_frame",
		function() msg.post("camera#camera_script", "zoom_fit") end,
		{ background = ui.CARD, colour = ui.DIM })

	self.zoom_zone = { x, y - ZOOM_SIZE, x + ZOOM_SIZE, top }
	-- Forced apart so the first refresh applies a style rather than deciding
	-- nothing has changed.
	self.zoom_state = nil
end

--- Grey the pair out at the ends of the range.
--
-- Gated on a change, like everything else in here: this is called every frame
-- and nothing else in the project does per-frame work.
local function refresh_zoom(self)
	if not self.zoom_in then return end
	local cam = store.camera
	local can_in = cam.zoom < (cam.zoom_max or 1) - 1e-4
	local can_out = cam.zoom > (cam.zoom_min or 1) + 1e-4
	local state = (can_in and "i" or "-") .. (can_out and "o" or "-")
	if state == self.zoom_state then return end
	self.zoom_state = state
	self.zoom_in.set_enabled(can_in)
	self.zoom_out.set_enabled(can_out)
end

-- A glyph per building, so a filled slot is recognisable before it is read.
-- Drawn from the kit's existing set rather than new art: what each one is for
-- is already in the vocabulary - a hull for a yard, a cog for works, a shield
-- for a bastion, a flag for the place officers come from.
local BUILDING_ICON = {
	berths = "icon_warship",
	interceptor_bay = "icon_speed",
	foundry = "icon_industry",
	bastion = "icon_defence",
	admiralty = "icon_flag",
}

-- Which of them a player can actually *do* something with. Only the Admiralty,
-- so far - it is where officers are raised.
local BUILDING_VERB = { admiralty = true }

local function tile_name(id)
	local g = store.realm
	local tile = id and g and g.tiles[id]
	return (tile and tile.name) or ("tile " .. tostring(id))
end

local function commander_by_id(id)
	local view = store.game_view
	if not view or not view.commanders then return nil end
	for i = 1, #view.commanders do
		if view.commanders[i].id == id then return view.commanders[i] end
	end
	return nil
end

--- A complement, in words. "2 Escorts, 1 Bombard".
local function mix_words(mix)
	local view = store.game_view
	local parts = {}
	for k = 1, #((view and view.units) or {}) do
		local spec = view.units[k]
		local n = (type(mix) == "table") and (mix[spec.id] or 0) or 0
		if n > 0 then
			local singular, plural = ui.unit_name(spec, view)
			parts[#parts + 1] = n .. " " .. ui.plural_word(n, singular, plural)
		end
	end
	if #parts == 0 then return "nothing" end
	return table.concat(parts, ", ")
end

--- One staged order, in the words the player thought it in.
--
-- A count on the button is not enough to act on. The batch *replaces* whatever
-- the server is holding, so the thing that has to be right is the list, and the
-- only way to check a list is to read it.
local function describe_order(o)
	local commander = commander_by_id(o.commander)
	local who = (commander and commander.name) or ("Commander " .. tostring(o.commander))
	if o.kind == "move" then
		local dest = o.route and o.route[#o.route]
		if not dest then return who .. " holds position" end
		return string.format("%s to %s", who, tile_name(dest))
	elseif o.kind == "buy" then
		return string.format("Buy %s at %s", mix_words(o.units),
			tile_name(o.at))
	elseif o.kind == "transfer" then
		-- The order carries the *whole* hold the commander should end with, so
		-- the line says the result rather than the movement - "Kess: 2 Escorts"
		-- is what the player chose and what they can check against the map.
		local mix = mix_words(o.units)
		if mix == "nothing" then return who .. " unloads everything" end
		return string.format("%s carries %s", who, mix)
	elseif o.kind == "build" then
		return string.format("%s at %s", tostring(o.label or o.building),
			tile_name(o.at))
	elseif o.kind == "recruit" then
		return "New commander at " .. tile_name(o.at)
	end
	return tostring(o.kind)
end

--- Stage a build or a recruit at a city.
--
-- Keyed on the place rather than the commander: two orders for the same city
-- would race for the same slot, and the RPC supersedes on exactly that.
local function stage_at(self, order)
	for i = 1, #store.orders do
		local o = store.orders[i]
		if o.kind == order.kind and o.at == order.at then
			-- Replacing costs nothing: it is the same decision, changed.
			store.orders[i] = order
			self.sheet_dirty = true
			return
		end
	end
	if not store.plan_has_room(order.kind) then
		self.flash, self.flash_timer = "No orders left this turn", 0
		return
	end
	store.orders[#store.orders + 1] = order
	self.sheet_dirty = true
end

--- Stage a purchase at one of your cities.
--
-- **Keyed on the city, not on a commander.** What is bought goes into the
-- garrison and waits there, so buying needs nobody standing on the spot - and
-- it costs no order at all, which is why there is no allowance check here.
--
-- One order per city, built up a tap at a time: a second order for the same
-- place would race with the first for the same purse.
local function stage_buy(self, at, type_id, delta)
	if not at or not type_id then return end
	for i = 1, #store.orders do
		local o = store.orders[i]
		if o.kind == "buy" and o.at == at then
			o.units[type_id] = math.max(0, (o.units[type_id] or 0) + delta)
			-- An empty basket is not a decision. Dropping it keeps the bar
			-- honest about what will actually be sent.
			if sim_units.count(o.units) == 0 then store.plan_remove(i) end
			self.sheet_dirty = true
			return
		end
	end
	if delta <= 0 then return end
	if not store.plan_has_room("buy") then
		self.flash, self.flash_timer = "No orders left this turn", 0
		return
	end
	local mix = sim_units.empty()
	mix[type_id] = delta
	store.orders[#store.orders + 1] = { kind = "buy", at = at, units = mix }
	self.sheet_dirty = true
end

--- What is already staged to be bought at a city.
local function staged_buy(at)
	for i = 1, #store.orders do
		local o = store.orders[i]
		if o.kind == "buy" and o.at == at then return o.units end
	end
	return nil
end

--- Stage the hold a commander should end the turn with.
--
-- **A target, not a delta** - the same shape the resolver takes, for the same
-- reason: anything else touching either side first would make a delta wrong,
-- and this way the client only ever states the thing the player chose.
--
-- Free, like buying. An order that asks for the hold the commander already has is
-- dropped rather than sent, because it is not a decision.
local function stage_transfer(self, commander_id, hold, current)
	if not commander_id then return end
	local same = true
	for k = 1, #sim_units.CATALOGUE do
		local id = sim_units.CATALOGUE[k].id
		if (hold[id] or 0) ~= ((current and current[id]) or 0) then same = false end
	end
	for i = 1, #store.orders do
		local o = store.orders[i]
		if o.kind == "transfer" and o.commander == commander_id then
			if same then
				store.plan_remove(i)
			else
				o.units = sim_units.normalise(hold)
			end
			self.sheet_dirty = true
			return
		end
	end
	if same then return end
	if not store.plan_has_room("transfer") then
		self.flash, self.flash_timer = "No orders left this turn", 0
		return
	end
	store.orders[#store.orders + 1] = {
		kind = "transfer", commander = commander_id, units = sim_units.normalise(hold),
	}
	self.sheet_dirty = true
end

--- The hold a commander is staged to end the turn with, if anything is staged.
local function staged_hold(commander_id)
	for i = 1, #store.orders do
		local o = store.orders[i]
		if o.kind == "transfer" and o.commander == commander_id then return o.units end
	end
	return nil
end

--- The plan as lines.
local function plan_lines()
	local lines = {}
	for i = 1, #store.orders do
		lines[#lines + 1] = describe_order(store.orders[i])
	end
	return lines
end

--- A row of commander faces under the overview bar.
--
-- Rebuilt only when the roster actually changes - it has its own Druid instance
-- because it is a province that gets rebuilt, and per-component bookkeeping is
-- exactly what leaves stale components pointing at deleted nodes (see the note
-- in main/ui.lua).
local function build_commanders(self, w, h, pad)
	ui.region(self.commander_druid, self.commander_nodes)
	self.commander_druid = nil
	self.commander_nodes = {}

	local view = store.game_view
	-- Nobody is in the field during an *arrival* replay: the strip is today's
	-- roster and the digest is days old, so the faces would describe a map
	-- nobody is looking at. A turn playing out live is the other case - the
	-- roster on screen is the one this turn has just produced - and blanking it
	-- for two seconds is chrome popping in and out for nothing. It also holds
	-- `ceiling_y` still, and a band that moves under a marker is one more way
	-- for a marker to vanish halfway through walking.
	local past = self.pb and not self.pb.live
	local armies = (not past and view and view.commanders) or {}
	self.commander_zone = nil
	self.commander_w, self.commander_h = w, h
	if #armies == 0 then
		self.commander_h = 0
		return
	end

	local previous = ui.collect(self.commander_nodes)
	self.commander_druid = druid.new(self)

	local top = h - pad.top - TOP_H - ui.GAP
	local x = pad.left + 14
	for i = 1, #armies do
		local f = armies[i]
		local moving = (f.eta or 0) > 0
		local chosen = store.selected_commander == f.id
		local node = ui.portrait(x, top, COMMANDER_SIZE, f.portrait, {
			ring_colour = chosen and ui.ACCENT or (moving and ui.GOOD or ui.BORDER),
		})
		-- The strength on the face, because "which of mine is strong enough for
		-- that" is the question this row exists to answer. A badge rather than a
		-- second line of text: the strip is already only 76 units tall, and the
		-- number has to survive being read at a glance on a phone.
		--
		-- It goes amber under a third, which is the one state that needs acting
		-- on - a commander that has to go home before it can take anything else.
		local badge_w, badge_h = 36, 22
		local bx = x + COMMANDER_SIZE - badge_w
		local by = top - COMMANDER_SIZE + badge_h
		local carried = f.carried or 0
		local spent = carried * 3 <= (f.max_units or 1)
		ui.pill(bx, by, badge_w, badge_h, ui.BG)
		ui.small(bx + badge_w * 0.5, by - badge_h * 0.5, tostring(carried),
			spent and ui.WARN or ui.TEXT,
			{ bold = true, pivot = gui.PIVOT_CENTER })
		ui.small(x + COMMANDER_SIZE * 0.5, top - COMMANDER_SIZE - 8,
			-- Turns, because that is the question: not how far, but when.
			moving and (f.eta == 1 and "next turn" or (f.eta .. " turns")) or "here",
			chosen and ui.ACCENT or ui.FAINT, { pivot = gui.PIVOT_CENTER })
		self.commander_druid:new_button(node, function()
			-- Selecting a commander *is* the intent to order one - the bar's own
			-- hint says "tap a commander to give them orders" - so this starts
			-- the aim rather than only pointing the camera at them. The sheet
			-- stands down while aiming, which is what hands the map over for
			-- the tap being asked for.
			--
			-- **The same face is the way out.** Aiming takes the whole map, and
			-- a mode you can only leave by finishing it or by finding CANCEL in
			-- the bar is a mode that catches people; the control that started it
			-- is the one a thumb is already on.
			if store.aiming and store.aiming.commander == f.id then
				store.aiming = nil
				store.selected_commander = nil
				self.sheet_dirty = true
				return
			end
			store.selected_commander = f.id
			store.selected = f.at
			store.aiming = { kind = "move", commander = f.id }
			-- Consume this selection change here. `resolve_aim` fires whenever
			-- the selection moves with an aim active, so setting both in one
			-- callback would resolve the order instantly against the tile the
			-- commander is already standing on - a route from a place to itself,
			-- which the server rightly refuses.
			self.last_selected = f.at
			self.sheet_dirty = true
			-- Where the force actually is, part way along its tile if it is
			-- under way, so the camera lands on the marker and not behind it.
			local g = store.realm
			local a = g and g.tiles[f.at]
			if not a then return end
			msg.post("camera#camera_script", "focus", { x = a.x, y = a.y })
		end)
		x = x + COMMANDER_SIZE + COMMANDER_GAP
	end
	ui.collect(previous)

	self.commander_h = COMMANDER_H
	self.commander_zone = { pad.left, top - COMMANDER_H, x, top }
	publish_zones(self)
end

--- The order bar: what is about to be sent, cancel an aim, or send it.
local function build_bar(self, w, pad, submit)
	local y = pad.bottom + BAR_H
	local width = w - pad.left - pad.right
	local card, border = ui.card(pad.left, y, width, BAR_H)

	local inner = 24
	self.status = ui.small(pad.left + inner, y - 26, "", ui.DIM,
		{ width = width - inner * 2, anchor_top = true })

	-- Created once at full capacity and then repositioned, rather than rebuilt
	-- whenever the plan changes. The plan changes on every tap, and running the
	-- whole bar through Druid that often is how the deleted-node traps in
	-- ui.lua get sprung.
	self.manifest = {}
	self.manifest_drop = {}
	for i = 1, MANIFEST_LINES + 1 do
		local node = ui.small(pad.left + inner + 10, y, "", ui.TEXT,
			-- Room kept on the right for the button that removes it.
			{ width = width - inner * 2 - 10 - 56 })
		gui.set_enabled(node, false)
		self.manifest[i] = node
	end
	-- **Taking an order back is as much a decision as making one**, now that a
	-- turn only holds a few. Created once and repositioned like the lines
	-- themselves, because the plan changes on every tap and running the bar
	-- through Druid that often is how the deleted-node traps in ui.lua get
	-- sprung.
	--
	-- Slot i removes order i: the list is the plan in order, and it is short
	-- enough that all of it fits.
	for i = 1, MANIFEST_LINES do
		local size = 44
		local handle = ui.icon_button(self.druid,
			w - pad.right - inner - size, y, size, "icon_close",
			function()
				if store.plan_remove(i) then
					self.manifest_key = nil
					self.sheet_dirty = true
				end
			end, { background = ui.CLEAR, colour = ui.FAINT })
		gui.set_enabled(handle.fill, false)
		gui.set_enabled(handle.glyph, false)
		self.manifest_drop[i] = handle
	end

	local row_y = y - 52
	local bh = ui.CONTROL
	local right = w - pad.right - inner

	-- CANCEL only exists while something is being aimed, so SEND keeps the far
	-- right where a thumb expects it either way.
	local send_w = 300
	self.cancel = ui.button(self.druid, right - send_w - 182, row_y, 168, bh,
		"CANCEL", function()
			store.aiming = nil
			store.selected_commander = nil
			self.sheet_dirty = true
		end, { size = ui.CAPS })

	self.send = ui.button(self.druid, right - send_w, row_y, send_w, bh, "SEND",
		function() submit(self) end, { style = "primary", size = ui.CAPS })

	self.bar = {
		card = card, border = border, width = width,
		x = pad.left, base_top = y, inner = inner, lines = -1,
	}
	self.bar_zone = { pad.left, y - BAR_H, w - pad.right, y }
	-- Deliberately the *base* height, not the grown one: the camera derives the
	-- zoom floor and the framed centre from this, so letting it move whenever an
	-- order is staged would shift the map under the player - the same trap the
	-- ten-second poll used to spring on the zoom.
	store.hud_bar_height = pad.bottom + BAR_H
end

--- Grow the bar upward to fit `lines` of manifest.
--
-- The control row never moves: it is anchored the same distance above the
-- bottom whatever the card does, which is what lets SEND be somewhere a thumb
-- can find without looking. The list grows upward *into* the new space, so the
-- last line always sits the same distance above the row and only the top of the
-- card and the status line above it actually travel.
--- @param lines manifest rows, or -1 for "no status line either"
local function layout_bar(self, lines)
	local b = self.bar
	if not b or b.lines == lines then return end
	b.lines = lines

	-- With nothing staged and nothing to say, the status line is a blank row
	-- above a dead button. Giving it back to the map is worth more than keeping
	-- the bar a constant height.
	local extra = (lines < 0) and -STATUS_ROW_H or (lines * MANIFEST_LINE_H)
	local top = b.base_top + extra
	local height = BAR_H + extra

	for _, node in ipairs({ b.card, b.border }) do
		gui.set_position(node, vmath.vector3(b.x, top, 0))
		gui.set_size(node, vmath.vector3(b.width, height, 0))
	end
	gui.set_enabled(self.status, lines >= 0)
	gui.set_position(self.status,
		vmath.vector3(b.x + b.inner, top - 26, 0))
	for i = 1, #self.manifest do
		gui.set_position(self.manifest[i], vmath.vector3(b.x + b.inner + 10,
			top - MANIFEST_TOP - (i - 1) * MANIFEST_LINE_H, 0))
	end
	for i = 1, #(self.manifest_drop or {}) do
		local drop = self.manifest_drop[i]
		local line_y = top - MANIFEST_TOP - (i - 1) * MANIFEST_LINE_H
		-- Centred on its line: a manifest line's y is its middle (PIVOT_W) and
		-- the button's is its top edge.
		local at = vmath.vector3(b.x + b.width - b.inner - 44, line_y + 22, 0)
		gui.set_position(drop.fill, at)
		gui.set_position(drop.glyph,
			vmath.vector3(at.x + 12, at.y - 12, 0))
	end

	self.bar_zone[4] = top
	publish_zones(self)
	-- The sheet stacks on top of the bar, so it has to move with it. It is
	-- rebuilt rather than nudged because its own height depends on what is
	-- selected, and this only happens when the line count actually changes.
	self.sheet_dirty = true
end

--- How far the manifest has pushed the top of the bar up.
local function bar_extra(self)
	return (self.bar and self.bar.lines or 0) * MANIFEST_LINE_H
end

-- The tile sheet -----------------------------------------------------------------

--- What the player knows about a tile, or nil if they have never seen it.
local function known(id)
	local view = store.game_view
	if not view then return nil end
	return view.tiles[tostring(id)]
end

--- One slot: the ground, the glyph, and the ring on top.
--
-- Three nodes rather than one, because what carries the state is the *ring*. A
-- unit standing here and one merely staged to be bought are the same glyph, and
-- tinting the art to tell them apart is the one thing `ui.emoji` will not do -
-- it is Noto's drawing, not a shape, and the map holds to the same rule.
local function draw_slot(x, y, type_id, opts)
	opts = opts or {}
	ui.dot(x, y, SLOT, opts.fill or ui.CARD_ALT)
	if type_id then
		local inset = SLOT * 0.17
		ui.emoji(x + inset, y - inset, SLOT - inset * 2, ui.unit_image(type_id))
	elseif opts.plus then
		ui.icon(x + SLOT * 0.5 - 16, y - SLOT * 0.5 + 16, 32, "icon_plus", ui.FAINT)
	end
	ui.ring(x, y, SLOT, opts.ring or ui.BORDER)
end

--- What a rack holds, in catalogue order: what is really there, then what is
--- only staged.
--
-- Ordered rather than keyed, because a slot is a *place* - the rack has to be
-- able to say "this one is not here yet" about one particular circle. Catalogue
-- order rather than `pairs`, for the reason everything in this project is:
-- iteration order is unspecified and this one is visible.
local function rack_items(now, ends)
	local items = {}
	for k = 1, #sim_units.CATALOGUE do
		local id = sim_units.CATALOGUE[k].id
		local have, after = now[id] or 0, ends[id] or 0
		for _ = 1, math.min(have, after) do
			items[#items + 1] = { type = id }
		end
		for _ = 1, after - have do
			items[#items + 1] = { type = id, staged = true }
		end
	end
	return items
end

--- Draw a rack, and record the rectangles that make it touchable.
--
-- It draws whichever is larger of `capacity` and what it holds, so an over-full
-- hold is never hidden behind its own cap, and wraps at six because past that
-- the slots would have to shrink below a thumb.
--
-- **Rectangles, not nodes.** The sheet is rebuilt on every staged change, so a
-- gesture that had kept hold of a node would be holding a deleted one by the
-- time it ended; `on_input` hit-tests geometry instead. They are recorded in
-- layout space here and shifted with everything else at the end.
local function draw_rack(x, y, items, capacity, row, plus, rects)
	local count = math.max(capacity, #items)
	local lines = math.max(1, math.ceil(count / SLOTS_PER_ROW))
	for i = 1, count do
		local col = (i - 1) % SLOTS_PER_ROW
		local line = math.floor((i - 1) / SLOTS_PER_ROW)
		local sx = x + col * (SLOT + SLOT_GAP)
		local sy = y - line * (SLOT + SLOT_GAP)
		local item = items[i]
		draw_slot(sx, sy, item and item.type, {
			ring = item and item.staged and ui.ACCENT or nil,
			fill = item and item.staged and ui.ACCENT_SOFT or nil,
			plus = (not item) and plus or nil,
		})
		rects[#rects + 1] = {
			sx, sy - SLOT, sx + SLOT, sy,
			row = row,
			type = item and item.type or nil,
			buy = (not item) and plus or nil,
		}
	end
	return y - lines * SLOT - (lines - 1) * SLOT_GAP
end

--- Rebuild the panel describing whatever is selected. Returns its height.
--
-- Laid out downward from zero and shifted into place at the end, because the
-- height is not known until the content is on the page.
--
-- **A rack of slots, not a document.** It used to be read top to bottom - a
-- name, a province, a commander, a sentence of capture arithmetic, a shipyard of
-- labelled rows with steppers, a button through to a second screen, and four
-- upgrade boxes at the very bottom, past 900 units of card with no scroll behind
-- it. That is a page, and a page on the bottom half of a map is a page nobody
-- reads. Everything that was a *sentence* has gone. What is left is rows of
-- places: what this world can be built into, what is standing on it, and what
-- is leaving with the commander.
--
-- The order is the order the decisions happen in, which is why upgrades moved
-- from last to first: dwellings decide what there is to buy at all, so a city
-- with none has an empty shipyard for a reason the card can now see. You buy
-- into the garrison, so that comes next; you load out of the garrison, so the
-- hold sits directly under what fills it. A tile that is not yours is a dot, a
-- name and a way out.
--
-- **What this gives up** is the two comparisons - "you need 16 against its
-- defences, you bring only 6" - which were the one piece of arithmetic a player
-- did before committing a commander to a turn that resolves twelve hours later.
-- They are shown nowhere else in the client now. If they come back, the place
-- for them is the aim flow in the order bar, where that decision is actually
-- being made, rather than on a card about somewhere you are standing.
local function build_sheet(self, w, pad)
	-- Its own Druid instance, dropped wholesale. Tracking each component by
	-- hand is what broke before: helpers register components the caller never
	-- sees, and one that outlives its node throws on the next touch anywhere.
	ui.region(self.sheet_druid, self.sheet_nodes)
	self.sheet_druid = nil
	self.sheet_zone = nil
	self.slot_rects = nil

	local id = store.selected
	local g = store.realm
	if not id or not g or not g.tiles[id] then return 0 end

	-- Aiming hands the screen to the map. The sheet asked the player to "tap
	-- where to send" while covering nearly half the destinations, which is the
	-- one moment it must not be in the way; the order bar carries the commander
	-- and the origin instead.
	if store.aiming then return 0 end
	-- And a replay has the bottom of the screen, and describes a past the sheet
	-- would be reporting today's numbers over.
	if self.pb then return 0 end

	self.sheet_druid = druid.new(self)

	local previous = ui.collect(self.sheet_nodes)
	local view = store.game_view
	local info = known(id)
	local tile = g.tiles[id]
	local you = view and view.you
	local mine = (view and info and info.owner == you) and true or false

	local width = w - pad.left - pad.right
	local inner = pad.left + 24
	local text_w = width - 48
	local rects = {}

	-- The card first, so everything else lands on top of it in node order. Its
	-- height is fixed up once the content below is measured.
	local card = ui.panel(pad.left, 0, width, SHEET_MIN, ui.CARD)
	local edge = ui.panel_line(pad.left, 0, width, SHEET_MIN, ui.BORDER)

	-- **Whose it is, before what it is.** A colour dot on the name row is the
	-- same mark the map draws round the tile, so the two are read the same
	-- way and the card needs no sentence for the common case.
	--
	-- The province line and "Held by X" went with the rest of the prose. Colour
	-- already says whose it is, and what kind of place it is is told by what the
	-- card offers underneath - a shipyard is a city.
	local DOT = 22
	local CLOSE = 64
	local y = -34
	local owner_colour = ui.FAINT
	if info and (info.owner or 0) ~= 0 then
		owner_colour = player_colour(info.owner)
	end
	ui.dot(inner, y + DOT * 0.5, DOT, owner_colour)
	ui.h2(inner + DOT + 16, y, tile.name)

	-- **A way out.** There had never been one: the card publishes its own
	-- rectangle into `store.hud_zones`, and gestures.lua latches `blocked` on
	-- any touch starting inside one - so a tap on the sheet never reached
	-- `pick_tile` and could not deselect. The only dismiss gesture in the game
	-- was a tap on bare map above the card.
	ui.icon_button(self.sheet_druid, inner + text_w - CLOSE, y + CLOSE * 0.5,
		CLOSE, "icon_close", function()
			store.selected = nil
			-- Cleared alongside, the way CANCEL does it: a selected commander
			-- with no selected tile is a state nothing else in the HUD reads.
			store.selected_commander = nil
			self.sheet_dirty = true
		end, { background = ui.CARD_ALT, colour = ui.DIM })

	-- **"SEAT", not "Your seat".** Whose it is, the dot has already said.
	if info and (info.seat_of or 0) ~= 0 then
		local own = info.seat_of == you
		local tone = own and ui.ACCENT or ui.BAD
		local label_w = ui.text_width("SEAT", ui.CAPS) + 28
		local lx = inner + text_w - CLOSE - 16 - label_w
		ui.pill(lx, y + 15, label_w, 30, own and ui.ACCENT_SOFT or ui.CARD_ALT)
		ui.caps(lx + 14, y, "SEAT", tone)
	end

	-- Which commander every slot on this card refers to - the garrison's as much
	-- as the hold's, since a unit dragged out of the garrison has to be dragged
	-- into somebody. Declared out here so the shift loop below can stamp it onto
	-- the rectangles once, rather than each rack carrying its own copy.
	local commander_id = nil

	if mine and view then
		local rates = view.rates or {}
		local built = info.buildings or {}

		-- **What this city can be made into, as four boxes - and it comes
		-- first now.** It was the last thing on the card, under everything a
		-- player might buy, which had it backwards: nothing is bought here until
		-- something is built here.
		--
		-- An empty box asks (`+`); a full one answers, and is the way to
		-- whatever that building lets you do. Both open a popup rather than
		-- growing the card, because choosing between five things deserves the
		-- screen and the card has other work to do.
		if sim_tiles.is_city(g, id) then
			local slots = rates.building_slots or 4

			-- A build staged this turn occupies the next empty slot: it is not
			-- there yet, but the player has spent an order on it and the box is
			-- where they will look to see that they did.
			local staged_build = nil
			for i = 1, #store.orders do
				local o = store.orders[i]
				if o.kind == "build" and o.at == id then staged_build = o end
			end

			y = y - 46
			ui.caps(inner, y, "upgrades")

			local gap = 16
			local box_w = (text_w - gap * (slots - 1)) / slots
			local box_h = 104
			y = y - (box_h + 14)
			for slot = 1, slots do
				local bx = inner + (box_w + gap) * (slot - 1)
				local have = built[slot]
				local pending = (not have) and (slot == #built + 1) and staged_build

				local spec
				for k = 1, #(view.buildings or {}) do
					local b = view.buildings[k]
					if b.id == (have or (pending and pending.building)) then spec = b end
				end

				local fill, tone
				if have then fill, tone = ui.CARD_ALT, ui.TEXT
				elseif pending then fill, tone = ui.ACCENT_SOFT, ui.ACCENT
				else fill, tone = ui.CARD, ui.FAINT end
				local box = ui.panel(bx, y + box_h, box_w, box_h, fill)
				if not have then ui.panel_line(bx, y + box_h, box_w, box_h, ui.BORDER) end

				if have or pending then
					ui.icon(bx + box_w * 0.5 - 15, y + box_h - 20, 30,
						BUILDING_ICON[spec and spec.id] or "icon_tile", tone)
					ui.small(bx + box_w * 0.5, y + 34,
						(spec and ui.building_name(spec)) or tostring(have), tone,
						{ pivot = gui.PIVOT_CENTER })
					-- **"tap to use" only where there is something to do.** Yards,
					-- Works and a Bastion work by standing there; promising a
					-- verb and then opening a card that says there isn't one is
					-- how an interface loses its word.
					ui.small(bx + box_w * 0.5, y + 14,
						pending and "staged"
							or (BUILDING_VERB[have] and "tap to use" or "built"),
						ui.FAINT, { pivot = gui.PIVOT_CENTER })
				else
					ui.icon(bx + box_w * 0.5 - 17, y + box_h - 30, 34,
						"icon_plus", ui.DIM)
					ui.small(bx + box_w * 0.5, y + 22, "empty slot", ui.FAINT,
						{ pivot = gui.PIVOT_CENTER })
				end

				-- A staged box is not a control: the order is in the bar, where
				-- it can be taken back, and a second popup over it would offer
				-- to build on a slot that is already spoken for.
				if not pending then
					self.sheet_druid:new_button(box, function()
						store.slot_popup = {
							at = id,
							building = have,
							slot = slot,
						}
					end)
				end
			end
		end

		-- **Two racks, and the whole city loop between them.** The shipyard is
		-- what you have bought and left standing here; the commander's is what
		-- leaves with them. A unit is dragged from one to the other, or tapped
		-- to send it across, and an empty shipyard slot is where buying starts.
		--
		-- Both racks show **what will be there when the turn resolves**, with an
		-- accent ring on anything that is not there yet - the same vocabulary as
		-- a staged order in the bar. Nothing here is a delta the player has to
		-- add up.
		--
		-- Neither is city-only. `resolve.transfers` checks that a commander is
		-- standing on ground its owner holds and nothing else, so a holding
		-- with units left on it is a real place with a real garrison and the
		-- card says so. Only *buying* needs dwellings.
		local garrison = sim_units.normalise(info.garrison)
		local basket = staged_buy(id)

		local here = {}
		for i = 1, #(view.commanders or {}) do
			local c = view.commanders[i]
			if c.at == id and (c.eta or 0) == 0 then here[#here + 1] = c end
		end
		-- Whichever one the strip has selected, so tapping a face and then a
		-- world lines the two up; `here[1]` when the selection is elsewhere.
		local aboard = nil
		for k = 1, #here do
			if here[k].id == store.selected_commander then aboard = here[k] end
		end
		aboard = aboard or here[1]
		commander_id = aboard and aboard.id or nil

		local hold_now = aboard and sim_units.normalise(aboard.hold) or nil
		local hold_ends = aboard
			and sim_units.normalise(staged_hold(aboard.id) or aboard.hold) or nil

		-- What the garrison ends the turn holding: what is there, plus what was
		-- bought, minus whatever the commander is staged to take.
		local garrison_ends = sim_units.empty()
		for k = 1, #sim_units.CATALOGUE do
			local uid = sim_units.CATALOGUE[k].id
			local taken = hold_now and ((hold_ends[uid] or 0) - (hold_now[uid] or 0)) or 0
			local left = (garrison[uid] or 0) + ((basket and basket[uid]) or 0) - taken
			garrison_ends[uid] = left > 0 and left or 0
		end

		-- **Only the types this world has a dwelling for.** The mapping is on
		-- the wire - every building declares what it makes - so this is a fact
		-- about *this place* rather than a reprint of the catalogue, and it is
		-- what decides whether an empty slot offers to buy anything at all.
		local makes = 0
		for k = 1, #(view.units or {}) do
			local spec = view.units[k]
			for b = 1, #built do
				for c = 1, #(view.buildings or {}) do
					local shape = view.buildings[c]
					if shape.id == built[b] and shape.makes == spec.id then
						makes = makes + 1
					end
				end
			end
		end

		local garrison_cap = rates.garrison_cap or 6
		if makes > 0 or sim_units.count(garrison_ends) > 0 then
			y = y - 46
			ui.caps(inner, y, "shipyard")
			y = y - (SLOT + 14)
			y = draw_rack(inner, y + SLOT,
				rack_items(garrison, garrison_ends), garrison_cap,
				"garrison", makes > 0, rects)
		end

		if aboard then
			y = y - 46
			ui.caps(inner, y, "commander")
			-- The face on the caption line rather than in the leading slot. The
			-- mock-up put it there and it only works while capacity is exactly
			-- six: it is `commander_units + level - 1`, so a veteran needs nine or
			-- ten cells and a face in the grid spills the rack onto a second row
			-- for nothing.
			ui.portrait(inner + 116, y + 17, 34, aboard.portrait,
				{ ring_colour = ui.BORDER })
			ui.small(inner + 160, y, aboard.name, ui.DIM)
			y = y - (SLOT + 14)
			y = draw_rack(inner, y + SLOT,
				rack_items(hold_now, hold_ends), aboard.max_units or 0,
				"hold", false, rects)
		end
	end

	y = y - 24

	local height = math.max(SHEET_MIN, math.min(SHEET_MAX, -y))
	gui.set_size(card, vmath.vector3(width, height, 0))
	gui.set_size(edge, vmath.vector3(width, height, 0))

	-- Docked to the bar rather than floating above it. Two cards with a gap
	-- between them read as clutter and cost the map a strip of screen for a
	-- seam that carried no meaning.
	local top = pad.bottom + BAR_H + bar_extra(self) + height
	for i = 1, #self.sheet_nodes do
		local node = self.sheet_nodes[i]
		local p = gui.get_position(node)
		gui.set_position(node, vmath.vector3(p.x, p.y + top, 0))
	end
	-- The slot rectangles were recorded in the same layout space, so they move
	-- with it. Doing this here rather than at the call site is what keeps the
	-- two descriptions of where a slot is from ever disagreeing.
	for i = 1, #rects do
		local r = rects[i]
		r[2] = r[2] + top
		r[4] = r[4] + top
		r.at = id
		r.commander = commander_id
	end

	ui.collect(previous)
	self.slot_rects = rects
	self.sheet_zone = { pad.left, top - height, w - pad.right, top }
	return height
end

--- Where a touch is, whichever stream it arrived on.
--
-- The same split main/camera.script makes: on a device the multi-touch binding
-- carries `action.touch` and the per-finger flags live on the entry; on a
-- desktop the press and release carry the bound action id and movement arrives
-- with `action_id == nil` and the flags on the action itself.
local function sheet_point(action)
	if action.touch and action.touch[1] then
		local t = action.touch[1]
		return t.x, t.y, t.pressed, t.released
	end
	return action.x, action.y, action.pressed, action.released
end

--- Which slot a point is in, if any.
local function slot_at(self, x, y)
	local rects = self.slot_rects
	if not rects or not x or not y then return nil end
	for i = 1, #rects do
		local r = rects[i]
		if x >= r[1] and x <= r[3] and y >= r[2] and y <= r[4] then return r end
	end
	return nil
end

--- Which rack a point is over, whether or not it landed on a circle.
--
-- Generous about the gaps on purpose: a finger that comes down between two
-- slots has still said which row it meant, and a drop that refused it would
-- read as broken rather than as precise.
local function rack_at(self, x, y)
	local rects = self.slot_rects
	if not rects or not x or not y then return nil end
	for i = 1, #rects do
		local r = rects[i]
		if y >= r[2] and y <= r[4] then return r.row end
	end
	return nil
end

--- Move one unit between a city's garrison and the commander standing on it.
--
-- Both directions go through `stage_transfer`, which takes the hold the commander
-- should **end the turn with** rather than a delta - so this reads whatever is
-- already staged, changes it by one, and states the whole thing again. A delta
-- would be wrong the moment anything else touched either side first.
local function shift_unit(self, at, commander_id, type_id, dir)
	local view = store.game_view
	if not view or not at or not commander_id or not type_id then return end
	local commander = commander_by_id(commander_id)
	local info = view.tiles[tostring(at)]
	if not commander or not info then return end

	local now = sim_units.normalise(commander.hold)
	local target = sim_units.normalise(staged_hold(commander_id) or commander.hold)
	local want = (target[type_id] or 0) + dir
	if want < 0 then return end

	if dir > 0 then
		-- There has to be one standing here to take - counting anything staged
		-- to be bought this turn, because buys settle before transfers do
		-- (realm/sim/resolve.lua), so a unit bought this turn can leave with
		-- the commander this turn.
		local basket = staged_buy(at)
		local garrison = sim_units.normalise(info.garrison)
		local spare = (garrison[type_id] or 0)
			+ ((basket and basket[type_id]) or 0)
			- ((target[type_id] or 0) - (now[type_id] or 0))
		if spare < 1 then return end
		if sim_units.count(target) + 1 > (commander.max_units or 0) then
			self.flash, self.flash_timer = "The hold is full", 0
			return
		end
	end

	target[type_id] = want
	stage_transfer(self, commander_id, target, now)
end

local function drop_ghost(self)
	if self.drag_ghost then gui.delete_node(self.drag_ghost) end
	self.drag_ghost = nil
	self.drag = nil
end

--- Pick a unit up, and put it down: the sheet's one gesture.
--
-- Hand-rolled rather than a Druid drag component, for the reason
-- `ui.install_druid_picking` exists at all - Druid resolves positions against
-- Defold's *configured* display and this project lays out in a view space of
-- its own. Every slot rectangle is known, so an axis-aligned test against them
-- is exact; and the sheet is a province that gets rebuilt on every staged change,
-- which a component holding a node would not survive.
--
-- **A tap is the fast path, a drag is the deliberate one.** Tapping a filled
-- slot sends that unit to the other rack, tapping an empty shipyard slot opens
-- the buy popup, and dragging says where it lands. Filling a hold is six taps,
-- which is what stands in for the transfer screen's TAKE ALL.
--
-- Returning true takes the touch away from the Druid instances underneath, and
-- it has to: a gesture starting on a slot must pre-empt the upgrade boxes, and
-- once one is under way the release belongs to it too.
local function sheet_gesture(self, action)
	if not self.slot_rects then
		if self.drag then drop_ghost(self) end
		return false
	end
	local x, y, pressed, released = sheet_point(action)
	if not x or not y then return false end

	if not self.drag then
		if not pressed then return false end
		local rect = slot_at(self, x, y)
		if not rect then return false end
		if rect.type and rect.commander then
			self.drag = { from = rect, x0 = x, y0 = y }
			-- Not collected by ui.collect, deliberately: a sheet rebuilt while
			-- the finger is still down would delete the thing under it.
			-- Created last, so it draws over everything.
			self.drag_ghost = ui.emoji(x - GHOST * 0.5, y + GHOST * 0.5,
				GHOST, ui.unit_image(rect.type), 0.9)
			return true
		end
		if rect.buy then store.buy_popup = { at = rect.at } end
		-- Even a slot with nothing to offer keeps the touch. It is inside the
		-- card, and a touch that falls through to the map from the middle of a
		-- panel is the bug store.hud_zones exists to prevent.
		return true
	end

	if released then
		local from = self.drag.from
		local slop = math.abs(x - self.drag.x0) + math.abs(y - self.drag.y0)
		drop_ghost(self)
		local other = from.row == "garrison" and "hold" or "garrison"
		local onto = slop <= TAP_SLOP and other or rack_at(self, x, y)
		if onto == other then
			shift_unit(self, from.at, from.commander, from.type,
				from.row == "garrison" and 1 or -1)
		end
		return true
	end

	gui.set_position(self.drag_ghost,
		vmath.vector3(x - GHOST * 0.5, y + GHOST * 0.5, 0))
	return true
end

--- The transport: play, speed, scrub, and the way out.
--
-- Its own Druid instance because it is a province that gets rebuilt - the caption
-- and the progress change every step, and per-component bookkeeping is exactly
-- what leaves stale components pointing at deleted nodes (see main/ui.lua).
local function build_playback_bar(self, w, h, pad)
	ui.region(self.pb_druid, self.pb_nodes)
	self.pb_druid, self.pb_nodes, self.pb_zone = nil, {}, nil
	local p = self.pb
	if not p then return end

	local previous = ui.collect(self.pb_nodes)
	self.pb_druid = druid.new(self)

	local width = w - pad.left - pad.right
	local top = pad.bottom + PLAYBACK_H
	-- Opaque, and built after the order bar, so it covers it rather than
	-- needing the bar to be taken apart and put back.
	ui.panel(pad.left, top, width, PLAYBACK_H, ui.CARD)
	ui.panel_line(pad.left, top, width, PLAYBACK_H, ui.BORDER)

	local step = p.steps[p.index]
	local first, last = p.steps[1].turn, p.steps[#p.steps].turn
	local inner = pad.left + 22

	ui.caps(inner, top - 24, "turn " .. tostring(step.turn))
	ui.small(w - pad.right - 22, top - 24,
		string.format("%d of %d", p.index, #p.steps), ui.FAINT,
		{ pivot = gui.PIVOT_E })

	local g = store.realm
	local view = store.game_view
	local function name_of(i)
		local who = view and view.players and view.players[i]
		return (who and who.name) or ("Player " .. tostring(i))
	end
	local function place_of(id)
		local tile = id and g and g.tiles[id]
		return (tile and tile.name) or "deep space"
	end
	ui.body(inner, top - 52, step_caption(step, p.you, name_of, place_of),
		step.quiet and ui.FAINT or ui.TEXT,
		{ width = width - 44, anchor_top = true })

	-- A scrubbable line rather than a progress bar: the point of a replay is
	-- being able to go back to the turn something happened on, and forty turns
	-- across a phone is a comfortable target.
	-- `ui.bar`, not `ui.panel` or `ui.pill`: at twelve units tall both of those
	-- 9-slices draw a lens rather than a bar. See the note on M.bar.
	local track_h = 12
	local track_w = width - 44
	local track_y = top - 106
	-- Against the card rather than on it: CARD_ALT on CARD is a few percent and
	-- at twelve units reads as nothing at all. A groove is darker than what it
	-- is cut into.
	ui.bar(inner, track_y, track_w, track_h, ui.BG)

	local fraction = (#p.steps > 1) and ((p.index - 1) / (#p.steps - 1)) or 1
	local filled = math.max(track_h, track_w * fraction)
	ui.bar(inner, track_y, filled, track_h, ui.ACCENT)
	-- Where the playback has got to, and the thing that says the track can be
	-- dragged at all.
	ui.dot(inner + filled - track_h * 0.5, track_y - 2, track_h + 4, ui.ACCENT)

	-- Every turn that had a fight gets a tick above the track, so a player can
	-- aim at one rather than scrubbing until they find it.
	for i = 1, #p.steps do
		if #p.steps[i].battles > 0 then
			local at = (#p.steps > 1) and ((i - 1) / (#p.steps - 1)) or 0
			ui.dot(inner + track_w * at - 3, track_y + 12, 7, ui.WARN)
		end
	end

	-- A hit area far taller than the line it scrubs: twelve units is seven dp,
	-- and the tap target floor is forty-eight.
	-- **Druid hands a click callback `(context, params, button)` and no touch
	-- position**, so the scrubber has to remember where the finger was itself -
	-- `on_input` keeps the last one. Reading a position off the third argument
	-- gets the button component instead, silently, and the track does nothing.
	local grab = ui.panel(inner - 10, track_y + 22, track_w + 20, 56, ui.CLEAR)
	self.pb_druid:new_button(grab, function()
		local x = self.touch_x
		if not x then return end
		local at = (x - inner) / math.max(1, track_w)
		playback_seek(self, math.floor(at * (#p.steps - 1) + 1.5))
	end)

	-- The control row leaves the same clearance below it that the order bar's
	-- does. It was six units, against the bar's sixteen, and on a phone that
	-- reads as the replay controls being jammed against the bottom of the
	-- screen while everything else is not - which is exactly what a safe area
	-- is for even when the device reports no inset at all.
	local row_y = top - 132
	local size = ui.CONTROL
	local play = ui.icon_button(self.pb_druid, inner, row_y, size,
		p.playing and "icon_pause" or "icon_play",
		function()
			p.playing = not p.playing
			self.pb_layout = nil
		end, { background = ui.CARD_ALT, colour = ui.TEXT })
	self.pb_speed = ui.button(self.pb_druid, inner + size + 12, row_y, 96, size,
		tostring(p.speed) .. "x",
		function()
			for i = 1, #PLAYBACK_SPEEDS do
				if PLAYBACK_SPEEDS[i] == p.speed then
					p.speed = PLAYBACK_SPEEDS[(i % #PLAYBACK_SPEEDS) + 1]
					break
				end
			end
			self.pb_layout = nil
		end, { size = ui.CAPS })

	-- **A fight of yours on this turn opens its own screen.** The amber ticks
	-- on the track were already pointing at these; a separate control elsewhere
	-- would be a second way of saying the same thing. Somebody else's battle is
	-- a line in the digest and nothing more - you were not there to count their
	-- exchanges.
	local mine_here = nil
	for i = 1, #step.battles do
		if step.battles[i].player == p.you and step.battles[i].exchanges then
			mine_here = step.battles[i]
		end
	end
	local done_w = 150
	ui.button(self.pb_druid, w - pad.right - 22 - done_w, row_y, done_w, size,
		p.index >= #p.steps and "DONE" or "SKIP",
		function() playback_stop(self) end,
		{ style = p.index >= #p.steps and "primary" or "secondary", size = ui.CAPS })

	local log_w = 120
	local log_x = w - pad.right - 34 - done_w - log_w
	ui.button(self.pb_druid, log_x, row_y, log_w, size, "LOG",
		function()
			local digest = p.digest
			playback_stop(self)
			if digest then monarch.show(hash("report"), nil, digest) end
		end, { size = ui.CAPS })

	-- Whatever is left between the speed control and LOG. A fixed 220 ran under
	-- LOG and the caption came out as "SEE THE FIG", which is the sort of thing
	-- that reads as a broken build rather than a tight layout.
	if mine_here then
		local fight_x = inner + size + 12 + 96 + 12
		local fight_w = log_x - 12 - fight_x
		if fight_w >= 120 then
			ui.button(self.pb_druid, fight_x, row_y, fight_w, size,
				fight_w >= 210 and "SEE THE FIGHT" or "BATTLE",
				function()
					p.playing = false
					monarch.show(hash("battle"), nil,
						{ battle = mine_here, you = p.you })
				end, { size = ui.CAPS })
		end
	end

	ui.collect(previous)
	self.pb_zone = { pad.left, top - PLAYBACK_H, w - pad.right, top }
	self.pb_first, self.pb_last = first, last
	publish_zones(self)
	return play
end

--- Advance the replay. Returns true while it is still running.
local function playback_update(self, dt)
	local p = self.pb
	if not p then return false end
	if p.playing then
		p.elapsed = p.elapsed + dt * p.speed
		local held = playback.duration(p.steps[p.index], PLAYBACK_BASE)
		if p.elapsed >= held then
			if p.index >= #p.steps then
				-- **Held at the end, not rewound to the start.** `elapsed` used
				-- to be zeroed here as well, and since the index does not
				-- advance, `update_commanders` recomputed the step from the
				-- beginning: every marker snapped back to the tile it set out
				-- from and froze there until DONE was tapped. Clamping leaves
				-- the walk finished, which is where the officers actually are.
				p.elapsed = held
				-- Stop on the last turn rather than closing: the player has
				-- just been shown something and may want to scrub back through
				-- it. DONE is how they leave.
				p.playing = false
				self.pb_layout = nil
			else
				p.elapsed = 0
				p.index = p.index + 1
				playback_publish(self)
				self.label_dirty = true
				self.pb_layout = nil
				-- Each turn names itself. Briefly - the player is mid-replay
				-- and only needs to know which turn this is.
				if p.live then playback_card(self, LIVE_CARD_CHAINED) end
			end
		end
	end
	-- **A live turn closes itself.** There is no transport to leave up and
	-- nothing to scrub back through: the player was watching, so when it is
	-- over it is over and the map is theirs again.
	if p.live then
		if not p.playing and p.index >= #p.steps and not self.title_timer then
			playback_stop(self)
			return false
		end
		return true
	end
	-- Rebuilt on a change, not per frame: the caption, the scrub position and
	-- the button captions are the only things that move, and all of them change
	-- exactly when the step, the speed or the play state does.
	local key = table.concat({ p.index, p.speed, tostring(p.playing) }, ":")
	if key ~= self.pb_layout then
		self.pb_layout = key
		build_playback_bar(self, store.screen.width, store.screen.height, self.pad)
	end
	return true
end

--- Draw the path a force will actually take.
--
-- The map used to show where an army *was* and the sheet said where it was
-- bound, but nothing showed the route between - so a multi-tile order was an
-- act of faith. Two kinds are drawn, and they have to look different:
--
--   * a **committed** route, in the player's own colour, is what the server is
--     already moving the army along;
--   * a **staged** route, in the interactive colour, is an order sitting in the
--     bar that has not been sent yet.
--
-- A staged order only carries its destination - the server expands it tile by
-- tile - so the same pathfinder is run here to preview it. It is the identical
-- function on identical data, so what is drawn is what will happen.
local function update_routes(self, g, cam, w, h)
	local view = store.game_view
	local used = 0
	-- **Nothing during a replay.** Both kinds of route describe the present -
	-- a committed one is where a force is going *now*, a staged one is a plan
	-- for a turn that has not happened - and drawing either across a map
	-- showing a turn that already resolved is the map contradicting itself.
	if not view or self.pb then
		for i = 1, ROUTE_POOL do
			gui.set_enabled(self.route_nodes[i].bar, false)
			gui.set_enabled(self.route_nodes[i].dot, false)
		end
		return
	end

	-- A committed route flows; a staged one does not. The difference is not
	-- decoration: one is a force already under way, the other is a plan sitting
	-- in the bar. Half a leg a second, which reads as motion without pulling the
	-- eye off the map.
	local flow = (self.clock or 0) * 0.5 % 1

	--- One leg, as a rotated bar with a node on it.
	local function segment(ax, ay, bx, by, colour, last, moving)
		if used >= ROUTE_POOL then return end
		local sx0, sy0 = project(cam, w, h, ax, ay)
		local sx1, sy1 = project(cam, w, h, bx, by)
		-- Cull only when the whole leg is off-screen; a line crossing the view
		-- from two off-screen ends still has to be drawn.
		local lo_x, hi_x = math.min(sx0, sx1), math.max(sx0, sx1)
		local lo_y, hi_y = math.min(sy0, sy1), math.max(sy0, sy1)
		if hi_x < -40 or lo_x > w + 40 or hi_y < self.floor_y - 40
			or lo_y > self.ceiling_y + 40 then
			return
		end

		local dx, dy = sx1 - sx0, sy1 - sy0
		local length = math.sqrt(dx * dx + dy * dy)
		if length < 1 then return end

		used = used + 1
		local node = self.route_nodes[used]
		gui.set_enabled(node.bar, true)
		gui.set_position(node.bar, vmath.vector3((sx0 + sx1) * 0.5, (sy0 + sy1) * 0.5, 0))
		gui.set_size(node.bar, vmath.vector3(length, ROUTE_WIDTH, 0))
		gui.set_rotation(node.bar, vmath.vector3(0, 0, math.deg(math.atan2(dy, dx))))
		gui.set_color(node.bar, colour)

		-- The destination is pinned and larger - it is a place, not a moment.
		-- Every other node slides along its own leg while the force is under
		-- way, which is what makes a route read as travel rather than as a line
		-- someone drew.
		gui.set_enabled(node.dot, true)
		local dx2, dy2 = sx1, sy1
		if not last and moving then
			dx2 = sx0 + (sx1 - sx0) * flow
			dy2 = sy0 + (sy1 - sy0) * flow
		end
		gui.set_position(node.dot, vmath.vector3(dx2, dy2, 0))
		local size = last and (ROUTE_NODE * 1.9) or ROUTE_NODE
		gui.set_size(node.dot, vmath.vector3(size, size, 0))
		gui.set_color(node.dot, colour)
	end

	--- Walk a list of tile ids from a starting world position.
	local function draw(from_x, from_y, hops, colour, moving)
		local ax, ay = from_x, from_y
		for i = 1, #hops do
			local tile = g.tiles[hops[i]]
			if not tile then return end
			segment(ax, ay, tile.x, tile.y, colour, i == #hops, moving)
			ax, ay = tile.x, tile.y
		end
	end

	-- Committed routes, in the player's ink and held back so the staged one
	-- reads as the louder of the two.
	local mine = player_ink(view.you)
	local committed = vmath.vector4(mine.x, mine.y, mine.z, 0.5)
	for i = 1, #view.commanders do
		local f = view.commanders[i]
		if f.route and #f.route > 0 then
			local a = g.tiles[f.at]
			-- A commander always stands at a tile, so the line starts on it.
			if a then draw(a.x, a.y, f.route, committed, true) end
		end
	end

	-- Staged orders. `path` is the server's own expansion, fetched when the
	-- order was issued (see request_path); nothing is drawn until it arrives,
	-- because a straight line between two tiles is not a route and guessing
	-- one here is how a preview starts lying about what the turn will do.
	local staged = ui.ACCENT
	for i = 1, #store.orders do
		local order = store.orders[i]
		if order.path and #order.path > 0 and order.path_from then
			local a = g.tiles[order.path_from]
			if a then draw(a.x, a.y, order.path, staged, false) end
		end
	end

	for i = used + 1, ROUTE_POOL do
		gui.set_enabled(self.route_nodes[i].bar, false)
		gui.set_enabled(self.route_nodes[i].dot, false)
	end
end

--- Draw every army the player can see, positioned along its tile.
--
-- GUI nodes rather than world geometry: a marker wants to stay a constant size
-- at every zoom and to carry a crisp glyph, which is what the labels already do.
-- It also avoids rebuilding a vertex buffer whenever an army moves.
--
-- **A pool node belongs to an officer, not to a loop counter.** Slots used to be
-- handed out in iteration order, so the node an officer was drawn on changed
-- whenever the drawn set did - which is exactly what happens at the boundary
-- between the live map and a replay, and between two steps of one. The
-- `portrait_id` cache then re-played a flipbook on a node that had been somebody
-- else, and the overlap nudge measured against a marker belonging to a different
-- commander. `self.marker_slots` keeps the binding across frames.
local function update_commanders(self, g, cam, w, h)
	local view = store.game_view

	-- Which node each officer had last frame, and which they get this one. A
	-- key that was drawn before keeps its node; anything new takes the first
	-- free one. Rebuilt rather than accumulated, so a commander that is gone for
	-- good does not hold a slot for the rest of the session.
	local prior = self.marker_slots or {}
	local slots, taken = {}, {}
	local placed = {}

	if view then

		--- @param key   who this marker is, so it keeps the same node next frame
		--- @param portrait  the officer's own face, as the wire reports it
		--- @param frac  how far along the tile toward `next_hop`, for a replay
		local function place(key, at, next_hop, label, colour, mine, portrait, frac)
			local a = g.tiles[at]
			if not a then return end
			-- On the tile, pointed at the one it leaves for next. Movement is
			-- whole tiles, so on the live map there is no partway position to
			-- draw - and drawing one would be a lie about where an army can be
			-- intercepted, which is decided at the turn boundary.
			--
			-- A *replay* is the one place `frac` is honest: the turn is over,
			-- the commander really did cross those tiles in that order, and the
			-- only thing invented is how the seconds were spread across them.
			local angle = nil
			local b = next_hop and g.tiles[next_hop]
			if b then angle = math.atan2(b.y - a.y, b.x - a.x) end
			local wx, wy = a.x, a.y
			if b and frac then
				wx = a.x + (b.x - a.x) * frac
				wy = a.y + (b.y - a.y) * frac
			end
			local sx, sy = project(cam, w, h, wx, wy)
			-- Culled on the marker's own extent, not on the bare centre point.
			-- `floor_y` moves by the whole height of the tile sheet when a tile
			-- is selected, so a centre-point test blinked an officer out of
			-- existence while most of the disc was still on screen. The chrome
			-- is created after these nodes and therefore draws over them, so a
			-- marker that reaches under a panel is hidden by it rather than
			-- floating on top.
			if sx < -MARKER_REACH or sx > w + MARKER_REACH
				or sy < self.floor_y - MARKER_REACH
				or sy > self.ceiling_y + MARKER_REACH then
				return
			end

			-- Nudge apart anything that would land on top of something already
			-- placed. At fit zoom - the only zoom reachable without a pinch -
			-- neighbouring tiles are a few units apart, and two markers there
			-- become one unreadable knot of triangles and numbers.
			for i = 1, #placed do
				local other = placed[i]
				local dx = sx - other.at_x
				local dy = sy - other.at_y
				if dx * dx + dy * dy < MARKER_CLEARANCE * MARKER_CLEARANCE then
					local away = math.sqrt(dx * dx + dy * dy)
					if away < 0.001 then
						-- Exactly co-located: fan around the first one instead
						-- of dividing by nothing.
						local turn = i * 2.4
						dx, dy, away = math.cos(turn), math.sin(turn), 1
					end
					sx = other.at_x + dx / away * MARKER_CLEARANCE
					sy = other.at_y + dy / away * MARKER_CLEARANCE
				end
			end

			-- The node this officer had last frame, or the first free one.
			local index = prior[key]
			if not index or taken[index] then
				index = nil
				for i = 1, COMMANDER_POOL do
					if not taken[i] then index = i break end
				end
			end
			if not index then return end
			taken[index] = true
			slots[key] = index

			local marker = self.commander_markers[index]
			marker.at_x, marker.at_y = sx, sy
			placed[#placed + 1] = marker
			gui.set_enabled(marker.face, true)
			gui.set_enabled(marker.ring, true)
			gui.set_enabled(marker.text, true)
			gui.set_position(marker.face, vmath.vector3(sx, sy, 0))
			gui.set_position(marker.ring, vmath.vector3(sx, sy, 0))
			gui.set_position(marker.text, vmath.vector3(sx, sy - 32, 0))
			-- The face is somebody's drawing and is never tinted; the ring and
			-- the caption carry the player colour instead.
			gui.set_color(marker.ring, colour)
			gui.set_color(marker.text, colour)
			gui.set_text(marker.text, label or "")
			-- Only on a change: this runs every frame for up to COMMANDER_POOL
			-- markers, and a marker's face changes about never - which is only
			-- true because the node belongs to one officer.
			if marker.portrait_id ~= portrait then
				marker.portrait_id = portrait
				pcall(gui.play_flipbook, marker.face, portrait or "portrait_terran_01")
			end

			local scale = mine and 1.0 or 0.82
			-- A force under way breathes; a parked one is still. Position only
			-- changes when a turn resolves, so without this an army crossing a
			-- tile is indistinguishable from one sitting on a world - and
			-- animating the *position* would be a lie, because where it can be
			-- intercepted is decided at the turn boundary, not between them.
			if angle then
				local phase = (self.clock or 0) * 3.4 + (at % 7)
				scale = scale * (1 + 0.09 * math.sin(phase))
			end
			gui.set_scale(marker.face, vmath.vector3(scale, scale, 1))
			gui.set_scale(marker.ring, vmath.vector3(scale, scale, 1))

			-- Where it is going, as a chevron just outside the ring. A parked
			-- army has no heading and simply does not get one - which is also
			-- what tells a parked marker from one under way when the pulse is
			-- at the top of its breath.
			gui.set_enabled(marker.pip, angle ~= nil)
			if angle then
				local reach = MARKER_FACE * 0.5 * scale + MARKER_PIP * 0.5
				gui.set_position(marker.pip, vmath.vector3(
					sx + math.cos(angle) * reach,
					sy + math.sin(angle) * reach, 0))
				-- icon_chevron_right points along +x at zero, so the heading is
				-- the rotation - no quarter turn, unlike the ship it replaced.
				gui.set_rotation(marker.pip, vmath.vector3(0, 0, math.deg(angle)))
				gui.set_color(marker.pip, colour)
				gui.set_scale(marker.pip, vmath.vector3(scale, scale, 1))
			end
		end

		--- Where along its own path a marker is, `through` of the way into the
		--- step. Whole legs, so a three-tile march reads as three tiles and not
		--- as one long jump.
		local function walk(from, path, through)
			local legs = #path
			if legs == 0 then return from, nil, nil end
			local along = through * legs
			local leg = math.min(legs, math.floor(along) + 1)
			local start = (leg == 1) and from or path[leg - 1]
			return start, path[leg], along - (leg - 1)
		end

		-- During a replay the markers are the ones the log recorded, not the
		-- ones standing on the map today.
		local p = self.pb
		if p then
			local step = p.steps[p.index]
			local held = playback.duration(step, PLAYBACK_BASE)
			local through = math.min(1, p.elapsed / math.max(0.0001, held))

			-- **Your whole roster, every step.** `step.actors` names every
			-- officer the rewind could place, marching or not, so a commander
			-- with nothing to do this turn stands on its tile instead of
			-- vanishing until it next moves. A stationary one has an empty path,
			-- so `walk` hands back no next hop and it draws parked - no heading
			-- pip, no pulse - exactly as it would on the live map.
			for i = 1, #(step.actors or {}) do
				local a = step.actors[i]
				local start, hop, frac = walk(a.from, a.path, through)
				place(a.id, start, hop, a.name or "", player_ink(a.player),
					true, a.portrait, frac)
			end

			-- Then the rivals, which are sightings rather than officers: only
			-- the stretch of a march that was inside your detection range, so
			-- they start and stop in mid-air on purpose and exist only on the
			-- steps they were seen on. `view.contacts` carries no id, so there
			-- is nothing to give them a presence track with even if it were
			-- honest to.
			for i = 1, #step.moves do
				local m = step.moves[i]
				if not m.mine then
					local start, hop, frac = walk(m.from, m.path, through)
					place("contact:" .. tostring(m.commander or i),
						start, hop, m.rank or "", player_ink(m.player),
						false, m.portrait, frac)
				end
			end
		else
			local mine_colour = player_ink(view.you)
			for i = 1, #view.commanders do
				local f = view.commanders[i]
				-- Name and strength: which commander, and what it can pay for. The
				-- rank is on the strip and the sheet; the number is the one thing
				-- that has to be readable while looking at the map.
				-- Name and what it brings to an army fight - the number that decides
				-- whether the marker beside it can be taken on.
				place(f.id, f.at, f.next_hop,
					f.name .. "  " .. tostring(f.army_power or 0), mine_colour, true,
					f.portrait)
			end
			for i = 1, #view.contacts do
				local c = view.contacts[i]
				-- A rival's number without their rank, which would be twice the
				-- width for a Grand Admiral and is a tap away on the sheet.
				-- Their face is public and always was - realm/sim/view.lua has put
				-- it on the wire since contacts existed, and nothing drew it. It is
				-- how a player learns *whose* army is on their border without being
				-- handed the officer's name.
				--
				-- Keyed by where they are, because a contact has no id: it is the
				-- best stable name available, and a sighting that moves to a new
				-- tile is a new marker rather than the same one gliding, which is
				-- all the wire ever claimed.
				place("contact:" .. tostring(c.at), c.at, c.next_hop,
					tostring(c.army_power or 0),
					player_ink(c.owner), false, c.portrait)
			end
		end
	end

	self.marker_slots = slots
	for i = 1, COMMANDER_POOL do
		if not taken[i] then hide_marker(self.commander_markers[i]) end
	end
end

--- Which tiles are worth naming, and how loudly.
--
-- The map is deliberately scenery: two hundred tiles, most of which a player
-- will never touch. Names are not scenery - a name exists so a place can be
-- referred to - so naming every tile turned the map into a wall of words that
-- buried the tiles underneath it.
--
-- The old ranking was static: city beats holding beats wilds, then by how
-- bright the tile was drawn, computed once per realm and never again. It had
-- no idea which tiles were yours, where your commander stood, or what you were
-- looking at, so it faithfully named the prettiest forty tiles on the map and
-- none of the six that mattered.
--
-- Relevance instead, highest first:
local LABEL_SELECTED = 5   -- what the sheet is describing
local LABEL_SEAT  = 4   -- a seat, anyone's
local LABEL_COMMANDER  = 3   -- where a commander stands, and where they are bound
local LABEL_HELD     = 2   -- somewhere someone holds, including you
local LABEL_FRONTIER = 1   -- unclaimed, but next to something of yours
local LABEL_NONE     = 0   -- scenery

--- Rebuild the naming order. Cheap enough to do on a change, far too expensive
--- to do per frame: it walks every tile and sorts them.
local function rebuild_labels(self, g)
	local view = store.game_view
	local you = view and view.you
	local priority = {}
	local bound = {}

	for i = 1, #((view and view.commanders) or {}) do
		local c = view.commanders[i]
		bound[c.at] = true
		if c.route then
			for k = 1, #c.route do bound[c.route[k]] = true end
		end
	end

	for id = 1, #g.tiles do
		local p = LABEL_NONE
		local seen = view and view.tiles[tostring(id)]
		if seen then
			if (seen.seat_of or 0) ~= 0 then
				p = LABEL_SEAT
			elseif (seen.owner or 0) ~= 0 then
				p = LABEL_HELD
			end
		end
		if bound[id] and p < LABEL_COMMANDER then p = LABEL_COMMANDER end
		if store.selected == id then p = LABEL_SELECTED end
		priority[id] = p
	end

	-- The frontier: unclaimed neighbours of what you hold. This is where a
	-- commander can actually be sent next, so it is the one part of the unowned
	-- map worth being able to name.
	if you then
		for id = 1, #g.tiles do
			local seen = view.tiles[tostring(id)]
			if seen and seen.owner == you then
				local neighbours = g.adjacency[id]
				for k = 1, #neighbours do
					local n = neighbours[k]
					if priority[n] == LABEL_NONE then
						priority[n] = LABEL_FRONTIER
					end
				end
			end
		end
	end

	local order = {}
	for id = 1, #g.tiles do
		if priority[id] > LABEL_NONE then order[#order + 1] = id end
	end
	table.sort(order, function(a, b)
		if priority[a] ~= priority[b] then return priority[a] > priority[b] end
		return a < b
	end)

	self.label_order = order
	self.label_priority = priority
	self.label_dirty = false
end

--- What a name should be rendered in, so ownership reads without being read.
local function label_colour(self, view, id)
	if store.selected == id then return SELECTED_COLOUR end
	local p = self.label_priority and self.label_priority[id] or LABEL_NONE
	local seen = view and view.tiles[tostring(id)]
	local owner = seen and seen.owner or 0
	if owner ~= 0 then
		local c = player_ink(owner)
		local mine = view and owner == view.you
		return vmath.vector4(c.x, c.y, c.z, mine and 1.0 or 0.85)
	end
	if p == LABEL_FRONTIER then
		return vmath.vector4(TILE_COLOUR.x, TILE_COLOUR.y, TILE_COLOUR.z, 0.6)
	end
	return vmath.vector4(TILE_COLOUR.x, TILE_COLOUR.y, TILE_COLOUR.z, 0.4)
end

local function update_labels(self, g, cam, w, h)
	local zoom = cam.zoom
	local pad = self.pad
	local floor_y, ceiling_y = self.floor_y, self.ceiling_y

	local placed = {}
	local used_provinces = 0
	if zoom <= PROVINCE_LABEL_MAX_ZOOM then
		for i = 1, #g.provinces do
			if used_provinces >= PROVINCE_LABEL_POOL then break end
			local r = g.provinces[i]
			local sx, sy = project(cam, w, h, r.cx, r.cy)
			local text = r.name:upper()
			local pw = ui.measure("map", text, PROVINCE_FONT_SCALE)
			local box = { sx - pw * 0.5, sy - 22, sx + pw * 0.5, sy + 22 }
			local blocked = box[1] < pad.left or box[3] > (w - pad.right)
			if not blocked then
				for pi = 1, #placed do
					local q = placed[pi]
					if not (box[3] < q[1] or box[1] > q[3]
						or box[4] < q[2] or box[2] > q[4]) then
						blocked = true
						break
					end
				end
			end
			if not blocked and sy - 22 > floor_y and sy + 22 < ceiling_y then
				used_provinces = used_provinces + 1
				local node = self.province_nodes[used_provinces]
				gui.set_enabled(node, true)
				gui.set_text(node, text)
				gui.set_position(node, vmath.vector3(sx, sy, 0))
				local c = r.colour
				local fade = 1.0 - math.max(0, math.min(1,
					(zoom - PROVINCE_LABEL_MAX_ZOOM * 0.55) / (PROVINCE_LABEL_MAX_ZOOM * 0.45)))
				-- Darkened, not lightened: province names are ink on paper now.
				gui.set_color(node, vmath.vector4(
					c[1] * 0.55, c[2] * 0.55, c[3] * 0.55, 0.34 + 0.52 * fade))
				placed[#placed + 1] = box
			end
		end
	end
	for i = used_provinces + 1, PROVINCE_LABEL_POOL do
		gui.set_enabled(self.province_nodes[i], false)
	end

	local used_tiles = 0
	local span = math.max(0.01, 1.4 - TILE_LABEL_MIN_ZOOM)
	local t = math.max(0, math.min(1, (zoom - TILE_LABEL_MIN_ZOOM) / span))
	local budget = math.floor(TILE_LABELS_AT_MIN_ZOOM
		+ (TILE_LABELS_AT_MAX_ZOOM - TILE_LABELS_AT_MIN_ZOOM) * t + 0.5)
	-- Everything below this tier is scenery at the current zoom.
	local floor_tier = LABEL_COMMANDER
	if zoom >= LABEL_TIER_ZOOM[2] then floor_tier = LABEL_HELD end
	if zoom >= LABEL_TIER_ZOOM[3] then floor_tier = LABEL_FRONTIER end

	if zoom >= TILE_LABEL_MIN_ZOOM and self.label_order then
		local view = store.game_view
		local order = self.label_order
		for oi = 1, #order do
			if used_tiles >= budget then break end
			local id = order[oi]
			if (self.label_priority[id] or 0) < floor_tier then break end
			local s = g.tiles[id]
			local sx, sy = project(cam, w, h, s.x, s.y)
			if sy - 16 > floor_y and sy + 16 < ceiling_y then
				local tw = ui.measure("map", s.name, TILE_FONT_SCALE)
				local gap = 14
				local x0 = sx + gap
				local right_limit = w - pad.right
				if (x0 + tw) > right_limit then x0 = sx - gap - tw end
				local clash = x0 < pad.left or (x0 + tw) > right_limit
				-- Claimed with room around it. Boxes that merely avoid
				-- overlapping still produce touching text, which is most of
				-- what "messy" looked like.
				local box = { x0 - 10, sy - 22, x0 + tw + 10, sy + 22 }
				if not clash then
					for p = 1, #placed do
						local q = placed[p]
						if not (box[3] < q[1] or box[1] > q[3]
							or box[4] < q[2] or box[2] > q[4]) then
							clash = true
							break
						end
					end
				end
				if not clash then
					used_tiles = used_tiles + 1
					local node = self.tile_nodes[used_tiles]
					gui.set_enabled(node, true)
					gui.set_text(node, s.name)
					gui.set_position(node, vmath.vector3(x0, sy, 0))
					gui.set_color(node, label_colour(self, view, s.id))
					placed[#placed + 1] = box
				end
			end
		end
	end
	for i = used_tiles + 1, TILE_LABEL_POOL do
		gui.set_enabled(self.tile_nodes[i], false)
	end
end

-- Orders ----------------------------------------------------------------------------

--- Turn a tap on the map into an order, if one was being aimed.
--- Ask the server what path a freshly staged order would take, for drawing.
--
-- Purely presentational: the order that gets *sent* still carries only its
-- wilds, and the server re-expands them when the turn resolves - by then
-- the map may have moved, and the resolver's answer is the one that counts.
-- What this avoids is a second pathfinder on the client disagreeing with the
-- first, which is the only way a preview can mislead.
local function request_path(self, order, from, fixed)
	local game = store.game
	if not game or not backend.ready() then return end
	order.path_from = from
	backend.game_route(game.id, from, order.route, fixed, function(res, err)
		if err then
			-- The order stands; only the line is missing. A dropped request is
			-- not a reason to throw away what the player asked for.
			return
		end
		if res and res.route and #res.route > 0 then
			order.path = res.route
			return
		end

		-- The server could not route it, so the order is not a real order:
		-- it would sit in the bar looking fine and be refused when the turn
		-- resolved, hours later. Drop it now and say why.
		for i = #store.orders, 1, -1 do
			if store.orders[i] == order then table.remove(store.orders, i) end
		end
		local view = store.game_view
		local hops = view and view.rates and view.rates.hops
		self.flash = hops
			and ("No route - further than " .. ui.plural(hops, "tile") .. " away")
			or ("No route - " .. tostring(res and res.reason or "unreachable"))
		self.flash_timer = 0
		self.sheet_dirty = true
	end)
end

local function resolve_aim(self)
	local selected = store.selected
	if selected == self.last_selected then return end
	self.last_selected = selected
	self.sheet_dirty = true
	-- A launch count belongs to the world it was chosen at.
	self.focus_pending = selected

	local aim = store.aiming
	if not aim or not selected then return end

	if aim.kind == "move" then
		-- A commander already carrying a move is re-routed rather than given a
		-- second one: it is the same decision, changed, and the server
		-- supersedes on exactly that.
		local existing = nil
		for i = 1, #store.orders do
			local o = store.orders[i]
			if o.kind == "move" and o.commander == aim.commander then existing = i end
		end
		if not existing and not store.plan_has_room("move") then
			self.flash, self.flash_timer = "No orders left this turn", 0
			store.aiming = nil
			store.selected_commander = nil
			return
		end
		local order = { kind = "move", commander = aim.commander, route = { selected } }
		if existing then
			store.orders[existing] = order
		else
			store.orders[#store.orders + 1] = order
		end
		-- A commander already in a tile must finish it before turning, so the
		-- path is plotted from the far end - the same rule the resolver applies.
		local view = store.game_view
		local from, fixed = nil, nil
		for k = 1, #((view and view.commanders) or {}) do
			local c = view.commanders[k]
			if c.id == aim.commander then
				from = c.at
				fixed = c.next_hop
			end
		end
		if from then request_path(self, order, fixed or from, fixed) end
	end
	store.aiming = nil
	store.selected_commander = nil
	-- No flash: the manifest in the bar now names the order that was just
	-- added, and a flash would cover the line saying it has not been sent.
end

--- Send the whole plan in one batch.
--
-- Every send carries the *entire* plan, not the part added since the last one.
-- `game.orders` replaces what the server holds rather than appending to it, so
-- a batch that left anything out would silently discard it - which is exactly
-- what happened while the client cleared its own orders on success. The plan
-- now lives until its turn resolves (see main/store.lua).
local function submit_orders(self)
	local game = store.game
	if not game or game.status ~= "active" then
		msg.post("/realm#realm_script", "regenerate", {})
		return
	end
	if self.sending then return end

	local payload = {}
	for i = 1, #store.orders do
		local o = store.orders[i]
		-- `path`/`path_from` exist only to draw the line; the server expands the
		-- wilds itself, so they are stripped rather than sent.
		local out = {}
		for k, v in pairs(o) do
			if k ~= "path" and k ~= "path_from" then out[k] = v end
		end
		payload[#payload + 1] = out
	end

	-- Held over the round trip so the button can say so. A send that vanishes
	-- into a request with no visible change is indistinguishable from a tap
	-- that missed.
	self.sending = true
	self.flash, self.flash_timer = nil, 0
	self.sent_flash = nil

	backend.game_orders(game.id, payload, function(res, err)
		self.sending = false
		if err then
			self.flash = "Orders rejected: " .. tostring(err)
			self.flash_timer = 0
			print("realm: orders rejected (" .. tostring(err) .. ")")
			return
		end
		print(string.format("realm: %d order(s) accepted for turn %s%s",
			res.accepted or 0, tostring(res.for_turn),
			(res.resolved or 0) > 0 and " (resolved immediately)" or ""))
		-- The send ran the turn as well as ending it, so there is a digest
		-- waiting and the poll is up to ten seconds away - at the one moment
		-- the player is certainly watching. Ask for it now.
		if (tonumber(res.resolved) or 0) > 0 then
			msg.post("/realm#realm_script", "refresh", {})
		end
		store.plan_sent(tonumber(res.for_turn) or store.orders_turn)
		store.turn_ended = tonumber(res.for_turn) or true
		store.aiming = nil
		store.selected_commander = nil
		self.sent_flash = 0
		self.flash = nil
		self.sheet_dirty = true
	end)
end

-- Lifecycle -------------------------------------------------------------------------

local function build_chrome(self, w, h)
	ui.region(self.sheet_druid, self.sheet_nodes)
	ui.region(self.chrome_druid, self.chrome_nodes)
	self.sheet_druid, self.chrome_druid = nil, nil
	self.chrome_nodes, self.sheet_nodes = {}, {}
	local previous = ui.collect(self.chrome_nodes)

	self.chrome_druid = druid.new(self)
	self.druid = self.chrome_druid

	local pad = ui.inset()
	self.pad = pad
	build_overview(self, w, h, pad)
	build_zoom(self, w, h, pad)
	build_bar(self, w, pad, submit_orders)
	ui.collect(previous)
	build_commanders(self, w, h, pad)
	self.commander_key = nil

	self.sheet_height = 0
	self.sheet_dirty = true
	-- The transport owns its own Druid province, so `ui.region` above does not
	-- touch it and it would otherwise survive a relayout still positioned
	-- against the old insets. The safe area is not known for the first couple
	-- of hundred milliseconds, so that is not a corner case.
	self.pb_layout = nil
	publish_zones(self)
end

local function refresh_overview(self)
	local view = store.game_view
	local game = store.game
	local o = self.overview
	local on = (view and game) and true or false

	gui.set_enabled(o.card, on)
	gui.set_enabled(o.border, on)
	local slots = { o.holdings, o.provinces, o.gold, o.clock }
	for i = 1, #slots do
		gui.set_enabled(slots[i].icon, on)
		gui.set_enabled(slots[i].value, on)
		gui.set_enabled(slots[i].note, on)
	end
	if not on then return end

	local rates = view.rates or {}
	gui.set_text(o.holdings.value, ui.number(rates.tiles or 0))
	gui.set_text(o.holdings.note, "tiles")
	gui.set_color(o.holdings.note, ui.DIM)

	local held = view.provinces_held or 0
	local needed = view.provinces_needed or 0
	gui.set_text(o.provinces.value, string.format("%d/%d", held, needed))
	gui.set_text(o.provinces.note, held >= needed and "victory" or "provinces")
	gui.set_color(o.provinces.value, held >= needed and ui.GOOD or ui.TEXT)

	gui.set_text(o.gold.value, ui.number(view.gold or 0))
	-- What it earns, not just what it holds: the rate is what a player plans
	-- against, and it is the only thing on this bar that says whether taking
	-- more ground is paying for itself.
	gui.set_text(o.gold.note, "+" .. tostring(rates.income or 0) .. " gold")

	gui.set_text(o.clock.value, "Turn " .. tostring(view.turn or 0))
	local report = store.pending_report
	if self.report_button then self.report_button:set_enabled(report ~= nil) end
	if report then
		gui.set_text(o.clock.note, "new - tap to read")
		gui.set_color(o.clock.note, ui.ACCENT)
		gui.set_color(o.clock.icon, ui.ACCENT)
	else
		local remaining = math.max(0, (game.next_turn_at or 0) - (store.now_estimate or 0))
		gui.set_text(o.clock.note, ui.duration(remaining))
		gui.set_color(o.clock.note, ui.DIM)
		gui.set_color(o.clock.icon, ui.DIM)
	end
end

--- Put the plan on the page, and return how many lines it took.
local function refresh_manifest(self, lines, sent)
	local shown = math.min(#lines, MANIFEST_LINES)
	local overflow = #lines - shown
	-- Sent lines are stated rather than proposed, so they sit back a weight.
	local colour = sent and ui.DIM or ui.TEXT

	for i = 1, MANIFEST_LINES do
		local node = self.manifest[i]
		local drop = self.manifest_drop[i]
		if i <= shown then
			gui.set_enabled(node, true)
			gui.set_text(node, "- " .. lines[i])
			gui.set_color(node, colour)
		else
			gui.set_enabled(node, false)
		end
		if drop then
			gui.set_enabled(drop.fill, i <= shown)
			gui.set_enabled(drop.glyph, i <= shown)
			if drop.component then drop.component:set_enabled(i <= shown) end
		end
	end

	local last = self.manifest[MANIFEST_LINES + 1]
	if overflow > 0 then
		gui.set_enabled(last, true)
		gui.set_text(last, "  +" .. overflow .. " more")
		gui.set_color(last, ui.FAINT)
		return shown + 1
	end
	gui.set_enabled(last, false)
	return shown
end

local function refresh_bar(self, g)
	local game = store.game
	local in_game = (game and game.status == "active") and true or false

	-- **A turn playing out owns the screen for a second or two.** The bar does
	-- not move - shifting it would shift the map underneath it - but nothing on
	-- it is offered, because "I tapped it and nothing happened" is the exact
	-- complaint SEND's four states exist to answer, and a live-looking control
	-- that cannot be pressed is the same fault wearing different clothes.
	if self.pb and self.pb.live then
		self.cancel.set_visible(false)
		self.send.set_visible(true)
		self.send.set_enabled(false)
		self.send.set_style("disabled")
		gui.set_text(self.status, "")
		-- Once, on the way in. The turn resolving consumed the plan, so the
		-- lines still on the card describe orders that have already happened -
		-- and this is the last moment it is safe to resize the bar, because the
		-- band the camera clamps against is measured from it.
		if self.manifest_key ~= "|live" then
			self.manifest_key = "|live"
			refresh_manifest(self, {}, true)
			layout_bar(self, -1)
		end
		return
	end

	local aiming = store.aiming ~= nil
	self.cancel.set_visible(in_game and aiming)
	-- While aiming there are exactly two things to do: pick a destination, or
	-- give up. A dead SEND next to CANCEL is a third thing that looks like an
	-- option and is not one.
	self.send.set_visible(not (in_game and aiming))

	if in_game then
		local view = store.game_view
		local count = store.plan_count()

		-- A plan adopts the turn it is aimed at the moment it has anything in
		-- it, which is what lets a resolving turn tell a live plan from a stale
		-- one. This runs every frame, so there is no window in which a staged
		-- order has no turn against it.
		if count > 0 and not store.orders_turn then
			store.orders_turn = (view and view.turn or 0) + 1
		end

		-- One signature does both jobs: it says whether anything is unsent, and
		-- it is the cache key for the manifest. Without the key this rebuilt
		-- three formatted strings and walked the army list every frame, and
		-- nothing else in this project does per-frame work on the CPU.
		local signature = (count > 0) and store.plan_signature() or ""
		local unsent = (count > 0) and (store.sent_signature ~= signature) or false
		local turn = store.orders_turn or ((view and view.turn or 0) + 1)

		local quiet = (count == 0) and not store.aiming and not self.flash
			and not self.sending and store.selected ~= nil
		local key = signature .. (unsent and "|unsent" or "|in") .. (quiet and "|q" or "")
		if key ~= self.manifest_key then
			self.manifest_key = key
			local rows = refresh_manifest(self, plan_lines(), not unsent)
			layout_bar(self, quiet and -1 or rows)
		end

		-- Four states, and each one has to be distinguishable at a glance from
		-- a tap that did nothing: SEND is the only one that is interactive, and
		-- SENT is a receipt that reverts on its own.
		local label, style, enabled
		if self.sending then
			label, style, enabled = "SENDING", "disabled", false
		elseif self.sent_flash then
			label, style, enabled = "SENT", "success", false
		elseif unsent then
			label, style, enabled = "SEND " .. count, "primary", true
		elseif count > 0 then
			label, style, enabled = "ORDERS IN", "disabled", false
		elseif store.turn_ended then
			label, style, enabled = "WAITING", "disabled", false
		else
			-- Nothing to send is not nothing to say. Submitting is what ends a
			-- player's turn, and the turn resolves as soon as everyone has -
			-- so a player with no orders needs a way to say they are done, or
			-- a game of prompt players still waits out the clock.
			label, style, enabled = "END TURN", "primary", true
		end
		self.send.set_text(label)
		-- Enabled first: set_enabled picks a style of its own, so the exact one
		-- has to be applied after it.
		self.send.set_enabled(enabled)
		self.send.set_style(style)

		-- What the turn has left. Stated whenever anything is staged, because
		-- the whole point of a small allowance is that the player is choosing
		-- against it - a count they have to work out themselves is not one they
		-- can spend.
		local allowance = store.plan_allowance()
		local spent = store.plan_spent()

		local text, tone = self.flash, ui.ACCENT
		if not text then
			local aim = store.aiming
			if aim then
				local commander = commander_by_id(aim.commander)
				text, tone = string.format("Tap where %s should go",
					(commander and commander.name) or "the commander"), ui.ACCENT
			elseif self.sending then
				text, tone = "Sending...", ui.DIM
			elseif store.turn_ended and count == 0 then
				text, tone = "Turn ended - waiting on the others", ui.GOOD
			elseif count > 0 and not unsent then
				text, tone = string.format("%s in for turn %d   %d of %d used",
					ui.plural(count, "order"), turn, spent, allowance), ui.GOOD
			elseif count > 0 then
				text, tone = string.format("%d of %d orders used, not sent yet",
					spent, allowance), ui.WARN
			elseif store.selected then
				text, tone = "", ui.DIM
			else
				text, tone = string.format(
					"%s this turn - tap a commander to spend one",
					ui.plural(allowance, "order")), ui.DIM
			end
		end
		gui.set_text(self.status, text)
		gui.set_color(self.status, tone)
	else
		layout_bar(self, 0)
		self.send.set_text("NEW REALM")
		self.send.set_enabled(true)
		self.send.set_style("secondary")
		gui.set_text(self.status, g and string.format("Seed %d   %s", g.seed,
			tostring(store.source or "?")) or "")
		gui.set_color(self.status, ui.DIM)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()

	self.tile_nodes = {}
	for _ = 1, TILE_LABEL_POOL do
		make_label(self.tile_nodes, TILE_FONT_SCALE, TILE_COLOUR)
	end
	self.province_nodes = {}
	for _ = 1, PROVINCE_LABEL_POOL do
		local n = make_label(self.province_nodes, PROVINCE_FONT_SCALE, TILE_COLOUR)
		gui.set_pivot(n, gui.PIVOT_CENTER)
	end
	-- Route segments, pooled like everything else on the map. Created *before*
	-- the army markers, so the markers draw over them: the marker is the force,
	-- the line is only where it is going. That ordering used to be the other way
	-- round and did not show, because a marker was a small tinted glyph with a
	-- lot of nothing around it. A marker is an opaque disc now, and a route
	-- drawn across a commander's face reads as a fault.
	self.route_nodes = {}
	for _ = 1, ROUTE_POOL do
		local bar = ui.sprite(0, 0, 10, ROUTE_WIDTH, "solid", ui.ACCENT)
		gui.set_pivot(bar, gui.PIVOT_CENTER)
		gui.set_enabled(bar, false)
		local dot = ui.sprite(0, 0, ROUTE_NODE, ROUTE_NODE, "pill", ui.ACCENT)
		gui.set_pivot(dot, gui.PIVOT_CENTER)
		gui.set_enabled(dot, false)
		self.route_nodes[#self.route_nodes + 1] = { bar = bar, dot = dot }
	end

	self.commander_markers = {}
	for _ = 1, COMMANDER_POOL do make_marker(self.commander_markers) end

	self.status_text = ui.text(0, 0, "", ui.TITLE, ui.DIM, { pivot = gui.PIVOT_CENTER })
	gui.set_enabled(self.status_text, false)

	self.revision = -1
	self.layout_w, self.layout_h = -1, -1
	self.layout_safe = -1
	self.pad = ui.inset()
	self.sheet_nodes = {}
	self.commander_nodes = {}
	self.commander_h = 0
	self.commander_key = nil
	self.sheet_height = 0
	self.sheet_dirty = true
	self.flash, self.flash_timer = nil, 0
	self.sent_flash, self.sending = nil, false
	self.floor_y, self.ceiling_y = 0, 0
	store.hud_bar_height = self.pad.bottom + BAR_H
end

function final(self)
	drop_ghost(self)
	ui.dismiss(self.sheet_druid)
	ui.dismiss(self.commander_druid)
	ui.dismiss(self.chrome_druid)
	store.hud_zones = {}
end

--- Say it when a commander was turned back, because nothing else will.
--
-- **This is the one outcome the map cannot show.** A commander that cannot beat
-- both halves stops *before* the border and its route is dropped, so the turn
-- produces no movement and no ground changing hands - which `playback.build`
-- correctly calls a quiet turn and declines to animate, and which a live turn
-- then marks read. The player is left having sent an order, watched the turn
-- resolve, and seen nothing whatsoever happen; the digest carries a row saying
-- why, but only inside a digest they now have no reason to open.
--
-- **Live digests only, and the most recent block in one.** A digest you
-- *arrived* to already gets a title card, a replay and the report behind the
-- turn card, so it has ways to tell you; the live case is the one with no
-- channel at all. Tying this to the digest's latest *turn* instead was wrong:
-- the client polls every ten seconds and a turn resolves faster than that, so a
-- live digest routinely carries two or three turns and the block is almost
-- never in the last one. Measured, it fired for none of them.
local function blocked_notice(self, digest)
	if not (digest and digest.live) then return end
	local view = store.game_view
	local you = view and view.you
	local events = digest.events
	if not (you and events) then return end

	for i = #events, 1, -1 do
		local e = events[i]
		if e.kind == "commander_blocked" and e.player == you then
			-- **Which half turned them back**, because that is the whole of
			-- what the player does next: bring siege, or bring an army. Same
			-- wording as the digest row, so the two read as one explanation.
			local detail
			if (e.siege or 0) < (e.fortification or 0) then
				detail = string.format("walls %d, you brought %d",
					e.fortification or 0, e.siege or 0)
			else
				detail = string.format("army %d, you brought %d",
					e.army or 0, e.army_power or 0)
			end
			-- **Held, not shown.** A playback stands the order bar down and
			-- replaces it with the transport, and a turn that carries a block
			-- usually carries something to animate as well - so setting the
			-- flash here put it under the transport for the whole four seconds
			-- it lives. It is applied in `update` once nothing is playing.
			self.pending_block = string.format("%s was turned back at %s - %s",
				e.name or "A commander", tile_name(e.blocked_by), detail)
			return
		end
	end
end

function update(self, dt)
	local w, h = store.screen.width, store.screen.height
	if w ~= self.layout_w or h ~= self.layout_h
		or self.layout_safe ~= store.safe_revision then
		build_chrome(self, w, h)
		-- The caption is positioned against the screen it was made for, and the
		-- insets arrive a couple of hundred milliseconds in - which is exactly
		-- when it is on screen.
		local interrupted = self.title_then
		title_clear(self)
		if interrupted then interrupted() end
		gui.set_position(self.status_text, vmath.vector3(w * 0.5, h * 0.5, 0))
		self.layout_w, self.layout_h = w, h
		self.layout_safe = store.safe_revision
	end

	self.chrome_druid:update(dt)
	if self.commander_druid then self.commander_druid:update(dt) end
	if self.sheet_druid then self.sheet_druid:update(dt) end
	if self.pb_druid then self.pb_druid:update(dt) end
	playback_update(self, dt)
	title_update(self, dt)

	-- The turned-back notice, once the map is free to show it. Deferred rather
	-- than dropped: the commander is standing still with its route gone and
	-- will keep standing there until it is given a new one, so this is the one
	-- message worth waiting for a gap to deliver.
	if self.pending_block and not self.pb and not self.title_timer then
		self.flash, self.flash_timer = self.pending_block, 0
		self.pending_block = nil
	end

	if self.flash then
		self.flash_timer = self.flash_timer + dt
		if self.flash_timer > 4 then self.flash = nil end
	end
	-- The receipt on the SEND button. Long enough to be read, short enough that
	-- the button is back to saying what it would do next before a thumb returns.
	if self.sent_flash then
		self.sent_flash = self.sent_flash + dt
		if self.sent_flash > 2.5 then self.sent_flash = nil end
	end

	if store.status then
		gui.set_enabled(self.status_text, true)
		gui.set_text(self.status_text, store.status)
	else
		gui.set_enabled(self.status_text, false)
	end

	self.clock = (self.clock or 0) + dt
	automation.update(dt)

	-- A digest handed over on arrival at the map. Held for a frame rather than
	-- opened by realm.script, so the choice between watching it and reading it
	-- is made in one place.
	--
	-- **Arriving never opens the list.** A player coming back to a game gets a
	-- caption and then the replay; a digest with nothing to animate is left
	-- pending instead, so the turn card offers it in its own time rather than
	-- a screen of rows being the first thing they see.
	--
	-- **A turn that lands while you are watching plays out too**, with no title
	-- card - you were not away, so there is nothing to be caught up on. It is
	-- the same mode either way: a playback stands the sheet and the order bar
	-- down, so the map is not accepting orders for a turn it is busy showing
	-- you the last one of.
	--
	-- It declines mid-aim or under a popup, because interrupting somebody
	-- part-way through an action to show them something is worse than being a
	-- moment late. Declining costs nothing: `seen_turn` is only advanced when a
	-- playback actually starts, so the next poll offers it again.
	if store.report_now and store.pending_report and not self.pb
		and not self.title_timer and not store.aiming
		and monarch.top() == hash("map") then
		local digest = store.pending_report
		store.report_now = false

		--- Watching it *is* reading it, so nothing is left to offer afterwards.
		---
		--- **A live turn is marked read either way.** `playback_start` declines
		--- when nothing crossed a tile or changed hands - your own purchases,
		--- a build, a bot marching somewhere you cannot see - and parking that
		--- lit the turn card with "new - tap to read" while the player was
		--- looking straight at the map it happened on. Offering a report about
		--- a turn where visibly nothing happened is the badge earning distrust.
		---
		--- A digest you *arrived* to is different: you were away, so a turn
		--- with nothing to animate is still news, and it stays pending for the
		--- card to offer in your own time.
		local function watch(held)
			store.pending_report = nil
			-- Before the playback decides whether there is anything to show:
			-- a turn where the only thing that happened is that you were
			-- stopped has nothing to animate, and is exactly the turn that
			-- most needs saying out loud.
			blocked_notice(self, held)
			local watched = playback_start(self, held)
			if watched or held.live then
				store.seen_turn = held.turn or store.seen_turn
				seen.set(store.game_id, store.seen_turn)
			else
				store.pending_report = held
			end
		end

		if digest.live then
			watch(digest)
		else
			local from = math.max((digest.since_turn or 0) + 1, digest.from_turn or 1)
			local to = digest.turn or from
			local span = (to > from)
				and string.format("Turns %d to %d", from, to)
				or string.format("Turn %d", to)
			title_card(self, w, h, "Since you were away", span, function()
				-- Re-read rather than captured: a poll may have replaced it in
				-- the second and a half this was on screen.
				local held = store.pending_report
				if held then watch(held) end
			end)
		end
	end

	-- An upgrade slot was tapped. Shown from here rather than from the sheet's
	-- own callback for the reason every popup in this project is: Monarch is
	-- part way through rebuilding the province that callback belongs to.
	if store.slot_popup then
		local slot = store.slot_popup
		store.slot_popup = nil
		monarch.show(hash("slot"), nil, slot)
	end

	-- ...and what it decided. Staging is done here because the turn's
	-- allowance is the HUD's to spend, and `stage_at` already knows how a
	-- second order for the same city supersedes the first.
	if store.slot_request then
		local order = store.slot_request
		store.slot_request = nil
		stage_at(self, order)
	end

	-- The same handshake for buying into a city's garrison, which is what an
	-- empty slot on the shipyard rack offers.
	if store.buy_popup then
		local it = store.buy_popup
		store.buy_popup = nil
		monarch.show(hash("buy"), nil, it)
	end
	if store.buy_request then
		local it = store.buy_request
		store.buy_request = nil
		stage_buy(self, it.at, it.type, 1)
	end

	-- Leaving the game. The menu popup sets this rather than navigating itself,
	-- because a screen being torn down cannot reliably do it.
	if store.leave_requested then
		store.leave_requested = nil
		monarch.back(nil, function()
			-- Cleared once the map is gone. The store is process-wide, so a
			-- stale view would follow the player into the next game they open.
			store.game = nil
			store.game_view = nil
			store.game_id = nil
			store.selected = nil
			store.selected_commander = nil
			store.aiming = nil
			store.orders = {}
			store.orders_turn = nil
			store.sent_signature = nil
			store.turn_ended = nil
			store.pending_report = nil
			store.report_now = false
			store.slot_popup = nil
			store.slot_request = nil
			store.buy_popup = nil
			store.buy_request = nil
			-- A playback abandoned by leaving must not follow the player out:
			-- the map's poll is gated on `playback_active`, so a stale true
			-- here means the next game opened never polls and silently stops
			-- advancing - and `playback_owners` would paint that game's map
			-- with this one's past. Live turns made this reachable: a playback
			-- now starts itself, so leaving mid-replay is an ordinary exit.
			store.playback_active = false
			store.playback_owners = nil
		end)
		return
	end

	local g = store.realm

	-- The naming order depends on who holds what, where the commanders are and
	-- what is selected, so it is rebuilt when any of those move rather than
	-- every frame: it walks every tile and sorts them.
	if g then
		local view = store.game_view
		local key = table.concat({
			tostring(store.selected), tostring(view and view.turn),
			tostring(view and #view.commanders), tostring(store.revision),
		}, ":")
		if self.label_dirty or key ~= self.label_key then
			self.label_key = key
			rebuild_labels(self, g)
		end
	end

	refresh_overview(self)
	refresh_zoom(self)
	refresh_bar(self, g)
	if not g then return end

	if self.revision ~= store.revision then
		self.revision = store.revision
		self.label_dirty = true
		self.sheet_dirty = true
	end

	resolve_aim(self)
	if self.sheet_dirty then
		self.sheet_dirty = false
		self.sheet_height = build_sheet(self, w, self.pad)
		publish_zones(self)
		-- The card can go while a finger is still down on it - a playback
		-- starting, or a leave. The gesture itself notices on the next touch,
		-- but nothing guarantees there is one, and a glyph left stranded under
		-- a replay is the sort of thing that looks like a crash.
		if self.drag and not self.slot_rects then drop_ghost(self) end
	end

	-- The strip is a list of faces, so it only has to be rebuilt when the faces
	-- change: who is in the field, where they are, and which is selected.
	local view = store.game_view
	local key = {}
	for i = 1, #((view and view.commanders) or {}) do
		local f = view.commanders[i]
		key[#key + 1] = table.concat({ f.id, f.portrait or "",
			f.at or 0, (f.eta or 0) > 0 and "m" or "p",
			-- Strength is drawn on the face, so it has to be part of what
			-- counts as the roster changing - otherwise the badge shows what a
			-- commander had before its last battle until something else moves.
			f.carried or 0, f.siege_power or 0 }, ":")
	end
	key[#key + 1] = tostring(store.selected_commander)
	local joined = table.concat(key, "|")
	if joined ~= self.commander_key then
		self.commander_key = joined
		build_commanders(self, w, h, self.pad)
	end

	-- The transport is only built for an arrival digest, so only that one takes
	-- the bottom of the screen. A live turn leaves the band exactly where it
	-- was: the camera clamps against it, and moving it at the moment the map
	-- starts animating slides the whole realm out from under the player.
	self.floor_y = (self.pb and not self.pb.live)
		and (self.pad.bottom + PLAYBACK_H)
		or (self.pad.bottom + BAR_H + bar_extra(self) + self.sheet_height)
	self.ceiling_y = h - self.pad.top - TOP_H - (self.commander_h or 0)
	store.hud_band.floor = self.floor_y
	store.hud_band.ceiling = self.ceiling_y

	-- Bring a newly selected tile into view, but only if the sheet that
	-- describes it is now sitting on top of it.
	--
	-- Deferred to here rather than done at the tap, because how much of the map
	-- is left depends on how tall the sheet turned out - open country is three
	-- lines and a developed city is most of the screen.
	--
	-- Conditional on purpose: moving the map on every selection would be its own
	-- kind of clunky. The camera only intervenes when the alternative is the
	-- player looking at a card about a tile they cannot see.
	if self.focus_pending and g then
		local tile = g.tiles[self.focus_pending]
		self.focus_pending = nil
		if tile then
			local cam = store.camera
			local _, sy = project(cam, w, h, tile.x, tile.y)
			local margin = 40
			if sy < self.floor_y + margin or sy > self.ceiling_y - margin then
				local band = (self.floor_y + self.ceiling_y) * 0.5
				msg.post("camera#camera_script", "focus", {
					x = tile.x,
					y = tile.y - (band - h * 0.5) / cam.zoom,
				})
			end
		end
	end

	update_labels(self, g, store.camera, w, h)
	update_routes(self, g, store.camera, w, h)
	update_commanders(self, g, store.camera, w, h)
end

local function on_chrome(self, x, y)
	local zones = store.hud_zones
	for i = 1, #zones do
		local z = zones[i]
		if x >= z[1] and x <= z[3] and y >= z[2] and y <= z[4] then return true end
	end
	return false
end

function on_input(self, action_id, action)
	if not self.chrome_druid then return false end
	local converted = ui.gui_action(action)

	-- **A live replay takes the whole screen, and a tap gives it back.**
	--
	-- Every Druid instance here is fed every action and the chrome is not
	-- rebuilt for a playback, so without this a stray touch still reaches SEND
	-- - which with nothing staged reads END TURN, sends an empty batch, and
	-- both ends the turn and *replaces* whatever orders were already in. That
	-- is the fault the transport's geometry gate was added for; a live turn has
	-- no transport, so the gate is the screen.
	--
	-- Ending on a tap rather than swallowing it: three turns landing at once is
	-- four or five seconds, and a player with no way out of a mode they did not
	-- ask to enter is precisely what the aim flow was careful to avoid. A tap
	-- on the map already means "give me the map back". A *drag* does not, so
	-- the press position is kept and anything that travelled is left alone.
	if self.pb and self.pb.live then
		local x, y = converted.x, converted.y
		if converted.touch and converted.touch[1] then
			x, y = converted.touch[1].x, converted.touch[1].y
		end
		if action.pressed then
			self.pb_press_x, self.pb_press_y = x, y
		elseif action.released and x and y and self.pb_press_x then
			local dx = x - self.pb_press_x
			local dy = y - self.pb_press_y
			self.pb_press_x, self.pb_press_y = nil, nil
			if dx * dx + dy * dy < PB_TAP_SLOP * PB_TAP_SLOP then
				playback_stop(self)
			end
		end
		return true
	end
	-- Kept for the playback's scrub track: Druid's click callback carries no
	-- position, so anything that needs one has to have been told.
	local touch_x = converted.x
	if converted.touch and converted.touch[1] then
		touch_x = converted.touch[1].x
	end
	if touch_x then self.touch_x = touch_x end

	-- While a replay is up, a touch inside the transport belongs to the
	-- transport alone. The order bar is still registered underneath it - the
	-- chrome is not rebuilt for a playback - and every instance here sees
	-- every action, so DONE and END TURN both sat under the same tap and both
	-- fired: dismissing a replay silently sent an empty batch, which both ends
	-- the turn and *replaces* any orders already in. Ownership by geometry,
	-- same as the map boundary.
	local in_pb = false
	if self.pb and self.pb_zone then
		local px, py = converted.x, converted.y
		if converted.touch and converted.touch[1] then
			px, py = converted.touch[1].x, converted.touch[1].y
		end
		local z = self.pb_zone
		in_pb = px ~= nil and py ~= nil
			and px >= z[1] and px <= z[3] and py >= z[2] and py <= z[4]
	end

	-- **The sheet's slots come first.** A gesture starting on one is a unit
	-- being picked up, and it has to pre-empt the Druid buttons under it -
	-- otherwise the upgrade box behind a rack would take the press. It claims
	-- the release too, which is what stops a drag ending on a control firing it.
	if not in_pb and sheet_gesture(self, converted) then return true end

	local handled = false
	if not in_pb then
		handled = self.chrome_druid:on_input(action_id, converted)
		if self.commander_druid and self.commander_druid:on_input(action_id, converted) then
			handled = true
		end
		if self.sheet_druid and self.sheet_druid:on_input(action_id, converted) then
			handled = true
		end
	end
	if self.pb_druid and self.pb_druid:on_input(action_id, converted) then
		handled = true
	end

	-- Claim the input only if it landed on the chrome. Druid reports a touch as
	-- handled whenever one of its hover components tracked it, which is every
	-- touch anywhere on screen - returning that verbatim swallowed the map's
	-- pans and the realm became undraggable.
	if handled and converted then
		local x, y = converted.x, converted.y
		if converted.touch and converted.touch[1] then
			x, y = converted.touch[1].x, converted.touch[1].y
		end
		if x and y and on_chrome(self, x, y) then return true end
	end

	if action_id == hash("reroll") and action.released then
		msg.post("/realm#realm_script", "regenerate", {})
		return true
	end
	return false
end

function on_message(self, message_id, message, sender)
	if self.chrome_druid then
		self.chrome_druid:on_message(message_id, message, sender)
	end
	if self.sheet_druid then
		self.sheet_druid:on_message(message_id, message, sender)
	end
end
