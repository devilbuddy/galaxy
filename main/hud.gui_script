--- Screen-space labels and HUD.
--
-- Labels are GUI nodes rather than world geometry so text stays crisp and a
-- constant size at every zoom level, the way a real map's labels behave. A
-- fixed pool of nodes is recycled each frame: only what is on screen and worth
-- naming gets a node, so the count stays flat however large the galaxy is.

local store = require("main.store")
local backend = require("main.backend")
local ui = require("main.ui")

local STAR_LABEL_POOL = 80
local REGION_LABEL_POOL = 12

-- Below this zoom individual systems are too dense to label legibly, and only
-- region names are drawn.
local STAR_LABEL_MIN_ZOOM = 0.30
-- How many system labels to show at the extremes of the zoom range. Filling the
-- screen with names at full zoom-out turns the map into a wall of text, so the
-- budget grows as the player zooms in and the map earns the detail.
local STAR_LABELS_AT_MIN_ZOOM = 14
local STAR_LABELS_AT_MAX_ZOOM = 80
-- Above this, region names would sit uselessly far off screen.
local REGION_LABEL_MAX_ZOOM = 1.10

-- Base sizes are expressed against the 720x1280 design resolution and then
-- multiplied by the device pixel ratio, because GUI nodes are positioned in
-- framebuffer pixels (see store.screen).
local STAR_FONT_SCALE = 0.62
local REGION_FONT_SCALE = 1.05

-- Height of the bottom HUD bar. The camera ignores drags that start inside it
-- so panning cannot fight the buttons.
local HUD_BAR_HEIGHT = 104

local STAR_COLOUR = vmath.vector4(0.76, 0.81, 0.92, 1.0)
local SELECTED_COLOUR = vmath.vector4(1.0, 0.92, 0.62, 1.0)

local function make_text(pool, size, colour)
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(node, "map")
	gui.set_scale(node, vmath.vector3(size, size, 1))
	gui.set_color(node, colour)
	gui.set_pivot(node, gui.PIVOT_W)
	gui.set_enabled(node, false)
	pool[#pool + 1] = node
	return node
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.star_nodes = {}
	for _ = 1, STAR_LABEL_POOL do
		make_text(self.star_nodes, STAR_FONT_SCALE, STAR_COLOUR)
	end
	self.region_nodes = {}
	for _ = 1, REGION_LABEL_POOL do
		local n = make_text(self.region_nodes, REGION_FONT_SCALE, STAR_COLOUR)
		gui.set_pivot(n, gui.PIVOT_CENTER)
	end

	-- HUD chrome.
	self.bar = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(10, HUD_BAR_HEIGHT, 0))
	gui.set_color(self.bar, vmath.vector4(0.03, 0.04, 0.08, 0.86))
	gui.set_pivot(self.bar, gui.PIVOT_SW)

	self.button = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(168, 52, 0))
	gui.set_color(self.button, vmath.vector4(0.14, 0.20, 0.36, 0.95))
	gui.set_pivot(self.button, gui.PIVOT_CENTER)

	self.button_text = gui.new_text_node(vmath.vector3(0, 0, 0), "NEW GALAXY")
	gui.set_font(self.button_text, "map")
	gui.set_scale(self.button_text, vmath.vector3(0.95, 0.95, 1))
	gui.set_pivot(self.button_text, gui.PIVOT_CENTER)
	gui.set_color(self.button_text, vmath.vector4(0.82, 0.88, 1.0, 1.0))

	self.seed_text = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(self.seed_text, "map")
	gui.set_scale(self.seed_text, vmath.vector3(0.78, 0.78, 1))
	gui.set_pivot(self.seed_text, gui.PIVOT_W)
	gui.set_color(self.seed_text, vmath.vector4(0.52, 0.58, 0.72, 1.0))

	-- Centred status line, shown while connecting or waiting on the server.
	self.status_text = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(self.status_text, "map")
	gui.set_scale(self.status_text, vmath.vector3(0.9, 0.9, 1))
	gui.set_pivot(self.status_text, gui.PIVOT_CENTER)
	gui.set_color(self.status_text, vmath.vector4(0.62, 0.70, 0.88, 1.0))
	gui.set_enabled(self.status_text, false)

	self.info_text = gui.new_text_node(vmath.vector3(0, 0, 0), "")
	gui.set_font(self.info_text, "map")
	gui.set_scale(self.info_text, vmath.vector3(0.85, 0.85, 1))
	gui.set_pivot(self.info_text, gui.PIVOT_NW)
	gui.set_color(self.info_text, vmath.vector4(0.86, 0.90, 1.0, 1.0))
	gui.set_line_break(self.info_text, true)

	self.bar_height = HUD_BAR_HEIGHT
	self.button_rect = nil
	store.hud_bar_height = HUD_BAR_HEIGHT
	self.revision = -1
	self.layout_w, self.layout_h = -1, -1
end

--- Position the fixed chrome. Re-run whenever the window size changes.
local function layout(self, w, h)
	self.bar_height = HUD_BAR_HEIGHT
	store.hud_bar_height = HUD_BAR_HEIGHT

	gui.set_position(self.bar, vmath.vector3(0, 0, 0))
	gui.set_size(self.bar, vmath.vector3(w, self.bar_height, 0))

	local button_w, button_h = 190, 58
	local bx = w - button_w * 0.5 - 20
	local by = self.bar_height * 0.5
	gui.set_size(self.button, vmath.vector3(button_w, button_h, 0))
	gui.set_position(self.button, vmath.vector3(bx, by, 0))
	gui.set_position(self.button_text, vmath.vector3(bx, by, 0))
	-- Hit-test against this rectangle rather than gui.pick_node. pick_node
	-- applies the scene's own screen-to-node conversion, which is a different
	-- space again from the design coordinates input arrives in; testing the
	-- rectangle we positioned ourselves keeps everything in one space.
	self.button_rect = {
		bx - button_w * 0.5, by - button_h * 0.5,
		bx + button_w * 0.5, by + button_h * 0.5,
	}
	gui.set_scale(self.button_text, vmath.vector3(0.95, 0.95, 1))

	gui.set_position(self.seed_text, vmath.vector3(20, self.bar_height * 0.5, 0))
	gui.set_scale(self.seed_text, vmath.vector3(0.85, 0.85, 1))

	gui.set_position(self.status_text, vmath.vector3(w * 0.5, h * 0.5, 0))
	gui.set_position(self.info_text, vmath.vector3(20, h - 20, 0))
	gui.set_size(self.info_text, vmath.vector3((w - 40) / 0.95, 240, 0))
	gui.set_scale(self.info_text, vmath.vector3(0.95, 0.95, 1))

	self.layout_w, self.layout_h = w, h
end

--- Cheap text width estimate in pixels.
--
-- gui.get_text_metrics is exact but costs a measurement per call, and this runs
-- over every candidate label every frame. The monospace-ish default font makes
-- a per-character estimate accurate enough for overlap rejection.
local function text_width(text, scale)
	return #text * 11.0 * scale
end

local function update_labels(self, g, cam, w, h)
	local zoom = cam.zoom
	local half_w, half_h = w * 0.5, h * 0.5

	local function to_screen(wx, wy)
		return (wx - cam.x) * zoom + half_w, (wy - cam.y) * zoom + half_h
	end

	-- Region names first: they own the space, and star labels avoid them.
	local placed = {}
	local used_regions = 0
	if zoom <= REGION_LABEL_MAX_ZOOM then
		for i = 1, #g.regions do
			if used_regions >= REGION_LABEL_POOL then break end
			local r = g.regions[i]
			local sx, sy = to_screen(r.cx, r.cy)
			local text_probe = r.name:upper()
			local pw = text_width(text_probe, REGION_FONT_SCALE)
			local pbox = { sx - pw * 0.5, sy - 14, sx + pw * 0.5, sy + 14 }
			local blocked = false
			for pi = 1, #placed do
				local q = placed[pi]
				if not (pbox[3] < q[1] or pbox[1] > q[3] or pbox[4] < q[2] or pbox[2] > q[4]) then
					blocked = true
					break
				end
			end
			if not blocked and sx > -200 and sx < w + 200
				and sy > self.bar_height and sy < h then
				used_regions = used_regions + 1
				local node = self.region_nodes[used_regions]
				local text = r.name:upper()
				gui.set_enabled(node, true)
				gui.set_text(node, text)
				gui.set_position(node, vmath.vector3(sx, sy, 0))
				local c = r.colour
				-- Fade the region name out as the player zooms into it.
				local fade = 1.0 - math.max(0, math.min(1,
					(zoom - REGION_LABEL_MAX_ZOOM * 0.55) / (REGION_LABEL_MAX_ZOOM * 0.45)))
				gui.set_color(node, vmath.vector4(
					math.min(1, c[1] * 0.5 + 0.5),
					math.min(1, c[2] * 0.5 + 0.5),
					math.min(1, c[3] * 0.5 + 0.5), 0.30 + 0.55 * fade))
				placed[#placed + 1] = pbox
			end
		end
	end
	for i = used_regions + 1, REGION_LABEL_POOL do
		gui.set_enabled(self.region_nodes[i], false)
	end

	-- Star names, brightest first, skipping any that would collide.
	local used_stars = 0
	-- Interpolate the budget over the usable zoom range.
	local span = math.max(0.01, 1.4 - STAR_LABEL_MIN_ZOOM)
	local t = math.max(0, math.min(1, (zoom - STAR_LABEL_MIN_ZOOM) / span))
	local budget = math.floor(STAR_LABELS_AT_MIN_ZOOM
		+ (STAR_LABELS_AT_MAX_ZOOM - STAR_LABELS_AT_MIN_ZOOM) * t + 0.5)
	if zoom >= STAR_LABEL_MIN_ZOOM then
		local order = self.label_order
		for oi = 1, #order do
			if used_stars >= budget then break end
			local s = g.stars[order[oi]]
			local sx, sy = to_screen(s.x, s.y)
			if sx > -100 and sx < w + 60 and sy > self.bar_height - 20 and sy < h + 20 then
				local tw = text_width(s.name, STAR_FONT_SCALE)
				local gap = 10
				-- Place to the right normally, but flip to the left rather than
				-- let the name run off the edge of the screen.
				local x0 = sx + gap
				local flip = (x0 + tw) > (w - 8)
				if flip then x0 = sx - gap - tw end
				local box = { x0, sy - 10, x0 + tw, sy + 10 }
				local clash = false
				for p = 1, #placed do
					local q = placed[p]
					if not (box[3] < q[1] or box[1] > q[3] or box[4] < q[2] or box[2] > q[4]) then
						clash = true
						break
					end
				end
				if not clash then
					used_stars = used_stars + 1
					local node = self.star_nodes[used_stars]
					gui.set_enabled(node, true)
					gui.set_text(node, s.name)
					gui.set_position(node, vmath.vector3(x0, sy, 0))
					gui.set_color(node, store.selected == s.id and SELECTED_COLOUR or STAR_COLOUR)
					placed[#placed + 1] = box
				end
			end
		end
	end
	for i = used_stars + 1, STAR_LABEL_POOL do
		gui.set_enabled(self.star_nodes[i], false)
	end
end

--- What the player knows about a system, or nil if they have never seen it.
local function known(id)
	local view = store.game_view
	if not view then return nil end
	return view.systems[tostring(id)]
end

--- Turn a pair of taps into a queued move.
--
-- First tap on a system you own picks the origin; the next tap on any other
-- system queues a move of half the garrison. Half rather than all, because
-- emptying a system by accident is the most expensive mistake available and
-- this is a two-tap gesture.
local function plan_orders(self)
	local selected = store.selected
	if selected == self.last_selected then return end
	self.last_selected = selected
	if not selected or not store.game_view then return end

	local me = store.game_view.you
	local info = known(selected)

	if not store.order_source then
		if info and info.owner == me and info.live and (info.ships or 0) > 1 then
			store.order_source = selected
		end
		return
	end

	if selected == store.order_source then
		store.order_source = nil
		return
	end

	local source = known(store.order_source)
	local available = source and source.ships or 0
	-- Subtract what is already committed from that system this turn.
	for i = 1, #store.orders do
		if store.orders[i].from == store.order_source then
			available = available - store.orders[i].ships
		end
	end

	local send = math.floor(available * 0.5)
	if send >= 1 then
		store.orders[#store.orders + 1] = {
			from = store.order_source, to = selected, ships = send,
		}
	end
	store.order_source = nil
end

local function update_info(self, g)
	local id = store.selected
	if not id then
		gui.set_text(self.info_text, "")
		return
	end
	local s = g.stars[id]
	local parts = { s.name }

	local info = known(id)
	if store.game_view then
		if not info then
			parts[#parts + 1] = "unexplored"
		else
			local me = store.game_view.you
			local owner = info.owner or 0
			local holder = owner == 0 and "unclaimed"
				or (owner == me and "yours"
					or ((store.game_view.players[owner] and store.game_view.players[owner].name)
						or ("Player " .. owner)))
			parts[#parts + 1] = string.format("%s  -  %d ships, %d pop",
				holder, info.ships or 0, info.population or 0)
			if not info.live then
				parts[#parts + 1] = "last seen turn " .. tostring(info.seen)
			end
		end
		if store.order_source == id then
			parts[#parts + 1] = "SELECTED - tap a destination"
		elseif store.order_source then
			local from = g.stars[store.order_source]
			parts[#parts + 1] = "tap again to send from " .. from.name
		end
	else
		local region = g.regions[s.region]
		parts[#parts + 1] = s.class_label .. "  -  " .. region.name
		if s.feature_label ~= "" then parts[#parts + 1] = s.feature_label end
	end

	gui.set_text(self.info_text, table.concat(parts, "\n"))
end

function update(self, dt)
	-- The status line has to work before there is a galaxy: it is what the
	-- player sees while the backend is being contacted.
	if store.status then
		local w, h = store.screen.width, store.screen.height
		if w ~= self.layout_w or h ~= self.layout_h then layout(self, w, h) end
		gui.set_enabled(self.status_text, true)
		gui.set_text(self.status_text, store.status)
	else
		gui.set_enabled(self.status_text, false)
	end

	local g = store.galaxy
	if not g then return end
	local cam = store.camera
	local w, h = store.screen.width, store.screen.height

	if w ~= self.layout_w or h ~= self.layout_h then
		layout(self, w, h)
	end

	-- Rank stars once per galaxy: brightest and largest get labelled first.
	if self.revision ~= store.revision then
		self.revision = store.revision
		local order = {}
		for i = 1, #g.stars do order[i] = i end
		table.sort(order, function(a, b)
			local sa, sb = g.stars[a], g.stars[b]
			local wa = sa.radius * sa.glow
			local wb = sb.radius * sb.glow
			if wa ~= wb then return wa > wb end
			return a < b
		end)
		self.label_order = order
	end

	plan_orders(self)
	update_labels(self, g, cam, w, h)
	update_info(self, g)

	-- Bottom bar: the game's clock, and the orders waiting to be sent.
	local game = store.game
	if game and game.status == "active" then
		local remaining = math.max(0, (game.next_turn_at or 0) - (store.now_estimate or os.time()))
		gui.set_text(self.seed_text, string.format("TURN %d   next in %s",
			game.turn or 0, ui.duration(remaining)))
		local pending = #store.orders
		gui.set_text(self.button_text, pending > 0
			and string.format("SEND %d ORDER%s", pending, pending == 1 and "" or "S")
			or "NO ORDERS")
		gui.set_color(self.button, pending > 0 and ui.ACCENT or ui.PANEL_ALT)
	else
		gui.set_text(self.seed_text, string.format("SEED %d  %s", g.seed,
			(store.source or "?"):upper()))
		gui.set_text(self.button_text, "NEW GALAXY")
	end
end

--- Is a design-space point inside a rectangle {x0, y0, x1, y1}?
local function inside(rect, x, y)
	return rect and x >= rect[1] and x <= rect[3] and y >= rect[2] and y <= rect[4]
end

local function submit_orders()
	local game = store.game
	if not game or #store.orders == 0 then return end
	local payload = {}
	for i = 1, #store.orders do
		payload[i] = store.orders[i]
	end
	backend.game_orders(game.id, payload, function(res, err)
		if err then
			print("galaxy: orders rejected (" .. tostring(err) .. ")")
			return
		end
		print(string.format("galaxy: %d order(s) accepted for turn %s",
			res.accepted or 0, tostring(res.for_turn)))
		store.orders = {}
		store.order_source = nil
	end)
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.released then
		local ax, ay = store.input_point(action.x or 0, action.y or 0)
		if inside(self.button_rect, ax, ay) then
			if store.game and store.game.status == "active" then
				submit_orders()
			else
				msg.post("/galaxy#galaxy_script", "regenerate", {})
			end
			return true
		end
	elseif action_id == hash("reroll") and action.released then
		msg.post("/galaxy#galaxy_script", "regenerate", {})
		return true
	end
	return false
end
