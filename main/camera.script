--- Touch panning and pinch zoom over a map larger than the viewport.
--
-- Written for a phone first: one finger pans, two fingers pinch. Mouse drag
-- and the scroll wheel mirror those on desktop so the prototype is testable
-- without a device.

local store = require("main.store")
local gestures = require("main.gestures")

-- Zoom is world-pixels per screen-pixel: 1.0 shows the map at native scale.
-- The lower bound is recomputed on start so the whole galaxy always fits.
--
-- The ceiling used to be 9.0, and nothing had ever been there: pinch cannot be
-- injected from a workstation, so until the on-screen controls existed the
-- range past the fit zoom was unreachable and unlooked-at. It is 80 world units
-- across, and lanes run 60 to 200 - so the whole screen sits *between* two
-- systems, showing a bare lane and no star at all. 3.0 is about 240 units, or a
-- system and the ones it is joined to, which is as close as there is anything
-- to see.
local ZOOM_MAX = 3.0
local ZOOM_MIN_FLOOR = 0.05

-- The zoom-out floor, as a multiple of the whole-map fit. Seeing the entire
-- galaxy at once is deliberately impossible: the map is mostly scenery, and
-- the widest useful view is a stretch of regions, not the poster. Raising the
-- floor also raises the smallest an emoji glyph ever renders, which is what
-- keeps the map legible at its widest.
local ZOOM_OUT_LIMIT = 2.0
local WHEEL_STEP = 1.18

-- One press of an on-screen zoom button. The range from fit to ZOOM_MAX is
-- about 9x, so this crosses the whole of it in six presses: much less and
-- getting anywhere is a drum solo, much more and each press is a lurch.
local BUTTON_STEP = 1.5
-- How fast a button zoom converges, and how close counts as arrived (as a
-- ratio, because zoom is perceived multiplicatively).
local ZOOM_RATE = 11
local ZOOM_SETTLED = 1.002

-- How far past the map's edge the camera may travel, as a fraction of the
-- viewport. A little overscroll stops the rim from feeling walled off.
local OVERSCROLL = 0.25

-- Drags shorter than this (in screen pixels) count as a tap, not a pan.
local TAP_SLOP = 12

--- The design-resolution viewport, as published by the render script.
local function viewport(self)
	return store.screen.width, store.screen.height
end

--- Keep the camera near the populated part of the map, with some overscroll.
local function clamp_position(self)
	local w, h = viewport(self)
	local half_view_x = (w * 0.5) / self.zoom
	-- Vertically the map is only visible between the chrome, so the slack it can
	-- be moved through is reckoned against that band and not the window. Without
	-- this the galaxy fits the *window* at fit zoom, the camera is pinned, and a
	-- system under the sheet can never be lifted out from under it.
	local band = store.hud_band
	local visible_h = h
	if band.ceiling > band.floor then visible_h = band.ceiling - band.floor end
	local half_view_y = (visible_h * 0.5) / self.zoom

	local margin_x = half_view_x * OVERSCROLL
	local margin_y = half_view_y * OVERSCROLL
	local limit_x = self.content_w * 0.5
	local limit_y = self.content_h * 0.5

	-- When the content is smaller than the viewport on an axis, centre it
	-- rather than letting it drift against a nonsensical clamp.
	local range_x = limit_x - half_view_x + margin_x
	local range_y = limit_y - half_view_y + margin_y
	if range_x < 0 then
		self.x = self.centre_x
	else
		self.x = math.max(self.centre_x - range_x, math.min(self.centre_x + range_x, self.x))
	end
	if range_y < 0 then
		self.y = self.centre_y + self.frame_offset_y
	else
		self.y = math.max(self.centre_y - range_y, math.min(self.centre_y + range_y, self.y))
	end
end

--- Publish the camera to the store. The render script reads it to build the
--- projection, and the HUD reads it to place labels.
local function apply(self)
	clamp_position(self)
	local cam = store.camera
	cam.x, cam.y, cam.zoom = self.x, self.y, self.zoom
	cam.zoom_min, cam.zoom_max = self.zoom_min, ZOOM_MAX
end

--- Zoom about a screen point, so the world under the finger stays under it.
local function zoom_to(self, target, screen_x, screen_y)
	local w, h = viewport(self)
	target = math.max(self.zoom_min, math.min(ZOOM_MAX, target))
	if target == self.zoom then return end

	-- World position currently under the anchor point.
	local wx = self.x + (screen_x - w * 0.5) / self.zoom
	local wy = self.y + (screen_y - h * 0.5) / self.zoom
	self.zoom = target
	-- Solve for the camera position that puts it back under the same point.
	self.x = wx - (screen_x - w * 0.5) / self.zoom
	self.y = wy - (screen_y - h * 0.5) / self.zoom
	apply(self)
end

--- The point a button zoom pivots about.
--
-- Never the middle of the window. The sheet and the order bar can cover the
-- bottom half of it, so the geometric centre is often a point behind a panel,
-- and pivoting on something invisible sends everything the player *can* see
-- rushing off the top of the band. The middle of `hud_band` is the middle of
-- the map as far as anyone looking at it is concerned - the same reason the
-- camera clamps against the band rather than the window.
--
-- Better still, when a system is selected: zooming in is almost always "closer
-- to *that*". Anchoring anywhere else slides it steadily off the pivot, and
-- three presses later the star is behind the sheet describing it - which is
-- exactly what the first run of these buttons did.
local function band_anchor(self)
	local w, h = viewport(self)
	local band = store.hud_band
	local low, high = 0, h
	if band.ceiling > band.floor then low, high = band.floor, band.ceiling end

	local g, id = store.galaxy, store.selected
	local star = id and g and g.stars[id]
	if star then
		-- The same relationship the render script projects with, inverted by
		-- zoom_to below.
		local sx = (star.x - self.x) * self.zoom + w * 0.5
		local sy = (star.y - self.y) * self.zoom + h * 0.5
		-- Only if it is somewhere the player can actually see it; a selection
		-- off the edge of the screen is not what they are reaching toward.
		if sx >= 0 and sx <= w and sy >= low and sy <= high then
			return sx, sy
		end
	end
	return w * 0.5, (low + high) * 0.5
end

--- Ask for a zoom, to be eased into over the next few frames.
--
-- Clamped here rather than in the glide, because a target outside the range
-- would never be reached and the glide would never end.
local function set_zoom_target(self, target)
	self.zoom_target = math.max(self.zoom_min, math.min(ZOOM_MAX, target))
	-- The player has taken charge of the zoom, so stop re-fitting the view
	-- whenever the window or the safe-area insets change under them.
	self.user_zoomed = true
end

--- Recompute the zoom floor from the populated map's extent.
--
-- The usable height excludes the HUD bar, so the frame is judged against the
-- space the player can actually see rather than partly behind the controls.
-- The floor sits ZOOM_OUT_LIMIT above the whole-map fit: the widest view is a
-- neighbourhood of the galaxy, never all of it.
local function refresh_zoom_bounds(self)
	local w, h = viewport(self)
	local bar = store.hud_bar_height or 0
	local usable_h = math.max(1, h - bar)
	local pad = 1.08
	local fit = math.min(w / (self.content_w * pad), usable_h / (self.content_h * pad))
	self.zoom_min = math.max(ZOOM_MIN_FLOOR, fit * ZOOM_OUT_LIMIT)
	self.zoom = math.max(self.zoom_min, math.min(ZOOM_MAX, self.zoom))
	-- Shift the framed centre up by half the HUD bar so the map sits in the
	-- visible area rather than the geometric centre of the window.
	self.frame_offset_y = (bar * 0.5) / self.zoom
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.world = 2600
	-- Sensible defaults until the generator reports the real extent.
	self.content_w, self.content_h = 2600, 2600
	self.centre_x, self.centre_y = 0, 0
	self.frame_offset_y = 0
	self.x, self.y = 0, 0
	self.zoom = 0.42
	self.zoom_min = ZOOM_MIN_FLOOR
	self.zoom_target = nil
	-- Pan/pinch/tap recognition lives in main/gestures.lua so it can be tested
	-- without a device (tools/test_gestures.lua).
	self.recognizer = gestures.new({ tap_slop = TAP_SLOP })
	self.touch_driven = false
	self.mouse_down = false
	-- Once the player zooms, stop re-fitting the view on window changes.
	self.user_zoomed = false
	-- Set the first time a galaxy is framed, so a rebuild of the same one does
	-- not throw the view away.
	self.framed = false
	self.last_w, self.last_h = -1, -1
	refresh_zoom_bounds(self)
	apply(self)
end

--- Active (not lifted) touch points, converted into view space.
local function active_touches(action)
	local out = {}
	local list = action.touch
	if not list then return out end
	for i = 1, #list do
		local p = list[i]
		-- A lifted finger is still reported on the frame it releases; counting
		-- it would keep a two-finger pinch alive for one frame too long and
		-- make the map jump as the remaining finger takes over.
		if not p.released then
			local x, y = store.input_point(p.x, p.y)
			out[#out + 1] = { x = x, y = y }
		end
	end
	return out
end

--- Nearest star to a world point, within a screen-space radius.
local function pick_star(self, screen_x, screen_y)
	local g = store.galaxy
	if not g then return nil end
	local w, h = viewport(self)
	local wx = self.x + (screen_x - w * 0.5) / self.zoom
	local wy = self.y + (screen_y - h * 0.5) / self.zoom
	-- A generous fixed *screen* radius: at low zoom the stars are tiny, and a
	-- world-space radius would make them impossible to hit.
	local reach = 26 / self.zoom
	local best, best_d = nil, reach * reach
	for i = 1, #g.stars do
		local s = g.stars[i]
		local dx, dy = s.x - wx, s.y - wy
		local d = dx * dx + dy * dy
		if d < best_d then best, best_d = i, d end
	end
	return best
end

--- The framebuffer size is not known until the render script has run once,
--- so re-fit the view when it changes.
--- Ease toward a world position, for "show me this commander".
--
-- Eased rather than snapped because the map is the one thing the player holds a
-- mental picture of: a cut leaves them re-reading the whole screen to work out
-- what moved, where a glide carries the eye across and the surrounding systems
-- stay recognisable.
local FOCUS_RATE = 7.5
-- Below this the glide is over. In world units, so it scales with zoom the way
-- the eye does.
local FOCUS_SETTLED = 1.5
-- And below this a frame moved the camera nowhere at all, which means something
-- else is holding it - see the glide in update().
local FOCUS_ARRIVED = 0.01

local function focus_on(self, x, y)
	self.focus_x, self.focus_y = x, y
end

local function cancel_focus(self)
	self.focus_x, self.focus_y = nil, nil
end

--- Hand the view back to the player: whatever it was gliding toward, stop.
local function cancel_glide(self)
	cancel_focus(self)
	self.zoom_target = nil
end

--- Zoom out to the widest allowed view.
--
-- The way *back* is the control that matters most: stepping out of a deep
-- zoom one press at a time is the kind of thing a player does once and then
-- stops zooming in at all. It used to frame the whole galaxy; with the floor
-- above the fit, the widest view no longer holds everything - so it keeps
-- the player's centre rather than gliding to the galaxy's. Recentring on the
-- middle of a map you cannot fully see would carry you away from your own
-- empire, which is the opposite of getting your bearings.
local function zoom_fit(self)
	self.zoom_target = self.zoom_min
	-- Still a view the player chose, so a window change must not re-frame it
	-- out from under them.
	self.user_zoomed = true
end

function update(self, dt)
	if self.zoom_target then
		-- Eased for the same reason `focus` is: a cut leaves the player
		-- re-reading the screen to work out what moved, and a 1.5x jump moves
		-- every star at once.
		local ratio = self.zoom_target / self.zoom
		local next_zoom = self.zoom + (self.zoom_target - self.zoom) * math.min(1, dt * ZOOM_RATE)
		if ratio < ZOOM_SETTLED and ratio > 1 / ZOOM_SETTLED then
			next_zoom = self.zoom_target
			self.zoom_target = nil
		end
		local ax, ay = band_anchor(self)
		zoom_to(self, next_zoom, ax, ay)
	end

	-- Focus runs *after* the zoom, because zoom_to moves the camera to hold the
	-- anchor point still and would otherwise drag the glide off its target on
	-- every frame the two overlap.
	if self.focus_x then
		local was_x, was_y = self.x, self.y
		local t = math.min(1, dt * FOCUS_RATE)
		self.x = self.x + (self.focus_x - self.x) * t
		self.y = self.y + (self.focus_y - self.y) * t
		if math.abs(self.focus_x - self.x) < FOCUS_SETTLED
			and math.abs(self.focus_y - self.y) < FOCUS_SETTLED then
			self.x, self.y = self.focus_x, self.focus_y
			cancel_focus(self)
		end
		apply(self)
		-- Somewhere off the edge of the content is a perfectly reasonable thing
		-- to ask for - the clamp simply stops at the edge - but then the glide
		-- is pulling against it and the "close enough" test above never fires.
		-- A frame that moved the camera nowhere means the clamp has taken over
		-- and there is nothing left to ease toward.
		if self.focus_x and math.abs(self.x - was_x) < FOCUS_ARRIVED
			and math.abs(self.y - was_y) < FOCUS_ARRIVED then
			cancel_focus(self)
		end
	end

	local w, h = viewport(self)
	if w ~= self.last_w or h ~= self.last_h then
		self.last_w, self.last_h = w, h
		refresh_zoom_bounds(self)
		if not self.user_zoomed then
			self.zoom = self.zoom_min
			refresh_zoom_bounds(self)
			self.x = self.centre_x
			self.y = self.centre_y + self.frame_offset_y
		end
		apply(self)
	end
end

--- Apply one frame of recognised gesture to the camera.
local function apply_gesture(self, g)
	-- The moment the player touches the map it is theirs again.
	if g.pan_dx ~= 0 or g.pan_dy ~= 0 or g.zoom ~= 1 then cancel_glide(self) end
	if g.zoom ~= 1 and g.anchor_x then
		zoom_to(self, self.zoom * g.zoom, g.anchor_x, g.anchor_y)
		self.user_zoomed = true
	end
	if g.pan_dx ~= 0 or g.pan_dy ~= 0 then
		-- Drag the map, not the camera: content follows the finger.
		self.x = self.x - g.pan_dx / self.zoom
		self.y = self.y - g.pan_dy / self.zoom
		apply(self)
	end
	if g.tap_x then
		store.selected = pick_star(self, g.tap_x, g.tap_y)
	end
end

function on_input(self, action_id, action)
	-- On a device the touch stream is authoritative. Defold also synthesises a
	-- MOUSE_BUTTON_1 "touch" action for the primary finger, and letting both
	-- act would apply every pan twice, so the first frame carrying a touch
	-- table latches `touch_driven` and the mouse path below stops running.
	if action.touch then
		self.touch_driven = true
		local g = self.recognizer:update(active_touches(action), store.hud_zones)
		apply_gesture(self, g)
		-- Claim the touch only when the camera actually acted on it. A gesture
		-- that began on the HUD belongs to the HUD, and consuming it here left
		-- the controls dead whenever the camera won the input-focus race -
		-- which is not something either side can rely on.
		return not g.blocked
	end

	-- Mouse fallback, for developing on desktop.
	local ax, ay = store.input_point(action.x or 0, action.y or 0)

	-- Mouse *movement* arrives with a nil action_id - only the button press and
	-- release carry the bound one - so a handler keyed solely on "touch" sees
	-- the click but never the drag, and panning silently does nothing.
	local is_button = action_id == hash("touch")
	if not self.touch_driven and (is_button or action_id == nil) then
		local points
		if is_button and action.pressed then
			self.mouse_down = true
			points = { { x = ax, y = ay } }
		elseif is_button and action.released then
			self.mouse_down = false
			points = {}
		elseif self.mouse_down then
			points = { { x = ax, y = ay } }
		else
			return false
		end
		-- Feed the same recogniser as the device, so both share one code path.
		local g = self.recognizer:update(points, store.hud_zones)
		apply_gesture(self, g)
		return is_button and not g.blocked
	elseif action_id == hash("zoom_in") and action.pressed then
		cancel_glide(self)
		zoom_to(self, self.zoom * WHEEL_STEP, ax, ay)
		self.user_zoomed = true
	elseif action_id == hash("zoom_out") and action.pressed then
		cancel_glide(self)
		zoom_to(self, self.zoom / WHEEL_STEP, ax, ay)
		self.user_zoomed = true
	end
end

function on_message(self, message_id, message)
	if message_id == hash("focus") then
		-- Clamped by apply() as the glide runs, so asking for somewhere off the
		-- edge of the content simply stops at the edge.
		focus_on(self, message.x, message.y)
		return
	end
	if message_id == hash("zoom_step") then
		-- The HUD asks for a direction, not a level: the step size belongs with
		-- the range it is a step of, and a button that named its own factor
		-- would be a second place the zoom is described.
		--
		-- Stepping from the *target* rather than the current zoom is what makes
		-- an impatient double-tap add up instead of the second press landing
		-- somewhere in the middle of the first one's glide.
		set_zoom_target(self, (self.zoom_target or self.zoom)
			* (message.out and (1 / BUTTON_STEP) or BUTTON_STEP))
		return
	end
	if message_id == hash("zoom_fit") then
		zoom_fit(self)
		return
	end
	if message_id == hash("zoom_level") then
		-- An absolute level, for the one caller that has a reason to pick one:
		-- a replay has to frame what it is showing, and the fit zoom - where a
		-- captain is four pixels wide - is where the map always starts.
		set_zoom_target(self, message.zoom)
		return
	end
	if message_id == hash("map_ready") then
		local w = math.max(1, message.content_width)
		local h = math.max(1, message.content_height)
		-- Re-frame only for a galaxy we have not framed before. The map is
		-- rebuilt whenever a turn resolves, and treating every rebuild as a new
		-- galaxy snapped the player's zoom back to the whole-map fit - which,
		-- with a poll every ten seconds, looked like the zoom resetting itself.
		local fresh = not self.framed
			or w ~= self.content_w or h ~= self.content_h
			or message.centre_x ~= self.centre_x
			or message.centre_y ~= self.centre_y

		self.world = message.world
		self.content_w = w
		self.content_h = h
		self.centre_x = message.centre_x
		self.centre_y = message.centre_y
		refresh_zoom_bounds(self)

		if fresh then
			-- Start framed on the whole galaxy, then let the player zoom in.
			self.framed = true
			self.user_zoomed = false
			self.zoom = self.zoom_min
			refresh_zoom_bounds(self)
			self.x = self.centre_x
			self.y = self.centre_y + self.frame_offset_y
		end
		apply(self)
	elseif message_id == hash("window_resized") then
		refresh_zoom_bounds(self)
		apply(self)
	end
end
