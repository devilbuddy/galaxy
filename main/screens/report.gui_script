--- Turn report: everything that happened while the player was away.
--
-- Shown as a Monarch popup over the map, so dismissing it reveals the map
-- already in its new state rather than triggering another load.
--
-- The event log is deliberately raw on the wire (see realm/sim/resolve.lua);
-- turning it into sentences is a presentation concern and lives here, which
-- means the same log could later drive an animated playback without the server
-- changing at all.

local druid = require("druid.druid")
local monarch = require("monarch.monarch")
local store = require("main.store")
local ui = require("main.ui")

local PAD = 26

-- However many events arrive, only this many get nodes. The server already caps
-- the window it sends (MAX_DIGEST_TURNS), but a busy war can still produce
-- hundreds of events inside it, and a GUI scene has a fixed node budget - the
-- unbounded version exhausted it and the screen failed to build at all.
local MAX_ROWS = 140

local function tile_name(id)
	local g = store.realm
	if g and id and g.tiles[id] then return g.tiles[id].name end
	return "tile " .. tostring(id)
end

local function player_name(index)
	local view = store.game_view
	if view and view.players and view.players[index] then
		return view.players[index].name
	end
	return "Player " .. tostring(index)
end

--- One event as a row: an icon, a headline, a detail line and a tone.
--
-- Returning a table rather than a string is what lets the list look like a
-- list - every row has the same shape, and the kind of thing that happened is
-- readable from the glyph before any of the text is.
local function describe(event, me)
	local kind = event.kind

	if kind == "turn_summary" then
		local bits = {
			ui.plural(event.tiles or 0, "tile"),
			ui.plural(event.provinces or 0, "province"),
		}
		if (event.claimed or 0) > 0 then
			bits[#bits + 1] = "+" .. ui.plural(event.claimed, "claimed")
		end
		if (event.taken or 0) > 0 then
			bits[#bits + 1] = "+" .. ui.plural(event.taken, "taken")
		end
		if (event.earned or 0) > 0 then
			bits[#bits + 1] = string.format("%d gold (+%d)",
				event.gold or 0, event.earned)
		end
		return {
			heading = true,
			title = "Turn " .. tostring(event.turn),
			subtitle = table.concat(bits, "   "),
		}

	elseif kind == "claimed" then
		return {
			icon = "icon_flag", tone = event.player == me and ui.GOOD or ui.DIM,
			title = (event.player == me and "Claimed " or "Lost ") .. tile_name(event.at),
			subtitle = (event.name or "A commander") .. " passed through",
		}

	elseif kind == "bought" then
		local mix = {}
		for i = 1, #((store.game_view and store.game_view.units) or {}) do
			local spec = store.game_view.units[i]
			local n = (event.took or {})[spec.id] or 0
			if n > 0 then
				local singular, plural = ui.unit_name(spec)
				mix[#mix + 1] = n .. " " .. ui.plural_word(n, singular, plural)
			end
		end
		return {
			icon = "icon_industry", tone = ui.GOOD,
			title = "Bought " .. (#mix > 0 and table.concat(mix, ", ")
				or ui.plural(event.units or 0, "unit")),
			subtitle = string.format("into the garrison at %s, for %d gold",
				tile_name(event.at), event.cost or 0),
		}

	elseif kind == "transferred" then
		return {
			icon = "icon_warship", tone = ui.GOOD,
			title = (event.name or "A commander") .. " took aboard "
				.. ui.plural(event.units or 0, "unit"),
			subtitle = string.format("at %s - now %d vs walls, %d vs ships",
				tile_name(event.at), event.siege or 0,
				event.army_power or 0),
		}

	elseif kind == "garrison_lost" then
		return {
			icon = "icon_defence", tone = ui.BAD,
			title = "The garrison at " .. tile_name(event.at)
				.. " was destroyed",
			subtitle = ui.plural(event.units or 0, "unit") .. " lost holding it",
		}

	elseif kind == "built" then
		return {
			icon = "icon_industry", tone = ui.GOOD,
			-- The event carries the catalogue's own name; the theme's is a
			-- client fact, so it is resolved here from the id and falls back to
			-- what the server said rather than to a bare `interceptor_bay`.
			title = ((event.building
					and ui.building_name({ id = event.building, name = event.name }))
				or event.name or "A building") .. " at " .. tile_name(event.at),
			subtitle = string.format("%d gold", event.cost or 0),
		}

	elseif kind == "recruited" then
		return {
			icon = "icon_warship", tone = ui.GOOD,
			title = (event.name or "An officer") .. " took up a commission",
			subtitle = string.format("Raised at %s for %d gold",
				tile_name(event.at), event.cost or 0),
		}

	elseif kind == "commander_moved" or kind == "contact_moved" then
		-- On the wire, deliberately not in this list. Movement is one row per
		-- commander per turn and the digest spans up to forty turns, so listing it
		-- would bury everything that actually happened. It is carried for the
		-- playback to animate; see the note in realm/sim/resolve.lua.
		return nil

	elseif kind == "commander_ordered" then
		return {
			icon = "icon_speed", tone = ui.ACCENT,
			title = (event.name or "A commander") .. " set out",
			subtitle = string.format("Bound for %s, %s away",
				tile_name(event.to), ui.plural(event.hops or 0, "tile")),
		}

	elseif kind == "commander_blocked" then
		local who = player_name(event.held_by)
		-- The numbers, not just the fact. Being turned back is the moment a
		-- player needs to know exactly what it would have taken; without it the
		-- only way to find out is to try again next turn and be turned back
		-- again.
		-- **Which half turned them back**, because that is the whole of what a
		-- player does next: bring guns, or bring ships.
		local detail = tile_name(event.blocked_by) .. " is held by " .. who
		if (event.siege or 0) < (event.fortification or 0) then
			detail = detail .. string.format("  -  walls %d, brought %d",
				event.fortification, event.siege)
		elseif (event.army or 0) > 0 then
			detail = detail .. string.format("  -  army %d, brought %d",
				event.army, event.army_power or 0)
		end
		return {
			icon = "icon_close", tone = ui.WARN,
			title = (event.name or "A commander") .. " was turned back",
			subtitle = detail,
		}

	elseif kind == "battle" then
		local mine = event.player == me
		local title = mine
			and ((event.name or "A commander") .. " took " .. tile_name(event.at))
			or (player_name(event.player) .. " took " .. tile_name(event.at))
		-- Named, not just numbered. "33 resistance broken" is a receipt; "the
		-- world's 9 and Commodore Vantor" is what happened, and it is the same
		-- data the resolver already sends for a replay to be built from.
		local defended = {}
		for i = 1, #(event.garrison or {}) do
			local g = event.garrison[i]
			defended[#defended + 1] = (g.rank and (g.rank .. " ") or "")
				.. tostring(g.name) .. " (" .. tostring(g.power) .. ")"
		end
		local detail
		if #defended > 0 then
			detail = string.format("%s of walls and %s",
				tostring(event.fortification or 0), table.concat(defended, ", "))
		else
			detail = tostring(event.fortification or 0) .. " of walls broken"
		end
		if mine and event.exchanges then
			local lost = 0
			for _, n in pairs(event.lost or {}) do lost = lost + n end
			detail = detail .. string.format("  -  %s, %s lost",
				ui.plural(#event.exchanges, "exchange"),
				ui.plural(lost, "unit"))
		end
		if event.promoted then
			detail = detail .. "  -  promoted to " .. event.promoted
		end
		return {
			icon = "icon_attack", tone = mine and ui.GOOD or ui.BAD,
			title = title, subtitle = detail,
			-- Yours has exchanges behind it; somebody else's is a line in a
			-- list, because you were not there to count theirs.
			battle = (mine and event.exchanges) and event or nil,
		}

	elseif kind == "commander_broken" then
		return {
			icon = "icon_defence", tone = ui.BAD,
			title = (event.name or "A commander") .. " was broken at "
				.. tile_name(event.lost),
			subtitle = "Reformed at the seat as "
				.. (event.rank or "a lesser officer"),
		}

	elseif kind == "province_control" then
		local where = event.name or ("province " .. tostring(event.province))
		if event.player == me then
			return { icon = "icon_flag", tone = ui.GOOD,
				title = "Took " .. where, subtitle = "The province is yours" }
		elseif event.from == me then
			return { icon = "icon_flag", tone = ui.BAD,
				title = "Lost " .. where,
				subtitle = event.player ~= 0
					and ("It fell to " .. player_name(event.player))
					or "No one holds it now" }
		end
		return { icon = "icon_flag",
			title = where .. " changed hands",
			subtitle = event.player ~= 0
				and (player_name(event.player) .. " holds it")
				or "It is contested again" }

	elseif kind == "victory" then
		return {
			icon = "icon_flag", tone = event.player == me and ui.GOOD or ui.BAD,
			title = event.player == me and "You have won"
				or (player_name(event.player) .. " has won"),
			subtitle = event.by == "survival"
				and "Everyone else has lost their seat"
				or string.format("%d of %d provinces held",
					event.provinces or 0, event.needed or 0),
		}

	elseif kind == "order_rejected" then
		return {
			icon = "icon_close", tone = ui.BAD,
			title = "Order refused",
			subtitle = tostring(event.reason),
		}

	elseif kind == "eliminated" then
		return {
			icon = "icon_close", tone = ui.BAD,
			title = player_name(event.player) .. " has lost their seat",
		}
	end

	return { icon = "icon_tile", title = kind, subtitle = tostring(event.at or "") }
end

local function build(self, data)
	local w, h = store.screen.width, store.screen.height
	local all_events = (data and data.events) or {}
	local me = (data and data.you) or 1
	local pad = ui.inset()
	local card_w = w - pad.left - pad.right

	-- Newest last is how the log *arrives*, whatever order it is displayed in
	-- below, so a trim still has to drop from the front.
	local events, dropped = all_events, 0
	if #all_events > MAX_ROWS then
		events = {}
		dropped = #all_events - MAX_ROWS
		for i = dropped + 1, #all_events do events[#events + 1] = all_events[i] end
	end

	-- Two orderings, and they are not the same one.
	--
	-- **Turns run newest first.** A digest is read from the top and the reader
	-- has just come back to it, so the first thing on screen has to be the most
	-- recent turn - not the oldest one in a forty-turn window they have to
	-- scroll past to find out what happened last night.
	--
	-- **Events inside a turn keep the order they happened in.** They are a
	-- sequence - a commander sets out, is turned back - and reversing them within
	-- the turn would make each one read as the cause of the one above it.
	--
	-- The resolver appends each turn's summary *after* that turn's events (it is
	-- written in the aftermath phase), so read top-down the log said "army out
	-- of fuel" and only then "TURN 544" - the heading closed a turn instead of
	-- opening it. Regroup so a turn's heading still opens its own group.
	local order, groups = {}, {}
	for i = 1, #events do
		local turn = events[i].turn or 0
		if not groups[turn] then
			groups[turn] = { summary = nil, rest = {} }
			order[#order + 1] = turn
		end
		if events[i].kind == "turn_summary" then
			groups[turn].summary = events[i]
		else
			local rest = groups[turn].rest
			rest[#rest + 1] = events[i]
		end
	end
	table.sort(order, function(a, b) return a > b end)
	local ordered = {}
	for i = 1, #order do
		local g = groups[order[i]]
		if g.summary then ordered[#ordered + 1] = g.summary end
		for k = 1, #g.rest do ordered[#ordered + 1] = g.rest[k] end
	end
	events = ordered

	ui.shade()

	local top = h - pad.top
	ui.h1(pad.left + 6, top - 32, "Since you were away", nil)

	local turns = {}
	local count = 0
	for i = 1, #events do
		if events[i].turn and not turns[events[i].turn] then
			turns[events[i].turn] = true
			count = count + 1
		end
	end
	local summary
	if count == 0 then
		summary = "Nothing has happened yet"
	else
		summary = ui.plural(#events, "event") .. " across " .. ui.plural(count, "turn")
		local from = data and data.from_turn
		local since = data and data.since_turn
		if dropped > 0 then
			summary = summary .. "   " .. dropped .. " older omitted"
		elseif from and since and from > since + 1 then
			summary = summary .. "   earlier turns omitted"
		end
	end
	ui.small(pad.left + 6, top - 76, summary, ui.DIM)

	local footer_top = pad.bottom + ui.CONTROL
	ui.button(self.druid, pad.left, footer_top, card_w, ui.CONTROL, "TO THE MAP",
		function() monarch.hide(hash("report")) end,
		{ style = "primary", size = ui.CAPS })

	local list_top = top - 106
	local list_h = list_top - (footer_top + ui.GAP)
	ui.card(pad.left, list_top, card_w, list_h)

	local inner_w = card_w - PAD * 2
	local _, content, scroll = ui.scroll(self.druid, pad.left + PAD, list_top - PAD,
		inner_w, list_h - PAD * 2)

	local nodes = {}
	local y = 0
	for i = 1, #events do
		local row = describe(events[i], me)
		if not row then
			-- Carried for the playback, with nothing to say in a list.
		elseif row.heading then
			-- A turn boundary is a divider with a label, not another row: it is
			-- the thing that makes a long digest scannable.
			if i > 1 then y = y - 16 end
			nodes[#nodes + 1] = ui.divider(0, y, inner_w)
			nodes[#nodes + 1] = ui.caps(0, y - 26, row.title)
			nodes[#nodes + 1] = ui.small(0, y - 46, row.subtitle, ui.FAINT,
				{ width = inner_w, anchor_top = true })
			y = y - 86
		else
			local h_row = 88
			nodes[#nodes + 1] = ui.icon(2, y - 22, 30, row.icon, row.tone or ui.DIM)
			nodes[#nodes + 1] = ui.body(46, y - 26, row.title, ui.TEXT)
			if row.subtitle and row.subtitle ~= "" then
				nodes[#nodes + 1] = ui.small(46, y - 48, row.subtitle, ui.DIM,
					{ width = inner_w - 52, anchor_top = true })
			else
				h_row = 54
			end
			-- A fight of yours is worth opening. The row itself is the target -
			-- a chevron on the end would be another thing to aim at, and the
			-- whole line is already a comfortable one.
			if row.battle then
				local fight = row.battle
				local hit = ui.panel(0, y - 4, inner_w, h_row - 8, ui.CLEAR)
				nodes[#nodes + 1] = hit
				nodes[#nodes + 1] = ui.small(inner_w - 4, y - 26, "see it",
					ui.ACCENT, { pivot = gui.PIVOT_E })
				self.druid:new_button(hit, function()
					monarch.show(hash("battle"), nil,
						{ battle = fight, you = me })
				end)
			end
			y = y - h_row
		end
	end

	if #all_events == 0 then
		nodes[#nodes + 1] = ui.body(0, -32,
			"Your orders are in. Check back after the next turn.", ui.DIM,
			{ width = inner_w, anchor_top = true })
		y = -80
	end

	for i = 1, #nodes do gui.set_parent(nodes[i], content) end
	ui.fit_scroll(scroll, content, inner_w, -y + 12, list_h - PAD * 2)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()
	self.druid = druid.new(self)
	build(self, monarch.data(hash("report")))
end

function final(self) ui.dismiss(self.druid) end
function update(self, dt) self.druid:update(dt) end
function on_input(self, action_id, action)
	-- A full-screen popup claims every action, so the map behind it neither
	-- pans nor changes selection while this is up.
	return ui.modal_input(self.druid, action_id, action)
end
function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end
