--- One battle, exchange by exchange.
--
-- The turn digest says a system changed hands. This says what it *cost*, which
-- in an asynchronous game is the part that decides the next turn: a captain who
-- took a fortress and came out with two units left is not going anywhere for a
-- while, and that is the thing a player needs to see rather than infer.
--
-- **Whether it was won was never in doubt** - the sheet's two comparisons said
-- so before the order was given, and a captain that cannot beat both halves
-- does not attack. So this screen is not a reveal. It is the receipt.
--
-- ### What it does not draw
--
-- The mock-up this was built from has ships manoeuvring across a tactical map.
-- There is no spatial simulation inside a battle - exchanges are a trade of
-- damage, not positions - so drawing formations moving would be the first thing
-- in this project that shows a player something the game does not know.
--
-- Two facing columns that *thin out* instead: the same information, and true.
-- One side is the hold, unit by unit, because it is yours and you know it in
-- detail. The other is a wall and a name, because that is all a rival ever
-- shows you.

local druid = require("druid.druid")
local monarch = require("monarch.monarch")
local store = require("main.store")
local ui = require("main.ui")
local playback = require("main.playback")

local PAD = 26
-- A unit is drawn as a pip rather than a ship: at this size a glyph is a smudge,
-- and what has to read is *how many are left*, which a row of dots says better
-- than a row of silhouettes.
local PIP = 22
local PIP_GAP = 6
local PIPS_PER_ROW = 12

local TYPE_COLOUR = {
	line = ui.TEXT,
	lance = ui.ACCENT,
	siege = ui.WARN,
}

local function star_name(id)
	local g = store.galaxy
	local star = id and g and g.stars[id]
	return (star and star.name) or ("system " .. tostring(id))
end

local function player_name(index)
	local view = store.game_view
	local who = view and view.players and view.players[index]
	return (who and who.name) or ("Player " .. tostring(index))
end

local function player_colour(index)
	local view = store.game_view
	local race = view and view.players and view.players[index]
		and view.players[index].race
	return ui.race_colour(race)
end

--- A row of pips for one complement, wrapping when it is wide.
--
-- Returns the height it used, so the caller can stack whatever comes next
-- without knowing how many units there were.
local function draw_hold(x, y, hold, types, faded)
	local drawn, row, height = 0, 0, 0
	for i = 1, #types do
		local spec = types[i]
		local n = (hold and hold[spec.id]) or 0
		for _ = 1, n do
			local column = drawn % PIPS_PER_ROW
			row = math.floor(drawn / PIPS_PER_ROW)
			local colour = TYPE_COLOUR[spec.id] or ui.TEXT
			if faded then colour = ui.FAINT end
			ui.dot(x + column * (PIP + PIP_GAP), y - row * (PIP + PIP_GAP),
				PIP, colour)
			drawn = drawn + 1
			height = (row + 1) * (PIP + PIP_GAP)
		end
	end
	if drawn == 0 then
		ui.small(x, y - PIP * 0.5, "nothing left", ui.FAINT)
		height = PIP + PIP_GAP
	end
	return height
end

--- The key, because three colours of dot mean nothing on their own.
local function draw_legend(x, y, types, hold)
	local at = x
	for i = 1, #types do
		local spec = types[i]
		local n = (hold and hold[spec.id]) or 0
		ui.dot(at, y, 14, TYPE_COLOUR[spec.id] or ui.TEXT)
		ui.small(at + 20, y - 7, string.format("%s %d", spec.name, n), ui.FAINT)
		at = at + 24 + ui.text_width(spec.name .. " " .. n, ui.SMALL) + 22
	end
end

local function build(self, data)
	ui.region(self.body_druid, self.nodes)
	self.body_druid, self.nodes = nil, {}
	local previous = ui.collect(self.nodes)
	self.body_druid = druid.new(self)

	local w, h = store.screen.width, store.screen.height
	local event = (data and data.battle) or {}
	local me = (data and data.you) or (store.game_view and store.game_view.you) or 0
	local types = (store.game_view and store.game_view.units) or {}
	local pad = ui.inset()
	local width = w - pad.left - pad.right
	local inner = pad.left + PAD

	local frames = playback.battle(event, types)
	local index = math.max(1, math.min(#frames, self.index or #frames))
	self.index = index
	local frame = frames[index]

	ui.shade()

	local top = h - pad.top
	local mine = event.player == me

	-- Header: who, where, and how it went. Never a reveal - the sheet said so
	-- before the order was given - so it states rather than announces.
	ui.h1(inner, top - 34, mine and "You took it" or "It was taken", nil)
	ui.small(inner, top - 74, string.format("%s   %s",
		star_name(event.at), ui.plural(#frames, "exchange")), ui.DIM)

	local y = top - 118
	ui.divider(inner, y, width - PAD * 2)

	-- Two sides. Yours in detail, theirs as what a rival ever shows you.
	y = y - 34
	ui.caps(inner, y, player_name(event.player))
	ui.small(inner + width - PAD * 2, y, string.format("%d vs walls   %d vs ships",
		event.siege or 0, event.fleet_power or 0), ui.FAINT,
		{ pivot = gui.PIVOT_E })
	ui.pill(inner - 8, y + 12, 4, 24, player_colour(event.player))

	y = y - 24
	local used = draw_hold(inner, y, frame and frame.hold, types, false)
	y = y - used - 6
	draw_legend(inner, y, types, frame and frame.hold)
	y = y - 34

	ui.divider(inner, y, width - PAD * 2)
	y = y - 34
	ui.caps(inner, y, player_name(event.against))
	ui.pill(inner - 8, y + 12, 4, 24, player_colour(event.against))

	y = y - 40
	ui.icon(inner, y + 14, 26, "icon_defence", ui.DIM)
	ui.body(inner + 34, y, (event.fortification or 0) .. " of walls", ui.TEXT)
	for i = 1, #(event.garrison or {}) do
		local g = event.garrison[i]
		y = y - 34
		ui.icon(inner, y + 12, 22, "icon_warship", ui.BAD)
		ui.small(inner + 30, y, string.format("%s %s   %d",
			g.rank or "", g.name or "", g.power or 0), ui.BAD)
	end
	if #(event.garrison or {}) == 0 then
		y = y - 30
		ui.small(inner, y, "Nobody was standing on it", ui.FAINT)
	end

	-- The log: one line per exchange, and the officer's own command called out
	-- because it is the only part of a battle a player can improve by keeping
	-- somebody alive.
	y = y - 44
	ui.divider(inner, y, width - PAD * 2)
	y = y - 30
	ui.caps(inner, y, "exchanges")

	for e = 1, #frames do
		local f = frames[e]
		local gone = 0
		for _, n in pairs(f.lost) do gone = gone + n end
		y = y - 32
		local here = (e == index)
		ui.small(inner, y, tostring(e), here and ui.ACCENT or ui.FAINT)
		local said
		if gone > 0 then
			local parts = {}
			for i = 1, #types do
				local n = f.lost[types[i].id] or 0
				if n > 0 then parts[#parts + 1] = n .. " " .. types[i].name end
			end
			said = "Lost " .. table.concat(parts, ", ")
		elseif (f.shield or 0) > 0 then
			said = "The flagship held"
		else
			said = "No losses"
		end
		ui.small(inner + 30, y, said, here and ui.TEXT or ui.DIM)
		if (f.shield or 0) > 0 and gone > 0 then
			ui.small(inner + width - PAD * 2, y,
				"flagship absorbed " .. f.shield, ui.FAINT,
				{ pivot = gui.PIVOT_E })
		end
	end

	-- Scrubbing back through it, and the way out. Anchored to the bottom rather
	-- than to the log, so a two-exchange battle and a six-exchange one put both
	-- controls in the same place.
	local row_y = pad.bottom + ui.CONTROL
	local track_y = row_y + 40
	local track_w = width - PAD * 2
	ui.bar(inner, track_y, track_w, 12, ui.BG)
	local fraction = (#frames > 1) and ((index - 1) / (#frames - 1)) or 1
	ui.bar(inner, track_y, math.max(12, track_w * fraction), 12, ui.ACCENT)
	ui.dot(inner + track_w * fraction - 8, track_y - 2, 16, ui.ACCENT)

	local grab = ui.panel(inner - 10, track_y + 22, track_w + 20, 56, ui.CLEAR)
	self.body_druid:new_button(grab, function(_, _, touch)
		local at = touch and touch.x
		if not at then return end
		local a = ui.gui_action({ x = at, y = 0 })
		local pick = (a.x - inner) / math.max(1, track_w)
		self.index = math.floor(pick * (#frames - 1) + 1.5)
		self.rebuild = true
	end)

	local done_w = 200
	ui.button(self.body_druid, w - pad.right - PAD - done_w, row_y,
		done_w, ui.CONTROL, "DONE",
		function() monarch.hide(hash("battle")) end,
		{ style = "primary", size = ui.CAPS })
	ui.small(inner, row_y - ui.CONTROL * 0.5,
		string.format("Exchange %d of %d", index, #frames), ui.FAINT)

	ui.collect(previous)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()
	self.druid = druid.new(self)
	self.nodes = {}
	self.data = monarch.data(hash("battle"))
	build(self, self.data)
end

function final(self)
	ui.region(self.body_druid, self.nodes)
	self.body_druid = nil
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
	if self.body_druid then self.body_druid:update(dt) end
	-- Rebuilt on a change, never per frame: the whole card is torn down and put
	-- back, which is only cheap because it happens when somebody scrubs.
	if self.rebuild then
		self.rebuild = false
		build(self, self.data)
	end
end

function on_input(self, action_id, action)
	-- A full-screen popup claims every action, so the map behind it neither
	-- pans nor changes selection while this is up.
	local converted = ui.gui_action(action)
	if self.body_druid then self.body_druid:on_input(action_id, converted) end
	return ui.modal_input(self.druid, action_id, action)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
	if self.body_druid then
		self.body_druid:on_message(message_id, message, sender)
	end
end
