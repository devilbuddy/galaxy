--- Lobby: choose a people, then a game to play or one to start.
--
-- Built in code from main/ui.lua, with Druid supplying the interaction. The
-- game list is rebuilt wholesale whenever the server answers, which at a
-- handful of games costs nothing and avoids diffing logic.
--
-- The race choice lives here rather than inside a per-game flow because it
-- applies to whichever game is created or joined next, and because it is the
-- one decision a player wants to make while reading what is on offer.

local druid = require("druid.druid")
local monarch = require("monarch.monarch")
local seen = require("main.seen")
local backend = require("main.backend")
local store = require("main.store")
local ui = require("main.ui")
local safearea = require("main.safearea")
local races = require("realm.sim.races")
local dev = require("main.dev")

local PAD = 26
-- How many turns of digest the server is willing to send back, from
-- MAX_DIGEST_TURNS in server/modules/game_rpc.lua. Kept in step by hand; it
-- only bounds a label.
local MAX_DIGEST_TURNS = 40
local REFRESH_SECONDS = 5

-- Two columns rather than three: a race name needs the width to stay on one
-- line at a readable size, and a 3-across tile was 200 units wide.
local RACE_COLUMNS = 2
local RACE_TILE_H = 84
local RACE_GAP = 14

-- Effect key -> a short human phrase. The trade-offs are the whole point of
-- choosing a people, so they are spelled out here rather than discovered three
-- days into a game.
local EFFECT_LABEL = {
	attack = "attack", defence = "defence", capture = "capture",
	fortress = "fortresses", speed = "speed", hops = "range",
	-- Only the mobility keys currently do anything (see
	-- realm/sim/modifiers.lua); the rest are the design intent for when
	-- production is built back, and are still worth showing so a race reads as
	-- a character rather than a speed stat.
	industry = "output", growth = "growth", capacity = "capacity",
	research = "research", vision = "vision",
}

-- Stable order, so a race always reads the same way.
local EFFECT_ORDER = {
	"attack", "defence", "capture", "fortress", "speed", "hops",
	"industry", "ship_cost", "building_cost", "cap", "growth", "capacity",
	"research", "vision", "tech_cost",
}

-- Counts of tiles, not percentages.
local WHOLE_NUMBER = { hops = true, vision = true }

local function screen()
	return store.screen.width, store.screen.height
end

local function roster_line(game)
	local people, bots = 0, 0
	for i = 1, #game.players do
		if game.players[i].bot then bots = bots + 1 else people = people + 1 end
	end
	local who = ui.plural(people, "player")
	if bots > 0 then who = who .. " and " .. ui.plural(bots, "bot") end
	return string.format("%d/%d   %s", #game.players, game.max_players, who)
end

--- Rebuild the list from the last server response.
local function render_games(self)
	-- **Its own Druid instance, dropped wholesale.** This used to delete the row
	-- nodes and *then* remove the components pointing at them, which is the
	-- inversion `ui.region` exists to prevent: a component whose node is already
	-- gone throws from its own teardown, and anything after it in the loop stays
	-- registered. The next `late_init` then walks a deleted node's parents and
	-- throws `druid/helper.lua: Deleted node` from somewhere with no connection
	-- to the list at all.
	--
	-- It bites here in particular because the list is rebuilt from an async
	-- response, which can land between a button being created and Druid's first
	-- update over it - so the component is torn down before it was ever fully
	-- set up.
	ui.region(self.rows_druid, self.rows)
	self.rows_druid = druid.new(self)

	local out = self.rows
	local function keep(node) out[#out + 1] = node; return node end
	local w = self.list_width
	local y = -4
	local games = self.games or {}

	for m = 1, #(self.mine or {}) do
		local g = self.mine[m]
		local h = 186
		keep(ui.panel(0, y, w, h, ui.CARD))
		keep(ui.panel_line(0, y, w, h, ui.ACCENT_SOFT))

		-- Turns that have resolved since this device last read the digest. The
		-- lobby is the first thing a player sees, and with several games on the
		-- go the question it has to answer is "which one has moved" - which was
		-- previously only findable by opening each in turn.
		--
		-- Computed entirely on the client: `main/seen.lua` already persists how
		-- far each game has been read, and the row already carries the turn, so
		-- the server has nothing to say about it.
		local unread = 0
		if g.status ~= "lobby" then
			unread = math.max(0, (tonumber(g.turn) or 0) - seen.get(g.id))
		end

		keep(ui.caps(PAD, y - 18, m == 1 and "your games" or ""))
		keep(ui.title(PAD, y - 62, g.name))
		keep(ui.small(PAD, y - 98, roster_line(g), ui.DIM))
		keep(ui.small(PAD, y - 128, g.status == "lobby"
			and "Waiting to start" or ("Turn " .. tostring(g.turn)),
			unread > 0 and ui.ACCENT or ui.DIM))

		if unread > 0 then
			-- Capped at what the server will actually send. A game left for a
			-- month is on turn 166 and offers "166 new turns", of which the
			-- digest window holds forty - so the uncapped number promises a
			-- read the player cannot have.
			keep(ui.small(w - PAD, y - 18,
				unread == 1 and "1 new turn"
					or (unread > MAX_DIGEST_TURNS
						and (MAX_DIGEST_TURNS .. "+ new turns")
						or (unread .. " new turns")),
				ui.ACCENT, { pivot = gui.PIVOT_NE }))
		end

		local can_start = g.status == "lobby" and #g.players >= 2
		local running = g.status ~= "lobby"
		local bw = 210
		local handle = ui.button(self.rows_druid, w - PAD - bw, y - 56, bw, ui.CONTROL,
			running and "RESUME" or "START",
			function()
				if running then
					monarch.show(hash("map"), nil, { game_id = g.id })
					return
				end
				self:set_status("Starting...")
				backend.game_start(g.id, function(res, err)
					if err then self:set_status("Could not start: " .. err) return end
					monarch.show(hash("map"), nil, { game_id = g.id })
				end)
			end,
			{ style = "primary", size = ui.CAPS })
		keep(handle.fill); keep(handle.border); keep(handle.label)
		if not running and not can_start then handle.set_enabled(false) end

		y = y - h - ui.GAP
	end

	if #games == 0 then
		if #(self.mine or {}) == 0 then
			keep(ui.body(PAD, y - 40, "No open games. Start one.", ui.DIM))
		end
	else
		keep(ui.caps(PAD, y - 18, "open games"))
		y = y - 46
	end

	for i = 1, #games do
		local g = games[i]
		local h = 132
		keep(ui.panel(0, y, w, h, ui.CARD))
		keep(ui.panel_line(0, y, w, h, ui.BORDER))

		keep(ui.body(PAD, y - 44, g.name))
		keep(ui.small(PAD, y - 80, roster_line(g), ui.DIM))

		local bw = 170
		local handle = ui.button(self.rows_druid, w - PAD - bw, y - 22, bw, ui.CONTROL, "JOIN",
			function()
				monarch.show(hash("setup"), nil, { mode = "join", game = g })
			end,
			{ style = "secondary", size = ui.CAPS })
		keep(handle.fill); keep(handle.border); keep(handle.label)

		y = y - h - ui.GAP
	end

	for i = 1, #out do gui.set_parent(out[i], self.list_content) end
	ui.fit_scroll(self.list_scroll, self.list_content, w, -y + 8, self.list_height)
end

-- Screen ------------------------------------------------------------------------

local function build(self)
	local w, h = screen()
	local pad = ui.inset()
	self.pad = pad
	ui.sprite(0, h, w, h, "solid", ui.BG)

	local top = h - pad.top
	ui.h1(pad.left + 6, top - 32, "Realm")
	ui.small(pad.left + 6, top - 74, "Asynchronous conquest", ui.DIM)
	self.status_label = ui.small(pad.left + 6, top - 104, "", ui.FAINT)

	local footer_top = pad.bottom + ui.CONTROL
	local card_w = w - pad.left - pad.right
	-- One action. Creating a game is a flow of its own now (screens/setup), so
	-- this button opens it rather than firing a request with whatever the lobby
	-- happened to have selected. REFRESH went with it: the lobby already polls.
	ui.button(self.druid, pad.left, footer_top, card_w, ui.CONTROL, "NEW GAME",
		function() monarch.show(hash("setup"), nil, { mode = "create" }) end,
		{ style = "primary", size = ui.CAPS })

	local y = top - 132

	-- **The back door**, debug builds only. Two of this game's screens mark
	-- themselves read or need a war to reach; see main/dev.lua for why that is
	-- a problem for looking at them rather than for playing.
	if dev.enabled() then
		local bh = 56
		local half = (card_w - 12) * 0.5
		ui.button(self.druid, pad.left, y, half, bh, "REPLAY DIGESTS",
			function()
				seen.forget()
				self:set_status("Read markers cleared - every game replays in full")
				self:refresh()
			end, { size = ui.CAPS })
		ui.button(self.druid, pad.left + half + 12, y, half, bh, "SAMPLE BATTLE",
			function()
				monarch.show(hash("battle"), nil,
					{ battle = dev.sample_battle(), you = 1 })
			end, { size = ui.CAPS })
		y = y - bh - ui.GAP
	end

	self.list_width = card_w
	self.list_height = y - (footer_top + ui.GAP)
	local _, content, scroll = ui.scroll(self.druid, pad.left, y,
		self.list_width, self.list_height)
	self.list_content = content
	self.list_scroll = scroll
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()
	self.druid = druid.new(self)
	self.rows = {}
	self.games = {}
	self.mine = {}
	self.since_refresh = 0
	store.race = store.race or races.DEFAULT

	self.set_status = function(_, text)
		if self.status_label then gui.set_text(self.status_label, text or "") end
	end

	self.refresh = function()
		if not backend.ready() then
			self:set_status("Offline - no backend at " .. backend.address())
			return
		end
		self:set_status("Loading games...")
		backend.game_list(function(res, err)
			if err then self:set_status("Server error: " .. err) return end
			self.games = res.games or {}
			-- Only one game at a time is supported in the UI for now; the most
			-- recently created is the one offered.
			self.mine = res.mine or {}
			self:set_status(string.format("%d open, %d of yours",
				#self.games, res.mine and #res.mine or 0))
			render_games(self)
		end)
	end

	-- Built on the first update rather than here. The platform reports its
	-- safe-area insets as not-ready for a couple of hundred milliseconds, and a
	-- layout made from the zeroes it returns in the meantime would sit under
	-- the notch for the rest of the session.
	self.built = false
	self.waited = 0
end

function final(self)
	ui.region(self.rows_druid, self.rows)
	self.rows_druid = nil
	ui.dismiss(self.druid)
end

function update(self, dt)
	if not self.built then
		self.waited = self.waited + dt
		-- ...or after a grace period, for platforms that will never answer.
		if safearea.ready() or self.waited > 0.4 then
			self.built = true
			build(self)
			self:refresh()
		end
		return
	end

	self.druid:update(dt)
	if self.rows_druid then self.rows_druid:update(dt) end
	-- A lobby is inherently multiplayer: poll so a second player appearing shows
	-- up without the first having to prod it.
	self.since_refresh = self.since_refresh + dt
	if self.since_refresh > REFRESH_SECONDS then
		self.since_refresh = 0
		if backend.ready() then
			backend.game_list(function(res, err)
				if not err and res.games then
					self.games = res.games
					self.mine = res.mine or {}
					render_games(self)
				end
			end)
		end
	end
end

function on_input(self, action_id, action)
	if not self.built then return false end
	-- Druid hit-tests with the action it is given; it must be in GUI space.
	local converted = ui.gui_action(action)
	local handled = self.druid:on_input(action_id, converted)
	if self.rows_druid and self.rows_druid:on_input(action_id, converted) then
		handled = true
	end
	return handled
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
	if self.rows_druid then
		self.rows_druid:on_message(message_id, message, sender)
	end
end
