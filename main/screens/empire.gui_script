--- Empire: what you command, and what you are learning.
--
-- A Monarch popup over the map, for the same reason the turn report is one:
-- dismissing it puts the player back on the map they were already looking at
-- rather than reloading it.
--
-- Two top-level tabs rather than one long page. Forces and research are both
-- lists that want to scroll, and nesting one scroll inside another is a fight
-- over every drag; a tab strip means exactly one scrolling region is on screen.
--
-- The research tree is drawn one branch at a time, as a column: tier one, then
-- the two tier-two technologies side by side, then the tier-three that needs
-- both. That is the actual shape of every branch, and it reads as a tree in
-- portrait - which a left-to-right graph does not, at 720 points wide.
--
-- Choosing a technology stages the change in `store` and it travels with the
-- next SEND alongside the fleet orders, so one action covers the whole turn's
-- plan and the player can revise any of it until the turn resolves.

local druid = require("druid.druid")
local monarch = require("monarch.monarch")
local store = require("main.store")
local ui = require("main.ui")
local tech = require("galaxy.sim.tech")
local races = require("galaxy.sim.races")
local sim_systems = require("galaxy.sim.systems")

local PAD = 26
local NODE_H = 140
local NODE_H_SPLIT = 206
local TIER_GAP = 40

-- Effect key -> how to say it, and which glyph carries it. Anything missing
-- falls back to the raw key so a new effect shows up as something readable
-- rather than vanishing from the card.
local EFFECT = {
	attack        = { "attack", "icon_attack" },
	defence       = { "defence", "icon_defence" },
	capture       = { "population kept on capture", "icon_growth" },
	fortress      = { "fortress strength", "icon_defence" },
	speed         = { "fleet speed", "icon_speed" },
	hops          = { "order range", "icon_speed" },
	industry      = { "output", "icon_industry" },
	ship_cost     = { "hull cost", "icon_industry" },
	building_cost = { "building cost", "icon_industry" },
	cap           = { "fleet cap", "icon_warship" },
	growth        = { "growth", "icon_growth" },
	capacity      = { "world capacity", "icon_capacity" },
	research      = { "research", "icon_research" },
	vision        = { "vision", "icon_vision" },
	tech_cost     = { "research cost", "icon_research" },
}

-- Counts of lanes, not percentages.
local WHOLE_NUMBER = { hops = true, vision = true }

-- Stable order, so a technology always reads the same way.
local EFFECT_ORDER = {
	"attack", "defence", "capture", "fortress", "speed", "hops",
	"industry", "ship_cost", "building_cost", "cap", "growth", "capacity",
	"research", "vision", "tech_cost",
}

local function describe_effects(entry)
	local parts = {}
	for i = 1, #EFFECT_ORDER do
		local key = EFFECT_ORDER[i]
		local value = entry.effects[key]
		if value then
			local label = (EFFECT[key] and EFFECT[key][1]) or key
			if WHOLE_NUMBER[key] then
				parts[#parts + 1] = string.format("%+d %s", value, label)
			else
				parts[#parts + 1] = string.format("%+d%% %s",
					math.floor(value * 100 + 0.5), label)
			end
		end
	end
	return table.concat(parts, ", ")
end

--- The glyph that best summarises what a technology does.
local function effect_icon(entry)
	for i = 1, #EFFECT_ORDER do
		local key = EFFECT_ORDER[i]
		if entry.effects[key] and EFFECT[key] then return EFFECT[key][2] end
	end
	return "icon_research"
end

--- What the player is aiming at, staged change included.
local function current_target(view)
	if store.pending_research ~= nil then
		return store.pending_research ~= "" and store.pending_research or nil
	end
	return view.researching
end

-- The research tree -----------------------------------------------------------------

local function branch_tiers(branch)
	local tiers = {}
	for i = 1, #tech.TECHS do
		local entry = tech.TECHS[i]
		if entry.branch == branch then
			tiers[entry.tier] = tiers[entry.tier] or {}
			local row = tiers[entry.tier]
			row[#row + 1] = entry
		end
	end
	return tiers
end

--- The drawn height of the tallest branch, so switching tabs does not make the
--- page jump. Rows are not all the same height, so this adds them up.
local function tallest_branch()
	local tallest = 0
	for i = 1, #tech.BRANCHES do
		local tiers = branch_tiers(tech.BRANCHES[i].id)
		local tier, height = 1, 0
		while tiers[tier] do
			if tier > 1 then height = height + TIER_GAP end
			height = height + (#tiers[tier] == 1 and NODE_H or NODE_H_SPLIT)
			tier = tier + 1
		end
		if height > tallest then tallest = height end
	end
	return tallest
end

local function tech_node(self, x, y, w, h, entry, state, view, out)
	local function keep(node) out[#out + 1] = node; return node end

	local selected = state == "target"
	local locked = state == "locked"
	local done = state == "done"

	local fill = keep(ui.panel(x, y, w, h,
		selected and ui.ACCENT_SOFT or (locked and ui.BG_SOFT or ui.CARD_ALT)))
	keep(ui.panel_line(x, y, w, h, selected and ui.BORDER_HI or ui.BORDER))

	local tile = 56
	local tile_colour = ui.DIM
	if done then tile_colour = ui.GOOD
	elseif locked then tile_colour = ui.FAINT
	elseif selected then tile_colour = ui.ACCENT end
	keep(ui.panel(x + 18, y - 18, tile, tile, locked and ui.BG or ui.CARD))
	keep(ui.icon(x + 32, y - 32, tile - 28, effect_icon(entry), tile_colour))

	local text_x = x + 18 + tile + 16
	local text_w = w - (text_x - x) - 62
	-- The name wraps rather than running out under the status badge: on a
	-- two-up card "Jump Calibration" is wider than the space beside its icon,
	-- and an overflowing title collided with the lock and the card edge both.
	local title_lines = math.max(1,
		math.ceil(ui.measure(ui.FONT_BOLD, entry.label, ui.BODY / 44) / text_w))
	keep(ui.text(text_x, y - 22, entry.label, ui.BODY,
		locked and ui.DIM or ui.TEXT,
		{ bold = true, width = text_w, height = title_lines * 34, anchor_top = true }))
	keep(ui.text(text_x, y - 22 - title_lines * 32, describe_effects(entry), ui.SMALL,
		done and ui.GOOD or (locked and ui.FAINT or ui.DIM),
		{ width = text_w, height = h - 96 - title_lines * 32, anchor_top = true }))

	local footer_y = y - h + 30
	if done then
		keep(ui.small(text_x, footer_y, "Researched", ui.GOOD))
	elseif locked then
		local missing = {}
		for k = 1, #entry.requires do
			if not self.known[entry.requires[k]] then
				missing[#missing + 1] = tech.by_id(entry.requires[k]).label
			end
		end
		keep(ui.small(text_x, footer_y + 12, "Needs " .. table.concat(missing, " + "),
			ui.FAINT, { width = w - (text_x - x) - 24, anchor_top = true }))
	else
		local cost = tech.cost_of(entry.id, (view.rates and view.rates.tech_cost) or 0)
		keep(ui.icon(text_x, footer_y + 11, 22, "icon_research",
			ui.RESOURCE_COLOUR.research))
		keep(ui.text(text_x + 28, footer_y, ui.number(cost), ui.SMALL,
			selected and ui.ACCENT or ui.RESOURCE_COLOUR.research))
		if selected then
			keep(ui.small(text_x, footer_y - 30, "Buying when affordable", ui.ACCENT))
		end
	end

	if done then
		keep(ui.dot(x + w - 52, y - 16, 34, ui.GOOD))
		keep(ui.icon(x + w - 47, y - 21, 24, "icon_check", ui.rgb(0x06170C)))
	elseif locked then
		keep(ui.icon(x + w - 52, y - 16, 30, "icon_lock", ui.FAINT))
	end

	if not locked and not done then
		self.tree_buttons[#self.tree_buttons + 1] =
			self.body_druid:new_button(fill, function()
				-- Tapping the current target clears it; "" rather than nil so the
				-- staged value stays distinguishable from "not staged".
				store.pending_research = selected and "" or entry.id
				self:render_tree()
			end)
	end
end

local function render_tree(self)
	local view = store.game_view
	if not view or not self.tree_content then return end

	ui.clear(self.tree_nodes)
	-- Switching branch rebuilds the tree inside a body that is staying put, so
	-- these are removed individually rather than by dropping the instance.
	for i = 1, #self.tree_buttons do self.body_druid:remove(self.tree_buttons[i]) end
	self.tree_buttons = {}

	self.known = {}
	for i = 1, #(view.tech or {}) do self.known[view.tech[i]] = true end
	local target = current_target(view)

	local out = self.tree_nodes
	local previous = ui.collect(out)
	local w = self.tree_width
	local tiers = branch_tiers(self.branch)
	local y = -4

	local function state_of(entry)
		if self.known[entry.id] then return "done" end
		if not tech.prereqs_met(self.known, entry.id) then return "locked" end
		if entry.id == target then return "target" end
		return "available"
	end

	--- Forks when the tier below is wider than the one above, merges when it is
	--- narrower. A bare straight line into a technology that needs *both* of the
	--- two above it would misstate the prerequisite, which is the one thing the
	--- diagram exists to show.
	local function connector(from_y, above, below)
		local half = TIER_GAP * 0.5
		local function stub(x, y0)
			out[#out + 1] = ui.sprite(x - 1, y0, 2, half, "solid", ui.BORDER)
		end
		local function spread(count)
			if count > 1 then return w * 0.25, w * 0.75 end
			return w * 0.5, w * 0.5
		end
		local a_left, a_right = spread(above)
		local b_left, b_right = spread(below)
		stub(a_left, from_y)
		if above > 1 then stub(a_right, from_y) end
		if a_left ~= b_left or a_right ~= b_right then
			local lo = math.min(a_left, b_left)
			local hi = math.max(a_right, b_right)
			out[#out + 1] = ui.sprite(lo, from_y - half, hi - lo, 2, "solid", ui.BORDER)
		end
		stub(b_left, from_y - half)
		if below > 1 then stub(b_right, from_y - half) end
	end

	local tier = 1
	while tiers[tier] do
		local row = tiers[tier]
		if tier > 1 then
			connector(y, #tiers[tier - 1], #row)
			y = y - TIER_GAP
		end
		if #row == 1 then
			tech_node(self, 0, y, w, NODE_H, row[1], state_of(row[1]), view, out)
			y = y - NODE_H
		else
			local gap = 16
			local cw = (w - gap * (#row - 1)) / #row
			for i = 1, #row do
				tech_node(self, (cw + gap) * (i - 1), y, cw, NODE_H_SPLIT, row[i],
					state_of(row[i]), view, out)
			end
			y = y - NODE_H_SPLIT
		end
		tier = tier + 1
	end

	ui.collect(previous)
	for i = 1, #out do gui.set_parent(out[i], self.tree_content) end
	ui.fit_scroll(self.tree_scroll, self.tree_content, w, -y + 8, self.tree_height)
end

-- Tab bodies ------------------------------------------------------------------------

--- Clear whatever the previous tab put on the page.
--
-- The body has its own Druid instance and it is dropped wholesale. Tracking
-- individual components here is what broke: `ui.tabs` and `ui.scroll` each
-- register one of their own, only the buttons were being removed, and the
-- survivors went on polling nodes that had been deleted - `hover.lua: Deleted
-- node` on the next touch anywhere on screen.
local function clear_body(self)
	ui.region(self.body_druid, self.body_nodes)
	ui.clear(self.tree_nodes)
	self.body_druid = nil
	self.body_nodes, self.tree_buttons = {}, {}
	self.tree_content, self.tree_scroll = nil, nil
end

local function build_forces(self, view, x, top, width, height)
	local previous = ui.collect(self.body_nodes)
	local rates = view.rates or {}
	local g = store.galaxy

	local held, colonies = 0, 0
	for id, sys in pairs(view.systems) do
		if sys.owner == view.you and sys.live then
			held = held + 1
			if g and sim_systems.kind(g, tonumber(id)) == "colony" then
				colonies = colonies + 1
			end
		end
	end

	local card_h = 172
	ui.card(x, top, width, card_h)
	ui.section(x + PAD, top - 16, width - PAD * 2, "the empire")

	local column = (width - PAD * 2) / 3
	local function stat(i, icon, value, label, colour)
		local cx = x + PAD + column * i
		local cy = top - 96
		ui.icon(cx, cy + 15, 28, icon, ui.DIM)
		ui.text(cx + 38, cy, value, ui.BODY, colour or ui.TEXT, { bold = true })
		ui.small(cx + 38, cy - 28, label, ui.DIM)
	end
	stat(0, "icon_warship", ui.number(rates.ships or 0),
		"of " .. ui.number(rates.ship_cap or 0),
		(rates.ships or 0) > (rates.ship_cap or 0) and ui.BAD or ui.TEXT)
	stat(1, "icon_growth", ui.number(rates.population or 0), "people")
	stat(2, "icon_flag", tostring(held), colonies .. " colonies")

	local list_top = top - card_h - ui.GAP
	local list_h = list_top - (top - height)
	ui.card(x, list_top, width, list_h)
	local ry = ui.section(x + PAD, list_top - 16, width - PAD * 2, "fleets",
		#view.fleets)

	local inner_w = width - PAD * 2
	local scroll_h = (ry - 8) - (list_top - list_h) - PAD
	local view_node, content, scroll = ui.scroll(self.body_druid, x + PAD, ry - 8,
		inner_w, scroll_h)
	ui.collect(previous)
	self.body_nodes[#self.body_nodes + 1] = view_node

	-- Rows belong to the scroll's content, so they are collected separately and
	-- reparented once laid out.
	local rows = {}
	local was = ui.collect(rows)
	local y = 0
	if #view.fleets == 0 then
		ui.body(4, -30, "No fleets under way. Send a garrison somewhere.", ui.DIM,
			{ width = inner_w - 8, anchor_top = true })
		y = -90
	else
		local ordered = {}
		for i = 1, #view.fleets do ordered[i] = view.fleets[i] end
		table.sort(ordered, function(p, q)
			if p.ships ~= q.ships then return p.ships > q.ships end
			return p.id < q.id
		end)
		for i = 1, #ordered do
			local f = ordered[i]
			local at = g and g.stars[f.at]
			local moving = (f.eta or 0) > 0
			local subtitle
			if moving then
				local target_id = (f.route and f.route[#f.route]) or f.next_hop
				local dest = g and target_id and g.stars[target_id]
				subtitle = string.format("Bound for %s   %s to go",
					dest and dest.name or "?", ui.plural(f.eta, "lane"))
			else
				subtitle = "Holding at " .. (at and at.name or "?")
			end
			local row = ui.panel(0, y, inner_w, 96, ui.CARD_ALT)
			-- The officer's face, which is the whole reason the roster is worth
			-- looking at rather than reading. Same index as the surname, so it
			-- never changes under a given commander.
			ui.portrait(14, y - 12, 64, f.portrait,
				{ ring_colour = moving and ui.ACCENT or ui.BORDER })
			ui.icon(88, y - 34, 26, "icon_warship", moving and ui.ACCENT or ui.TEXT)
			-- Rank before the name, the way it would be said out loud. It is
			-- the level made legible: a player should be able to tell a veteran
			-- from a green officer without reading a number.
			ui.body(122, y - 30, (f.rank and (f.rank .. " ") or "") .. f.name)
			ui.small(122, y - 58, subtitle, ui.DIM, { width = inner_w - 268 })
			-- Strength against what this commander can actually lead: a force
			-- at capacity is why the rest of your ships are sitting at home.
			ui.value(inner_w - 16, y - 34, tostring(f.ships), ui.H2,
				(f.command and f.ships >= f.command) and ui.WARN or ui.TEXT)
			if f.command then
				ui.small(inner_w - 16, y - 62, "of " .. tostring(f.command), ui.FAINT,
					{ pivot = gui.PIVOT_E })
			end
			-- Tapping a fleet puts the map on it and closes the sheet, which is
			-- the only thing a list like this is really for.
			self.body_druid:new_button(row, function()
					store.selected = f.at
					store.selected_fleet = f.id
					monarch.hide(hash("empire"))
				end)
			y = y - 106
		end
	end
	ui.collect(was)
	for i = 1, #rows do
		gui.set_parent(rows[i], content)
		self.body_nodes[#self.body_nodes + 1] = rows[i]
	end
	ui.fit_scroll(scroll, content, inner_w, -y + 12, scroll_h)
end

local function build_research(self, view, x, top, width, height)
	local previous = ui.collect(self.body_nodes)

	local HEAD = 158
	local wanted = tallest_branch() + 16
	local available = height - HEAD - PAD
	local tree_h = math.min(wanted, available)

	ui.card(x, top, width, HEAD + tree_h + PAD)
	ui.section(x + PAD, top - 16, width - PAD * 2, "research")
	ui.icon(x + width - PAD - 150, top - 8, 28, "icon_research",
		ui.RESOURCE_COLOUR.research)
	ui.value(x + width - PAD, top - 22, ui.number(view.research or 0), ui.BODY, ui.TEXT)
	ui.small(x + PAD, top - 66,
		"One at a time; bought the turn you can afford it", ui.FAINT)

	local tabs = {}
	for i = 1, #tech.BRANCHES do
		tabs[i] = { id = tech.BRANCHES[i].id, label = tech.BRANCHES[i].label }
	end
	local tab_y = top - 88
	self.branch = self.branch or tabs[1].id
	self.branch_tabs = ui.tabs(self.body_druid, x + PAD, tab_y, width - PAD * 2, tabs,
		self.branch, function(id)
			self.branch = id
			self.branch_tabs.set_active(id)
			self:render_tree()
		end)

	self.tree_width = width - PAD * 2
	self.tree_height = tree_h
	local view_node, content, scroll = ui.scroll(self.body_druid, x + PAD, tab_y - 70,
		self.tree_width, tree_h)
	self.tree_content = content
	self.tree_scroll = scroll
	ui.collect(previous)
	self.body_nodes[#self.body_nodes + 1] = view_node

	self:render_tree()
end

-- Screen -----------------------------------------------------------------------------

local TABS = {
	{ id = "forces", label = "Forces" },
	{ id = "research", label = "Research" },
}

local function show_tab(self, id)
	self.tab = id
	clear_body(self)
	local view = store.game_view
	if not view then return end
	self.body_druid = druid.new(self)
	if id == "research" then
		build_research(self, view, self.body_x, self.body_top, self.body_w, self.body_h)
	else
		build_forces(self, view, self.body_x, self.body_top, self.body_w, self.body_h)
	end
end

local function build(self)
	local w, h = store.screen.width, store.screen.height
	local view = store.game_view
	local pad = ui.inset()
	local card_w = w - pad.left - pad.right

	ui.shade()

	local top = h - pad.top
	local race = races.by_id(view and view.race)
	ui.h1(pad.left + 6, top - 34, "Empire")
	ui.body(pad.left + 6, top - 84, race.label, ui.race_colour(race.id))
	ui.small(pad.left + 6, top - 108, race.blurb, ui.DIM,
		{ width = card_w - 20, anchor_top = true })
	ui.icon_button(self.druid, w - pad.right - 60, top, 60, "icon_close",
		function() monarch.hide(hash("empire")) end)

	if not view then
		ui.body(pad.left + 6, top - 170, "No game loaded.", ui.DIM)
		return
	end

	local strip_y = top - 150
	self.page_tabs = ui.tabs(self.druid, pad.left, strip_y, card_w, TABS,
		"forces", function(id)
			self.page_tabs.set_active(id)
			show_tab(self, id)
		end)

	self.body_x = pad.left
	self.body_top = strip_y - 82
	self.body_w = card_w
	-- The close glyph in the corner is the only way out, so the sheet runs down
	-- to the bottom inset instead of reserving a control row for a second button
	-- that said the same thing.
	self.body_h = self.body_top - pad.bottom
	show_tab(self, "forces")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()
	self.druid = druid.new(self)
	self.body_nodes, self.tree_nodes, self.tree_buttons = {}, {}, {}
	self.known = {}
	self.render_tree = render_tree
	build(self)
end

function final(self)
	if self.body_druid then self.body_druid:final() end
	self.druid:final()
end

function update(self, dt)
	self.druid:update(dt)
	if self.body_druid then self.body_druid:update(dt) end
end

function on_input(self, action_id, action)
	-- A full-screen popup claims every action, so the map behind it neither pans
	-- nor changes selection while this is up.
	return ui.modal_input({ self.druid, self.body_druid }, action_id, action)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
	if self.body_druid then
		self.body_druid:on_message(message_id, message, sender)
	end
end
