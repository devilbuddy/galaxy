--- Empire: the stockpile, the shipyard policy and the research tree.
--
-- A Monarch popup over the map, for the same reason the turn report is one:
-- dismissing it puts the player back on the map they were already looking at
-- rather than reloading it.
--
-- Nothing here is submitted immediately. Choosing a technology or a build split
-- stages the change in `store` and it travels with the next SEND, alongside the
-- movement orders, so one action covers the whole turn's plan and the player can
-- revise any of it freely until the turn resolves.
--
-- The tree is drawn one branch at a time, as a column: tier one, then the two
-- tier-two technologies side by side, then the tier-three that needs both. That
-- is the actual shape of every branch, and it reads as a tree in portrait -
-- which a left-to-right graph does not, at 720 points wide.
--
-- Only the tree scrolls. The page above it is fixed and sized from the screen
-- height, so a short screen squeezes the tree rather than pushing the resources
-- off the bottom.

local druid = require("druid.druid")
local monarch = require("monarch.monarch")
local store = require("main.store")
local ui = require("main.ui")
local tech = require("galaxy.sim.tech")
local races = require("galaxy.sim.races")

local PAD = 26
-- A full-width node and a two-up one need different heights: at this text size
-- a 318-unit card cannot hold a name, an effect sentence and a cost on three
-- lines, and the first attempt at one card height ran them all into each other.
local NODE_H = 140
local NODE_H_SPLIT = 206
local TIER_GAP = 40

-- Effect key -> how to say it, and which glyph carries it. Anything missing
-- falls back to the raw key so a new effect shows up as something readable
-- rather than vanishing from the card.
local EFFECT = {
	attack         = { "attack", "icon_attack" },
	defence        = { "defence", "icon_defence" },
	capture        = { "population kept on capture", "icon_growth" },
	speed          = { "fleet speed", "icon_speed" },
	hops           = { "order range", "icon_speed" },
	upkeep         = { "fuel upkeep", "icon_fuel" },
	industry       = { "build rate", "icon_industry" },
	ship_cost      = { "hull cost", "icon_industry" },
	cap            = { "fleet cap", "icon_warship" },
	growth         = { "growth", "icon_growth" },
	capacity       = { "world capacity", "icon_capacity" },
	yield_metal    = { "metal yield", "icon_metal" },
	yield_fuel     = { "fuel yield", "icon_fuel" },
	yield_research = { "research yield", "icon_research" },
	trade          = { "trade income", "icon_trade" },
	vision         = { "vision", "icon_vision" },
	tech_cost      = { "research cost", "icon_research" },
}

-- Counts of lanes, not percentages.
local WHOLE_NUMBER = { hops = true, vision = true }

-- Stable order, so a technology always reads the same way.
local EFFECT_ORDER = {
	"attack", "defence", "capture", "speed", "hops", "upkeep",
	"industry", "ship_cost", "cap", "growth", "capacity",
	"yield_metal", "yield_fuel", "yield_research", "trade",
	"vision", "tech_cost",
}

local function describe_effects(entry)
	local parts = {}
	for i = 1, #EFFECT_ORDER do
		local key = EFFECT_ORDER[i]
		local value = entry.effects[key]
		if value then
			local label = (EFFECT[key] and EFFECT[key][1]) or key
			if WHOLE_NUMBER[key] then
				parts[#parts + 1] = string.format("%+d %s", value, label)
			else
				parts[#parts + 1] = string.format("%+d%% %s",
					math.floor(value * 100 + 0.5), label)
			end
		end
	end
	return table.concat(parts, ", ")
end

--- The glyph that best summarises what a technology does.
local function effect_icon(entry)
	for i = 1, #EFFECT_ORDER do
		local key = EFFECT_ORDER[i]
		if entry.effects[key] and EFFECT[key] then return EFFECT[key][2] end
	end
	return "icon_research"
end

-- Staged state ----------------------------------------------------------------

--- What the player is aiming at, staged change included.
local function current_target(view)
	if store.pending_research ~= nil then
		return store.pending_research ~= "" and store.pending_research or nil
	end
	return view.researching
end

local function current_share(view)
	if store.pending_share ~= nil then return store.pending_share end
	return view.warship_share or 1.0
end

-- The tree --------------------------------------------------------------------

--- Techs of one branch, grouped by tier, in declaration order.
local function branch_tiers(branch)
	local tiers = {}
	for i = 1, #tech.TECHS do
		local entry = tech.TECHS[i]
		if entry.branch == branch then
			tiers[entry.tier] = tiers[entry.tier] or {}
			local row = tiers[entry.tier]
			row[#row + 1] = entry
		end
	end
	return tiers
end

--- The drawn height of the tallest branch, so switching tabs does not make the
--- page jump. Rows are not all the same height, so this has to add them up
--- rather than multiply.
local function tallest_branch()
	local tallest = 0
	for i = 1, #tech.BRANCHES do
		local tiers = branch_tiers(tech.BRANCHES[i].id)
		local tier, height = 1, 0
		while tiers[tier] do
			if tier > 1 then height = height + TIER_GAP end
			height = height + (#tiers[tier] == 1 and NODE_H or NODE_H_SPLIT)
			tier = tier + 1
		end
		if height > tallest then tallest = height end
	end
	return tallest
end

--- One technology as a card, laid out relative to the tree's content origin.
local function tech_node(self, x, y, w, h, entry, state, view, out)
	local function keep(node) out[#out + 1] = node; return node end

	local selected = state == "target"
	local locked = state == "locked"
	local done = state == "done"

	local fill = keep(ui.panel(x, y, w, h,
		selected and ui.ACCENT_SOFT or (locked and ui.BG_SOFT or ui.CARD_ALT)))
	keep(ui.panel_line(x, y, w, h, selected and ui.BORDER_HI or ui.BORDER))

	local tile = 56
	local tile_colour = ui.DIM
	if done then tile_colour = ui.GOOD
	elseif locked then tile_colour = ui.FAINT
	elseif selected then tile_colour = ui.ACCENT end
	keep(ui.panel(x + 18, y - 18, tile, tile, locked and ui.BG or ui.CARD))
	keep(ui.icon(x + 32, y - 32, tile - 28, effect_icon(entry), tile_colour))

	local text_x = x + 18 + tile + 16
	local text_w = w - (text_x - x) - 62
	keep(ui.body(text_x, y - 38, entry.label, locked and ui.DIM or ui.TEXT))

	-- What it does. Wrapped rather than truncated: a technology whose effect is
	-- cut off mid-word is not a choice a player can make.
	keep(ui.text(text_x, y - 58, describe_effects(entry), ui.SMALL,
		done and ui.GOOD or (locked and ui.FAINT or ui.DIM),
		{ width = text_w, height = h - 110, anchor_top = true }))

	-- The cost line. Shown as glyph-and-number pairs rather than
	-- "2.7k research   60 metal", which did not fit a two-up card and was
	-- clipped by its own border.
	local footer_y = y - h + 30
	if done then
		keep(ui.small(text_x, footer_y, "Researched", ui.GOOD))
	elseif locked then
		local missing = {}
		for k = 1, #entry.requires do
			if not self.known[entry.requires[k]] then
				missing[#missing + 1] = tech.by_id(entry.requires[k]).label
			end
		end
		keep(ui.small(text_x, footer_y + 12, "Needs " .. table.concat(missing, " + "),
			ui.FAINT, { width = w - (text_x - x) - 24, anchor_top = true }))
	else
		local cost = tech.cost_of(entry.id, (view.rates and view.rates.tech_cost) or 0)
		local cx = text_x
		local function pair(icon, value, colour)
			-- Icon centred on the text baseline: positioned by its top-left, so
			-- that is the row centre plus half its own height.
			keep(ui.icon(cx, footer_y + 11, 22, icon, colour))
			local text = ui.number(value)
			keep(ui.text(cx + 28, footer_y, text, ui.SMALL, colour))
			cx = cx + 28 + ui.text_width(text, ui.SMALL) + 22
		end
		pair("icon_research", cost.research, ui.RESOURCE_COLOUR.research)
		if cost.metal > 0 then
			pair("icon_metal", cost.metal, ui.RESOURCE_COLOUR.metal)
		end
		if selected then
			keep(ui.small(text_x, footer_y - 30, "Buying when affordable", ui.ACCENT))
		end
	end

	-- Status badge, top right.
	if done then
		keep(ui.dot(x + w - 52, y - 16, 34, ui.GOOD))
		keep(ui.icon(x + w - 47, y - 21, 24, "icon_check", ui.rgb(0x06170C)))
	elseif locked then
		keep(ui.icon(x + w - 52, y - 16, 30, "icon_lock", ui.FAINT))
	end

	if not locked and not done then
		self.tree_buttons[#self.tree_buttons + 1] =
			self.druid:new_button(fill, function()
				-- Tapping the current target clears it; "" rather than nil so
				-- the staged value stays distinguishable from "not staged".
				store.pending_research = selected and "" or entry.id
				self:render_tree()
			end)
	end
end

--- Draw the active branch as a column of tiers with connectors between them.
local function render_tree(self)
	local view = store.game_view
	if not view then return end

	ui.clear(self.tree_nodes)
	for i = 1, #self.tree_buttons do self.druid:remove(self.tree_buttons[i]) end
	self.tree_buttons = {}

	self.known = {}
	for i = 1, #(view.tech or {}) do self.known[view.tech[i]] = true end
	local target = current_target(view)

	local out = self.tree_nodes
	local w = self.tree_width
	local tiers = branch_tiers(self.branch)
	local y = -4

	local function state_of(entry)
		if self.known[entry.id] then return "done" end
		if not tech.prereqs_met(self.known, entry.id) then return "locked" end
		if entry.id == target then return "target" end
		return "available"
	end

	--- The lines between one tier and the next.
	--
	-- Forks when the tier below is wider than the one above, merges when it is
	-- narrower, and runs straight when they match. Drawing a bare straight line
	-- into a technology that needs *both* of the two above it would misstate
	-- the prerequisite, which is the one thing the diagram exists to show.
	local function connector(from_y, above, below)
		local half = TIER_GAP * 0.5
		local function stub(x, y0) out[#out + 1] = ui.sprite(x - 1, y0, 2, half, "solid", ui.BORDER) end
		local function spread(count)
			if count > 1 then return w * 0.25, w * 0.75 end
			return w * 0.5, w * 0.5
		end

		local a_left, a_right = spread(above)
		local b_left, b_right = spread(below)

		stub(a_left, from_y)
		if above > 1 then stub(a_right, from_y) end
		if a_left ~= b_left or a_right ~= b_right then
			local lo = math.min(a_left, b_left)
			local hi = math.max(a_right, b_right)
			out[#out + 1] = ui.sprite(lo, from_y - half, hi - lo, 2, "solid", ui.BORDER)
		end
		stub(b_left, from_y - half)
		if below > 1 then stub(b_right, from_y - half) end
	end

	local tier = 1
	while tiers[tier] do
		local row = tiers[tier]
		if tier > 1 then
			connector(y, #tiers[tier - 1], #row)
			y = y - TIER_GAP
		end
		if #row == 1 then
			tech_node(self, 0, y, w, NODE_H, row[1], state_of(row[1]), view, out)
			y = y - NODE_H
		else
			local gap = 16
			local cw = (w - gap * (#row - 1)) / #row
			for i = 1, #row do
				tech_node(self, (cw + gap) * (i - 1), y, cw, NODE_H_SPLIT, row[i],
					state_of(row[i]), view, out)
			end
			y = y - NODE_H_SPLIT
		end
		tier = tier + 1
	end

	for i = 1, #out do gui.set_parent(out[i], self.tree_content) end
	ui.fit_scroll(self.tree_scroll, self.tree_content, w, -y + 8, self.tree_height)
end

-- Shipyards -------------------------------------------------------------------

local POLICIES = {
	{ label = "WARSHIPS", share = 1.0, icon = "icon_warship" },
	{ label = "MIXED", share = 0.5, icon = "icon_industry" },
	{ label = "FREIGHTERS", share = 0.0, icon = "icon_freighter" },
}

local function refresh_policy(self)
	local share = current_share(store.game_view)
	for i = 1, #POLICIES do
		local on = math.abs(share - POLICIES[i].share) < 0.01
		local seg = self.policy[i]
		gui.set_color(seg.fill, on and ui.ACCENT or ui.CLEAR)
		gui.set_color(seg.glyph, on and ui.ACCENT_TEXT or ui.DIM)
		gui.set_color(seg.label, on and ui.ACCENT_TEXT or ui.DIM)
	end
	gui.set_text(self.policy_hint, string.format(
		"New production: %d%% warships, %d%% freighters",
		math.floor(share * 100 + 0.5), math.floor((1 - share) * 100 + 0.5)))
end

-- Screen ----------------------------------------------------------------------

local function build(self)
	local w, h = store.screen.width, store.screen.height
	local view = store.game_view
	local pad = ui.inset()
	local card_w = w - pad.left - pad.right

	ui.shade()

	-- Header. The close control sits in the top corner and the footer repeats
	-- the action full-width, because the top of a tall phone is a stretch.
	local top = h - pad.top
	local race = races.by_id(view and view.race)
	ui.h1(pad.left + 6, top - 34, "Empire")
	-- Race and blurb on separate lines. Joined onto one they wrapped, and the
	-- wrap ran straight into the title above.
	ui.body(pad.left + 6, top - 84, race.label, ui.race_colour(race.id))
	ui.small(pad.left + 6, top - 108, race.blurb, ui.DIM,
		{ width = card_w - 20, anchor_top = true })
	ui.icon_button(self.druid, w - pad.right - 60, top, 60, "icon_close",
		function() monarch.hide(hash("empire")) end)

	-- The lowest the footer may sit. It is placed for real once the cards are
	-- laid out, so it follows the content on a tall screen instead of leaving a
	-- crater between the last card and the bottom edge.
	local footer_floor = pad.bottom + ui.CONTROL

	local function footer(at)
		ui.button(self.druid, pad.left, at, card_w, ui.CONTROL, "TO THE MAP",
			function() monarch.hide(hash("empire")) end,
			{ style = "secondary", size = ui.CAPS })
	end

	if not view then
		ui.body(pad.left + 6, top - 170, "No game loaded.", ui.DIM)
		footer(footer_floor)
		return
	end

	local y = top - 150

	-- Stockpile ---------------------------------------------------------------
	local kinds = { "metal", "fuel", "research" }
	local stock_h = 40 + #kinds * 88 + PAD
	ui.card(pad.left, y, card_w, stock_h)
	local ry = ui.section(pad.left + PAD, y - 16, card_w - PAD * 2, "resources")
	for i = 1, #kinds do
		ry = ui.resource_row(pad.left + PAD, ry, card_w - PAD * 2, kinds[i],
			view.stock[kinds[i]], view.income and view.income[kinds[i]])
	end
	y = y - stock_h - ui.GAP

	-- Shipyards ---------------------------------------------------------------
	local yard_h = 216
	ui.card(pad.left, y, card_w, yard_h)
	ui.section(pad.left + PAD, y - 16, card_w - PAD * 2, "shipyards")
	self.policy_hint = ui.small(pad.left + PAD, y - 74, "", ui.DIM,
		{ width = card_w - PAD * 2, anchor_top = true })

	local seg_y = y - 110
	local seg_w = card_w - PAD * 2
	ui.pill(pad.left + PAD, seg_y, seg_w, ui.CONTROL, ui.CARD_ALT)
	ui.pill_line(pad.left + PAD, seg_y, seg_w, ui.CONTROL, ui.BORDER)
	self.policy = {}
	for i = 1, #POLICIES do
		local p = POLICIES[i]
		local hw = (seg_w - 10) / #POLICIES
		local hx = pad.left + PAD + 5 + hw * (i - 1)
		local fill = ui.pill(hx, seg_y - 5, hw, ui.CONTROL - 10, ui.CLEAR)
		-- Glyph and label centred as a pair inside the segment.
		local label_w = ui.text_width(p.label, ui.CAPS)
		local total = 28 + 10 + label_w
		local gx = hx + (hw - total) * 0.5
		local glyph = ui.icon(gx, seg_y - 19, 28, p.icon, ui.DIM)
		local label = ui.text(gx + 38, seg_y - ui.CONTROL * 0.5, p.label,
			ui.CAPS, ui.DIM, { bold = true })
		self.policy[i] = { fill = fill, glyph = glyph, label = label }
		self.druid:new_button(fill, function()
			store.pending_share = p.share
			refresh_policy(self)
		end)
	end
	refresh_policy(self)
	y = y - yard_h - ui.GAP

	-- Research ----------------------------------------------------------------
	-- The card is as tall as the tree needs, or as tall as the space allows,
	-- whichever is smaller - so a tall phone does not get a card two thirds
	-- empty and a short one scrolls instead of overflowing.
	local HEAD = 158              -- section label, hint, tabs
	local wanted = tallest_branch() + 16
	local available = y - (footer_floor + ui.GAP) - HEAD - PAD
	local tree_h = math.min(wanted, available)
	local research_h = HEAD + tree_h + PAD
	ui.card(pad.left, y, card_w, research_h)
	ui.section(pad.left + PAD, y - 16, card_w - PAD * 2, "research")
	ui.icon(pad.left + card_w - PAD - 150, y - 8, 28, "icon_research",
		ui.RESOURCE_COLOUR.research)
	ui.value(pad.left + card_w - PAD, y - 22, ui.number(view.stock.research),
		ui.BODY, ui.TEXT)
	ui.small(pad.left + PAD, y - 66,
		"One at a time; bought the turn you can afford it", ui.FAINT)

	local tabs = {}
	for i = 1, #tech.BRANCHES do
		tabs[i] = { id = tech.BRANCHES[i].id, label = tech.BRANCHES[i].label }
	end
	local tab_y = y - 88
	self.branch = self.branch or tabs[1].id
	self.tabs = ui.tabs(self.druid, pad.left + PAD, tab_y, card_w - PAD * 2, tabs,
		self.branch, function(id)
			self.branch = id
			self.tabs.set_active(id)
			self:render_tree()
		end)

	self.tree_width = card_w - PAD * 2
	self.tree_height = tree_h
	local _, content, scroll = ui.scroll(self.druid, pad.left + PAD, tab_y - 70,
		self.tree_width, tree_h)
	self.tree_content = content
	self.tree_scroll = scroll

	self:render_tree()

	footer(math.max(footer_floor, y - research_h - ui.GAP))
end

function init(self)
	msg.post(".", "acquire_input_focus")
	ui.install_druid_picking()
	self.druid = druid.new(self)
	self.tree_nodes = {}
	self.tree_buttons = {}
	self.known = {}
	self.render_tree = render_tree
	build(self)
end

function final(self) self.druid:final() end
function update(self, dt) self.druid:update(dt) end
function on_input(self, action_id, action)
	-- A full-screen popup claims every action, so the map behind it neither
	-- pans nor changes selection while this is up.
	return ui.modal_input(self.druid, action_id, action)
end
function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end
