[bootstrap]
main_collection = /main/main.collectionc
render = /main/render/galaxy.renderc

[script]
shared_state = 1

[display]
width = 720
height = 1280
high_dpi = 1
samples = 4

[render]
clear_color_red = 0.012
clear_color_green = 0.014
clear_color_blue = 0.030
clear_color_alpha = 1.0

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[android]
package = com.dg.galaxy
input_method = HiddenInputField
immersive_mode = 1

[physics]
gravity_y = -1000.0
scale = 0.01

[galaxy]
use_server = 1
nakama_host = 127.0.0.1
nakama_port = 7350
nakama_key = defaultkey
nakama_ssl = 0
nakama_timeout = 20
nakama_debug = 0

[project]
title = galaxy
dependencies#0 = https://github.com/heroiclabs/nakama-defold/archive/refs/tags/v3.4.0.zip
dependencies#1 = https://github.com/britzl/monarch/archive/refs/tags/6.0.2.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.2.5.zip
dependencies#3 = https://github.com/Insality/defold-event/archive/refs/tags/16.zip
