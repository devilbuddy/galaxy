path_settings {
  path: "/main/emoji.atlas"
  profile: "mipmapped"
}
path_settings {
  path: "/main/tiles.atlas"
  profile: "mipmapped"
}
path_settings {
  path: "/main/influence.atlas"
  profile: "mipmapped"
}
path_settings {
  path: "/main/assets/emoji/sheet.png"
  profile: "mipmapped"
}
path_settings {
  path: "**"
  profile: "default"
}
profiles {
  name: "default"
  platforms {
    os: OS_ID_GENERIC
    formats {
      format: TEXTURE_FORMAT_RGBA
      compression_level: NORMAL
      compression_type: COMPRESSION_TYPE_DEFAULT
    }
    mipmaps: false
    max_texture_size: 0
    premultiply_alpha: true
  }
}
profiles {
  name: "mipmapped"
  platforms {
    os: OS_ID_GENERIC
    formats {
      format: TEXTURE_FORMAT_RGBA
      compression_level: NORMAL
      compression_type: COMPRESSION_TYPE_DEFAULT
    }
    mipmaps: true
    max_texture_size: 0
    premultiply_alpha: true
  }
}
